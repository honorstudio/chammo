#!/bin/sh
''':'
# sh 로 읽으면 맞는 파이썬을 골라 다시 실행한다 — 윈도우의 python3 는 스토어 대리 실행기(종료 49)라 py -3 → python 중 도는 것
[ "$OS" = Windows_NT ] || exec python3 "$0" "$@"
for p in "py -3" python; do $p -c '' >/dev/null 2>&1 && exec $p "$0" "$@"; done
echo "python not found — install Python 3 (winget install Python.Python.3.12)" >&2; exit 127
':'''
__doc__ = """Operate the Chammo app for the user — voice mode, features, screens, the Tamagotchi.
앱을 사용자 대신 조작한다 — 음성 모드·기능 켜기·화면 열기·다마고치.

  scripts/app status                                   current settings as JSON (language, name, folders,
                                                       features, voice mode, browser automation)
  scripts/app voice on|off                             voice mode (the speaker button)
  scripts/app feature office|tama|gacha|review|voice|autoRevive|computerUse on|off
                                                       turn a feature on/off (same as Settings > Features)
  scripts/app open settings|tour|office|review|all|replay|load|reader|tasks|inbox|home|harnitor|tools
  scripts/app close settings|office|reader|tasks|inbox|harnitor|tools|review
  scripts/app focus <session id|name|project>          show that project's dashboard (chat view: in the space — no terminal)
  scripts/app focus --terminal <session|project>       open its terminal (CLI) — only when the user asks for the terminal
  scripts/app reader <file> [<file> ...]               open files in the reader (same as scripts/show)
  scripts/app harness [<project name|folder>]          the user's harness as text — skills, MCP, hooks, plugins, what is
                                                       turned off, findings (the app scans it; Chammo must be open).
                                                       To change anything, open Harnitor (open harnitor) — after the user agrees
  scripts/app pet show|hide                            the Tamagotchi's floating window
  scripts/app load [--json]                            what is loading this Mac, per session (CPU, memory, what runs),
                                                       plus processes left behind by ended sessions
  scripts/app project list                             project folders: devRoot's folders + ones added separately
  scripts/app project add <folder>                     add a folder outside devRoot as a project (it stays where it is)
  scripts/app project remove <folder|name>             stop treating it as a project (the folder is not touched)
  scripts/app trust <folder>                           when starting a session fails with "Workspace not trusted" (folders
                                                       inside a trusted devRoot don't need it). Only inside the projects folder the
                                                       user trusted; exit 3 = not covered → ask the user to trust it once
  scripts/app browser status|connect <project|folder>  this project's own logged-in browser (chammo-browser): connect
                                                       registers it for this folder only (~/.claude.json local scope) —
                                                       the repo's .mcp.json is never touched. Restart that folder's
                                                       running sessions afterwards (claude respawn <id>). Chammo must be open
  scripts/app browser need <project|folder> [<why>]    put a "Connect browser" card in the decision inbox for the user
  scripts/app push "<title>" ["<one line>"]            push a notification to the user's phone (home-screen web app
                                                       with the bell on). Sent even while the user looks at the Mac.
                                                       Title + 60 chars only — no secrets. Exit 4 = no subscribed
                                                       phone → fall back to another channel (e.g. Slack)

Log: <data folder>/app.jsonl — {ts, action, arg}. The running app checks it every 0.7 s and applies each
line once; lines written while the app is closed are skipped.
"""
import datetime, json, os, subprocess, sys

FEATURES = ('office', 'tama', 'gacha', 'review', 'voice', 'autoRevive', 'computerUse')
OFF_BY_DEFAULT = ('autoRevive', 'computerUse')  # 앱 기본값과 같게 — 무인 맥에서만 켠다 · 화면 조종은 사용자가 고른다
OPEN = ('settings', 'tour', 'office', 'review', 'all', 'replay', 'load', 'reader', 'tasks', 'inbox', 'home', 'harnitor', 'tools')
CLOSE = ('settings', 'office', 'reader', 'tasks', 'inbox', 'harnitor', 'tools', 'review')
ONOFF = ('on', 'off')


def data_dir(home=None, env=None, exists=os.path.isdir):
    """Data folder — same rule as the app: $CHAMMO_HOME -> ~/.chammo (-> ~/.honor-orchestrator for old installs)"""
    home = home or os.path.expanduser('~')
    env = os.environ.get('CHAMMO_HOME', '') if env is None else env
    if env.strip():
        return os.path.expanduser(env.strip())
    new, old = os.path.join(home, '.chammo'), os.path.join(home, '.honor-orchestrator')
    return old if not exists(new) and exists(old) else new


def read_json(path):
    try:
        with open(path, encoding='utf-8') as f:
            v = json.load(f)
        return v if isinstance(v, dict) else {}
    except (OSError, ValueError):
        return {}


def status(data):
    """앱 설정·음성 모드·브라우저 자동화 — 빠진 기능 칸은 켜짐, autoRevive·computerUse 만 꺼짐(앱과 같은 기본값)"""
    c = read_json(os.path.join(data, 'config.json'))
    f = c.get('features') if isinstance(c.get('features'), dict) else {}
    return {
        'language': c.get('language', ''),
        'assistantName': c.get('assistantName', ''),
        'devRoot': c.get('devRoot', ''),
        'hqDir': c.get('hqDir', ''),
        'extraProjects': extras_of(c),
        'features': {k: bool(f.get(k, k not in OFF_BY_DEFAULT)) for k in FEATURES},
        'voiceMode': read_json(os.path.join(data, 'voice.json')).get('on') is True,
        'browserAutomation': os.path.isfile(os.path.join(data, 'tools/chammo-browser/node_modules/@playwright/mcp/package.json')),
        'dataDir': data,
    }


def extras_of(c):
    v = c.get('extraProjects')
    return [x for x in v if isinstance(x, str)] if isinstance(v, list) else []


def expand(p, home):
    p = p.strip()
    return home if p == '~' else os.path.join(home, p[2:]) if p.startswith('~/') else p


def tilde(p, home):
    p = os.path.normpath(p)
    return '~' if p == home else '~' + p[len(home):] if p.startswith(home + os.sep) else p


def write_config(data, c):
    """다른 칸은 그대로 두고 통째로 바꿔 쓴다(쓰다 끊겨도 반쪽 파일이 안 남게)"""
    path = os.path.join(data, 'config.json')
    tmp = path + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(c, f, ensure_ascii=False, indent=2)
    os.replace(tmp, path)


def project(data, home, verb, arg):
    """devRoot 밖 폴더를 프로젝트로 — (종료 코드, 할 말). 앱이 꺼져 있어도 반영되게 config.json 을 직접 고친다"""
    c = read_json(os.path.join(data, 'config.json'))
    dev = os.path.normpath(expand(c.get('devRoot') or '~/Developer', home))
    extras = extras_of(c)
    if verb == 'list':
        names = sorted(n for n in (os.listdir(dev) if os.path.isdir(dev) else []) if not n.startswith('.') and os.path.isdir(os.path.join(dev, n)))
        names += [os.path.basename(expand(x, home).rstrip('/')) for x in extras]
        return 0, json.dumps({'devRoot': c.get('devRoot', ''), 'extraProjects': extras, 'projects': names}, ensure_ascii=False, indent=2)
    full = os.path.normpath(expand(arg, home))
    if verb == 'add':
        if not os.path.isdir(full):
            return 1, f'no such folder / 폴더가 없어: {arg}'
        if full in (dev, home, '/'):
            return 1, 'pick one project folder, not devRoot or home / 프로젝트 폴더 하나를 골라'
        if full.startswith(dev + os.sep):
            return 1, f'already a project (inside devRoot) / 이미 프로젝트 폴더 안이라 보여: {tilde(full, home)}'
        t = tilde(full, home)
        if t not in extras:
            c['extraProjects'] = extras + [t]
            write_config(data, c)
        return 0, f'added / 추가: {t} (project "{os.path.basename(full)}")'
    keep = [x for x in extras if os.path.normpath(expand(x, home)) != full and os.path.basename(expand(x, home).rstrip('/')) != arg.strip()]
    if len(keep) == len(extras):
        return 1, f'not an added project / 따로 추가한 프로젝트가 아니야: {arg}'
    c['extraProjects'] = keep
    write_config(data, c)
    return 0, f'removed / 뺐어: {arg} (the folder itself is untouched / 폴더는 그대로)'


def load(data, as_json=False):
    """앱이 잴 때마다 남기는 load.json — 참모가 "왜 느려?"에 세션별로 답하게. (종료 코드, 본문, 경고)"""
    s = read_json(os.path.join(data, 'load.json'))
    if not s.get('at'):
        return 1, '', 'no load data yet — the app measures while it runs / 아직 잰 기록이 없어(앱이 켜져 있을 때 잰다)'
    warn = ''
    try:
        age = (datetime.datetime.now(datetime.timezone.utc) - datetime.datetime.fromisoformat(s['at'].replace('Z', '+00:00'))).total_seconds()
        if age > 120:
            warn = f'old data ({int(age // 60)} min ago) — is the app running? / {int(age // 60)}분 전 기록이야'
    except (ValueError, TypeError):
        pass
    if as_json:
        return 0, json.dumps(s, ensure_ascii=False, indent=2), warn
    out = [f"load {s.get('load1')} on {s.get('cores')} cores (5 min {s.get('load5')}) · swap {s.get('swapUsedGb')}GB · {s.get('level')}",
           'CPU % — 100 = one core', '', 'sessions:']
    for x in s.get('sessions') or []:
        out.append(f"  {x.get('name')} ({x.get('project')}): {x.get('cpu')}% · {x.get('mem')} — {', '.join(x.get('top') or []) or 'quiet'}")
    orphans = s.get('orphans') or []
    out.append(f'left behind by ended sessions: {len(orphans)}' + (' (the user can stop them in the app: Load screen)' if orphans else ''))
    for o in orphans:
        out.append(f"  pid {o.get('pid')} {o.get('what')}: {o.get('cpu')}% · {o.get('mem')} · up {o.get('age')}")
    o, r = s.get('outside') or {}, s.get('rest') or {}
    out.append(f"Claude outside Chammo: {o.get('cpu')}% · {o.get('mem')}")
    out.append(f"other apps & system: {r.get('cpu')}% · {r.get('mem')} — {', '.join(r.get('top') or [])}")
    return 0, '\n'.join(out), warn


def _new_project():
    """옆 scripts/new-project 의 믿음 적기(trust)를 그대로 쓴다 — 같은 길(임시 파일+바꿔 끼우기)"""
    import importlib.machinery, importlib.util
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'new-project')
    loader = importlib.machinery.SourceFileLoader('chammo_new_project', path)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader('chammo_new_project', loader))
    loader.exec_module(mod)
    return mod


def _trusted(projects, path):
    """Claude Code 처럼 위 폴더 믿음도 물려받는다"""
    cur = path
    while True:
        p = projects.get(cur)
        if isinstance(p, dict) and p.get('hasTrustDialogAccepted') is True:
            return True
        up = os.path.dirname(cur)
        if up == cur:
            return False
        cur = up


def trust(data, home, folder):
    """사용자가 믿은 프로젝트 폴더(앱이 남긴 trust-consent.json) 아래면 그 폴더 믿음을 적는다 — (종료 코드, 할 말).
    clone·직접 만든 폴더는 믿음이 없어 `claude --bg` 가 'Workspace not trusted' 로 멈췄다(2026-10-06 이슈 #1)"""
    full = os.path.realpath(expand(folder, home))
    if not os.path.isdir(full):
        return 1, f'no such folder / 폴더가 없어: {folder}'
    root = read_json(os.path.join(data, 'trust-consent.json')).get('root') or ''
    root = root.replace('\\', '/').rstrip('/')
    key = full.replace('\\', '/') if os.name == 'nt' else full
    if not root or not (key == root or key.startswith(root + '/')):
        return 3, (f'not inside a projects folder the user trusted — ask them to run `! cd "{full}" && claude` once, pick '
                   f'"Yes, I trust this folder", then /exit / 사용자가 믿은 프로젝트 폴더 밖이야 — 사용자에게 한 번 믿어 달라고 해')
    cj = os.path.join(home, '.claude.json')
    projects = read_json(cj).get('projects')
    projects = projects if isinstance(projects, dict) else {}
    if _trusted(projects, key) and _trusted(projects, root):
        return 0, f'already trusted / 이미 믿음: {full}'
    np = _new_project()
    for k in ([root] if not _trusted(projects, root) else []) + ([full] if full != root else []):
        if not np.trust(k, home):
            return 1, f'could not write {cj} / 못 적었어'
    return 0, f'trusted / 믿음 적음: {full} — start the session again / 세션을 다시 띄워'


def parse(argv):
    """명령 → (action, arg). 틀리면 None"""
    if not argv:
        return None
    a, rest = argv[0], argv[1:]
    if a == 'status' and not rest:
        return ('status', '')
    if a == 'voice' and len(rest) == 1 and rest[0] in ONOFF:
        return ('voice', rest[0])
    if a == 'feature' and len(rest) == 2 and rest[0] in FEATURES and rest[1] in ONOFF:
        return ('feature', f'{rest[0]} {rest[1]}')
    if a == 'open' and len(rest) == 1 and rest[0] in OPEN:
        return ('open', rest[0])
    if a == 'close' and len(rest) == 1 and rest[0] in CLOSE:
        return ('close', rest[0])
    # 채팅 뷰에선 그 대시보드를 스페이스에 띄운다. 터미널(CLI)은 --terminal 로 명시할 때만(2026-10-02)
    if a == 'focus' and len(rest) == 2 and '--terminal' in rest:
        t = [x for x in rest if x != '--terminal'][0].strip()
        return ('focus', f'--terminal {t}') if t else None
    if a == 'focus' and len(rest) == 1 and rest[0].strip():
        return ('focus', rest[0].strip())
    if a == 'pet' and len(rest) == 1 and rest[0] in ('show', 'hide'):
        return ('pet', rest[0])
    return None


def warning(st, action, arg):
    """꺼 둔 기능에 닿는 명령이면 한 줄 안내 — 앱은 그 명령을 무시한다(음성 켜기만 기능도 같이 켠다)"""
    need = {('open', 'office'): 'office', ('open', 'review'): 'review', ('pet', 'show'): 'tama'}.get((action, arg))
    if need and not st['features'][need]:
        return f'{need} is turned off in Settings — the app will ignore this. Run: scripts/app feature {need} on'
    if (action, arg) == ('voice', 'on') and not st['features']['voice']:
        return 'the voice feature was off — the app turns it on too'
    return None


DONE = {
    'voice': 'voice mode {arg}',
    'feature': 'feature {arg}',
    'open': 'opening {arg}',
    'close': 'closing {arg}',
    'focus': 'going to {arg}',
    'pet': 'Tamagotchi window: {arg}',
}


def ask_app(data, action, arg, out_name, wait):
    """앱에 부탁하고 답(<데이터>/<out_name>, 첫 줄 "#id <id>")을 기다린다 — (종료 코드, 답 본문)"""
    import time, uuid
    rid = uuid.uuid4().hex[:12]
    os.makedirs(data, exist_ok=True)
    line = {'ts': datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds'), 'action': action, 'arg': arg, 'id': rid}
    with open(os.path.join(data, 'app.jsonl'), 'a', encoding='utf-8') as f:
        f.write(json.dumps(line, ensure_ascii=False) + '\n')
    out = os.path.join(data, out_name)
    end = time.time() + wait
    while time.time() < end:
        try:
            with open(out, encoding='utf-8') as f:
                text = f.read()
            head, _, body = text.partition('\n')
            if head == f'#id {rid}':
                return 0, body.rstrip('\n')
        except OSError:
            pass
        time.sleep(0.2)
    return 1, f'Chammo did not answer in {wait:g}s — is the app open? / 앱이 답하지 않았어 — Chammo 가 켜져 있어야 해'


def harness(data, project, wait):
    """앱에 하네스 글을 부탁한다 — 엔진은 앱 안(하니터)에만 있다"""
    return ask_app(data, 'harness', project, 'harness.txt', wait)


def project_dir(data, home, arg):
    """프로젝트 이름(devRoot 아래·따로 추가한 것) 또는 폴더 → 폴더 절대 경로. 못 찾으면 None"""
    a = arg.strip()
    if not a:
        return None
    if '/' in a or '\\' in a or a.startswith('~'):
        return os.path.normpath(expand(a, home))
    c = read_json(os.path.join(data, 'config.json'))
    dev = os.path.normpath(expand(c.get('devRoot') or '~/Developer', home))
    for x in extras_of(c):
        full = os.path.normpath(expand(x, home))
        if os.path.basename(full.rstrip('/')) == a:
            return full
    return os.path.join(dev, a) if a not in ('.', '..') else None


def browser(data, home, verb, arg, wait):
    """참모 브라우저 연결 — 앱이 폴더를 읽고 ~/.claude.json 에 적는다(HQ 는 데스크탑 권한이 막혀 있을 수 있다 — GitHub #1·#2)"""
    d = project_dir(data, home, arg)
    if not d:
        return 1, f'which project? / 어느 프로젝트?: {arg}'
    if verb == 'need':
        return 0, None
    code, body = ask_app(data, 'browser', {'verb': verb, 'dir': d}, 'browser-attach.txt', wait)
    if code:
        return code, body
    try:
        r = json.loads(body)
    except ValueError:
        return 1, body
    if not r.get('ok'):
        return 1, f"{r.get('error')} ({tilde(d, home)})"
    l = r.get('link') or {}
    t = tilde(d, home)
    if not l.get('available'):
        return 1, f'browser automation is not installed — ask the user to press Install in Settings → Features → Browser automation / 브라우저 자동화가 안 깔려 있어 — 사용자에게 설정 → 기능 → 브라우저 자동화의 설치를 부탁해 ({t})'
    if not l.get('connected'):
        return 3, f'not connected / 안 붙어 있어: {t} — scripts/app browser connect {arg}'
    tools = f"mcp__{l.get('name')}__* (browser_ask_human)"
    where = 'repo .mcp.json (new project)' if l.get('scope') == 'project' else 'this folder only (~/.claude.json local) — repo files untouched / 이 폴더만, 저장소 파일은 그대로'
    msg = f'connected / 붙어 있어: {t} → {tools}, {where}'
    if l.get('other'):
        msg += '\n  the repo\'s own "playwright" stays too — both start / 저장소의 다른 playwright 도 그대로 같이 뜬다'
    if l.get('added'):
        msg += '\n  running sessions in that folder must restart to get it: claude respawn <id> / 그 폴더에 떠 있는 세션은 다시 켜야 붙어'
    return 0, msg


def push_subs(data):
    """지금 짝지어 있는 기기의 푸시 구독 수 — 앱(push.rs live_subs)과 같은 셈"""
    def load(name):
        try:
            with open(os.path.join(data, name), encoding='utf-8') as f:
                v = json.load(f)
            return v if isinstance(v, list) else []
        except (OSError, ValueError):
            return []
    devices = {d.get('id') for d in load('mobile-devices.json') if isinstance(d, dict)}
    return sum(1 for s in load('push-subs.json') if isinstance(s, dict) and s.get('device') in devices)


def main(argv):
    # 폰 푸시 — 참모가 일부러 부르는 것이라 맥 창을 보고 있어도 보낸다. 구독이 없으면 4(다른 길로 떨어지게)
    if argv[:1] == ['push']:
        rest = argv[1:]
        if not (1 <= len(rest) <= 2) or not rest[0].strip():
            print(__doc__, file=sys.stderr); return 2
        data = data_dir()
        if push_subs(data) == 0:
            print('no push subscription — turn on the bell in the phone app / 구독 없음 — 폰 홈 화면 앱에서 종을 켜야 해', file=sys.stderr)
            return 4
        arg = {'title': rest[0].strip(), 'body': rest[1].strip() if len(rest) > 1 else ''}
        line = {'ts': datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds'), 'action': 'push', 'arg': arg}
        with open(os.path.join(data, 'app.jsonl'), 'a', encoding='utf-8') as f:
            f.write(json.dumps(line, ensure_ascii=False) + '\n')
        print(f'sent to the app / 앱에 넘김: push {arg["title"]}')
        return 0
    if argv[:1] == ['harness']:
        if len(argv) > 2:
            print(__doc__, file=sys.stderr); return 2
        try:
            wait = float(os.environ.get('CHAMMO_HARNESS_WAIT', '') or 30)
        except ValueError:
            wait = 30
        code, msg = harness(data_dir(), argv[1].strip() if len(argv) == 2 else '', wait)
        print(msg, file=sys.stdout if code == 0 else sys.stderr)
        return code
    if argv[:1] == ['browser']:
        verb, rest = (argv[1] if len(argv) > 1 else ''), argv[2:]
        if not ((verb in ('status', 'connect') and len(rest) == 1) or (verb == 'need' and 1 <= len(rest) <= 2)):
            print(__doc__, file=sys.stderr); return 2
        data, home = data_dir(), os.path.expanduser('~')
        try:
            wait = float(os.environ.get('CHAMMO_APP_WAIT', '') or 20)
        except ValueError:
            wait = 20
        code, msg = browser(data, home, verb, rest[0], wait)
        if verb == 'need' and code == 0:
            # 카드는 화면이 그린다 — 앱이 지금 상태를 다시 보고 붙어 있으면 안 띄운다
            arg = {'dir': project_dir(data, home, rest[0]), 'why': rest[1].strip() if len(rest) > 1 else ''}
            line = {'ts': datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds'), 'action': 'browser-need', 'arg': arg}
            with open(os.path.join(data, 'app.jsonl'), 'a', encoding='utf-8') as f:
                f.write(json.dumps(line, ensure_ascii=False) + '\n')
            msg = f'sent to the app / 앱에 넘김: browser card for {tilde(arg["dir"], home)}'
        print(msg, file=sys.stdout if code == 0 else sys.stderr)
        return code
    if argv[:1] == ['load']:
        if argv[1:] not in ([], ['--json']):
            print(__doc__, file=sys.stderr); return 2
        code, body, warn = load(data_dir(), argv[1:] == ['--json'])
        if body:
            print(body)
        if warn:
            print(warn, file=sys.stderr)
        return code
    if argv[:1] == ['project']:
        verb, rest = (argv[1] if len(argv) > 1 else ''), argv[2:]
        if not ((verb == 'list' and not rest) or (verb in ('add', 'remove') and len(rest) == 1 and rest[0].strip())):
            print(__doc__, file=sys.stderr); return 2
        data, home = data_dir(), os.path.expanduser('~')
        code, msg = project(data, home, verb, rest[0] if rest else '')
        print(msg, file=sys.stdout if code == 0 else sys.stderr)
        if code == 0 and verb != 'list':
            line = {'ts': datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds'), 'action': 'config', 'arg': 'reload'}
            with open(os.path.join(data, 'app.jsonl'), 'a', encoding='utf-8') as f:
                f.write(json.dumps(line) + '\n')
        return code
    if argv[:1] == ['trust']:
        if len(argv) != 2 or not argv[1].strip():
            print(__doc__, file=sys.stderr); return 2
        code, msg = trust(data_dir(), os.path.expanduser('~'), argv[1])
        print(msg, file=sys.stdout if code == 0 else sys.stderr)
        return code
    if argv[:1] == ['reader']:
        if len(argv) < 2:
            print(__doc__, file=sys.stderr); return 2
        show = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'show')
        return subprocess.run([sys.executable, show, *argv[1:]]).returncode
    cmd = parse(argv)
    if not cmd:
        print(__doc__, file=sys.stderr); return 2
    data = data_dir()
    st = status(data)
    action, arg = cmd
    if action == 'status':
        print(json.dumps(st, ensure_ascii=False, indent=2)); return 0
    note = warning(st, action, arg)
    if note:
        print(note, file=sys.stderr)
    os.makedirs(data, exist_ok=True)
    line = {'ts': datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds'), 'action': action, 'arg': arg}
    with open(os.path.join(data, 'app.jsonl'), 'a', encoding='utf-8') as f:
        f.write(json.dumps(line, ensure_ascii=False) + '\n')
    print(f'sent to the app / 앱에 넘김: {DONE[action].format(arg=arg)}')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
