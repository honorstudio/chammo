#!/bin/sh
''':'
# sh 로 읽으면 맞는 파이썬을 골라 다시 실행한다 — 윈도우의 python3 는 스토어 대리 실행기(종료 49)라 py -3 → python 중 도는 것
[ "$OS" = Windows_NT ] || exec python3 "$0" "$@"
for p in "py -3" python; do $p -c '' >/dev/null 2>&1 && exec $p "$0" "$@"; done
echo "python not found — install Python 3 (winget install Python.Python.3.12)" >&2; exit 127
':'''
__doc__ = """Create a project folder for new work, with the project harness, then hand it to a session.
새 일을 맡을 프로젝트 폴더를 만들고 하네스를 깐다 — 그다음 그 폴더에서 세션을 띄워 맡긴다.

  scripts/new-project <name> "<one-line summary>" [--git | --no-git]

<name>: lowercase letters, digits, - _ . (e.g. shop-landing). The folder is <devRoot>/<name>.
git is optional (Settings > Features "Use git for code projects", features.git; unset = on when a global git
email exists). --git / --no-git overrides it: code (app, site, script) → git; design, documents, video, print → --no-git.
An existing folder never gets `git init`. It lays down CLAUDE.md + docs/starter.md + docs/roadmap.md + docs/decisions/
(files that already exist are never overwritten) and marks a folder it just created as trusted for Claude Code
(an existing folder is left for the user to trust once). If the user has their own `project-starter` skill,
it only creates the folder and tells you to start the session with /project-starter instead.
Prints JSON: {path, existed, git, written, projectStarter, trusted, browser, committed, next}.
With browser automation installed, a new project also gets its own logged-in browser profile (.mcp.json).
"""
import datetime, json, os, re, shlex, shutil, subprocess, sys, time
for _io in (sys.stdin, sys.stdout, sys.stderr):  # 윈도우 파이썬 기본은 cp949 — PYTHONUTF8 없이 떠도(데몬 env 세션·작업 스케줄러) 한글·'—' 를 UTF-8 로(2026-11-01 win-text H1)
    if _io and hasattr(_io, 'reconfigure') and (_io.encoding or '').lower().replace('-', '') != 'utf8':
        _io.reconfigure(encoding='utf-8', errors='replace')

NAME = re.compile(r'^[a-z0-9][a-z0-9._-]{0,63}$')


def valid_name(name):
    return bool(NAME.match(name or '')) and '..' not in name


def data_dir(home=None, env=None, exists=os.path.isdir):
    """Data folder — same rule as the app: $CHAMMO_HOME -> ~/.chammo (-> ~/.honor-orchestrator for old installs)"""
    home = home or os.path.expanduser('~')
    env = os.environ.get('CHAMMO_HOME', '') if env is None else env
    if env.strip():
        return os.path.expanduser(env.strip())
    new, old = os.path.join(home, '.chammo'), os.path.join(home, '.honor-orchestrator')
    return old if not exists(new) and exists(old) else new


def config(data):
    try:
        with open(os.path.join(data, 'config.json'), encoding='utf-8') as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def expand(p, home):
    return home + p[1:] if p.startswith('~') else p


def trust_key(path, win=None):
    """.claude.json 의 폴더 키 — 윈도우 Claude Code 는 C:/… 처럼 슬래시로 찾는다(C:\\… 로 적으면 'Workspace not trusted')"""
    win = os.name == 'nt' if win is None else win
    return path.replace('\\', '/') if win else path


def swap_in(tmp, cj):
    """다 쓴 임시 파일로 바꿔 끼운다. 윈도우는 claude 가 파일을 쥐고 있으면 바꿔치기가 막힌다 → 잠깐 기다렸다가, 끝내 안 되면 제자리에 쓴다"""
    for _ in range(5):
        try:
            os.replace(tmp, cj)
            return
        except PermissionError:
            time.sleep(0.2)
    with open(tmp, encoding='utf-8') as src, open(cj, 'w', encoding='utf-8') as dst:
        dst.write(src.read())
    os.remove(tmp)


def git_ok():
    """이 기기에서 git 을 불러도 되나 — 맥은 명령줄 도구가 없으면 /usr/bin/git 이 설치 창을 띄운다.
    앱이 PATH 앞에 둔 대리(<데이터>/tools/bin/git, ADR 0027)면 괜찮다 — 처음 쓸 때 git 을 받아서 잇는다"""
    found = shutil.which('git')
    if not found:
        return False
    if sys.platform == 'darwin':
        if found.endswith('/tools/bin/git'):
            return True
        try:
            return subprocess.run(['xcode-select', '-p'], capture_output=True, timeout=5).returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            return False
    return True


def git_on(cfg):
    """설정 '코드 프로젝트에 git 쓰기'(features.git). 값이 없으면(옛 설치) 전역 git 메일이 있으면 켬 — ADR 0024"""
    f = cfg.get('features') if isinstance(cfg.get('features'), dict) else {}
    if isinstance(f.get('git'), bool):
        return f['git']
    if not git_ok():
        return False
    try:
        r = subprocess.run(['git', 'config', '--global', 'user.email'], capture_output=True, text=True, timeout=5)
        return bool(r.stdout.strip())
    except (OSError, subprocess.TimeoutExpired):
        return False


def render(body, git):
    """틀 글 — '[git] ' 줄은 깃 프로젝트에만, '[nogit] ' 줄은 깃 없는 프로젝트에만(머리표는 지운다)"""
    out = []
    for line in body.splitlines(keepends=True):
        for tag, keep in (('[git] ', git), ('[nogit] ', not git)):
            if line.startswith(tag):
                line = line[len(tag):] if keep else None
                break
        if line is not None:
            out.append(line)
    return ''.join(out)


def computer_use_on(cfg):
    """앱 기능 '화면 조종 모든 프로젝트'(features.computerUse) — 기본 끔"""
    f = cfg.get('features') if isinstance(cfg.get('features'), dict) else {}
    return f.get('computerUse') is True


def claude_json(home):
    """Claude Code 가 읽는 .claude.json — CLAUDE_CONFIG_DIR 가 있으면 그 안(시험 설정 폴더로 돌리면 거기)"""
    return os.path.join(os.environ.get('CLAUDE_CONFIG_DIR') or home, '.claude.json')


def trust(path, home, win=None, computer_use=False):
    """claude --bg 가 새 폴더에서 뜨게 ~/.claude.json(CLAUDE_CONFIG_DIR 면 그 안)에 '믿음'을 적는다 — 이 스크립트가 방금 만든 빈 폴더에만.
    (부모 폴더를 믿어도 새 하위 폴더는 "Workspace not trusted" 로 거부됐다, 2026-09-28 실측) 파일이 없거나 깨졌으면 손대지 않는다.
    computer_use 면 내장 화면 조종도 켠다 — Claude Code 는 projects.<경로>.enabledMcpServers 에 있어야 켠다(앱 computer_use.rs 와 같은 자리)"""
    cj = claude_json(home)
    try:
        with open(cj, encoding='utf-8') as f:
            d = json.load(f)
    except (OSError, ValueError):
        return False
    if not isinstance(d, dict):
        return False
    projects = d.setdefault('projects', {})
    if not isinstance(projects, dict):
        return False
    p = projects.setdefault(trust_key(path, win), {})
    have = p.get('enabledMcpServers') if isinstance(p.get('enabledMcpServers'), list) else []
    if p.get('hasTrustDialogAccepted') is True and (not computer_use or 'computer-use' in have):
        return True  # 이미 믿음 — 떠 있는 claude 가 그새 쓴 걸 덮지 않게 안 쓴다
    p['hasTrustDialogAccepted'] = True
    if computer_use:
        on = p.get('enabledMcpServers') if isinstance(p.get('enabledMcpServers'), list) else []
        p['enabledMcpServers'] = on if 'computer-use' in on else on + ['computer-use']
    tmp = f'{cj}.{os.getpid()}.chammo-tmp'  # 둘이 같이 돌면 같은 임시 이름을 서로 덮었다
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(d, f, ensure_ascii=False, indent=2)
    try:
        os.chmod(tmp, os.stat(cj).st_mode & 0o777)  # 계정 정보가 든 0600 — 새 임시 파일의 0644 로 넓히지 않는다(routine _trust 와 같게)
    except OSError:
        os.chmod(tmp, 0o600)
    swap_in(tmp, cj)  # 한 번에 바꿔 끼운다(쓰다 만 파일이 남지 않게)
    return True


def inside(root, key):
    """key 가 root 이거나 그 아래인가 — / 모양으로 맞추고, 윈도우 드라이브 경로(C:/…)면 대소문자를 안 가린다(앱 Rust covers 와 같은 선)"""
    def k(p):
        p = p.replace('\\', '/').rstrip('/')
        return p.lower() if len(p) > 1 and p[1] == ':' else p
    r, d = k(root or ''), k(key or '')
    return bool(r) and (d == r or d.startswith(r + '/'))


def under_consent(data, path):
    """사용자가 마법사·설정에서 믿은 프로젝트 폴더(앱이 남긴 <데이터>/trust-consent.json) 안인가 — scripts/app trust 와 같은 선"""
    try:
        with open(os.path.join(data, 'trust-consent.json'), encoding='utf-8') as f:
            root = json.load(f).get('root') or ''
    except (OSError, ValueError, AttributeError):
        return False
    return inside(root, os.path.realpath(path))


def status_cmd(path):
    """상태줄 명령 글 — 셸(윈도우 Git Bash)이 읽는다: 경로는 / 로만(역슬래시는 먹힌다), 셸 글자가 있으면 큰따옴표로(앱 hq::statusline_cmd 와 같다).
    C:/Users/John Smith/… 가 빈칸에서 쪼개져 상태줄·사용량이 안 떴다(2026-11-01 win-text M1)"""
    p = path.replace('\\', '/')
    if p and all(not c.isascii() or c.isalnum() or c in '/._-:@%+=,~' for c in p):
        return p
    return '"' + ''.join('\\' + c if c in '\\"$`' else c for c in p) + '"'


def local_settings(path, enable=(), statusline=None, isolation=None, env=None):
    """<프로젝트>/.claude/settings.local.json 에 합친다 — MCP 미리 승인, 앱 상태줄(사용량·대화 %), 백그라운드 세션 격리(isolation), 세션 env"""
    sl = os.path.join(path, '.claude/settings.local.json')
    try:
        with open(sl, encoding='utf-8') as f:
            s = json.load(f)
    except (OSError, ValueError):
        s = {}
    for name in enable:
        servers = s.setdefault('enabledMcpjsonServers', [])
        if name not in servers:
            servers.append(name)
    if statusline:
        s['statusLine'] = {'type': 'command', 'command': status_cmd(statusline)}
    if isolation:
        wt = s.get('worktree') if isinstance(s.get('worktree'), dict) else {}
        s['worktree'] = {**wt, 'bgIsolation': isolation}
    if env:
        cur = s.get('env') if isinstance(s.get('env'), dict) else {}
        s['env'] = {**cur, **env}
    os.makedirs(os.path.dirname(sl), exist_ok=True)
    with open(sl, 'w', encoding='utf-8') as f:
        json.dump(s, f, ensure_ascii=False, indent=2)


def first_commit(path, lang):
    """방금 만든 저장소에 하네스를 첫 커밋으로 — (했나, 알릴 한 줄). git 작성자(user.name·email)가 없으면 안 한다(지어 넣지 않는다).
    커밋 0개면 Claude 2.1.306 백그라운드 세션의 EnterWorktree 가 실패해 세션이 임기응변했다(2026-10-21 첫 사용자 QA).
    로컬 파일(앱 절대 경로·node 경로)은 늘 빼고 — 템플릿을 안 쓰는 사람(project-starter)은 .gitignore 가 없었다. 서명 창·훅에 안 멈추게 시간 제한"""
    ko = lang == 'ko'
    def git(*a):
        try:
            return subprocess.run(['git', *a], cwd=path, capture_output=True, text=True, timeout=20)
        except subprocess.TimeoutExpired:
            return subprocess.CompletedProcess(a, 124, '', 'timeout')
    if git('rev-parse', '--verify', '-q', 'HEAD').returncode == 0:
        return False, ''
    if not (git('config', 'user.name').stdout.strip() and git('config', 'user.email').stdout.strip()):
        # 사용자에게 명령을 치라고 하지 않게 — 앱 설정 칸에서 적는다(2026-11-01 win-first M1, 새 PC 는 거의 다 비어 있다)
        return False, ('git 이름·메일이 없어서 첫 커밋을 못 했어. 사용자에게 git config 를 치라고 하지 말고 Chammo 설정 > 도구 점검 탭의 git 이름·메일 칸에 적어 달라고 해. 적었다고 하면 그때 첫 커밋 해.'
                       if ko else 'The first commit was not made because no git name and email are set. Do not ask the user to run git config. Ask them to enter these in Chammo Settings > Tools > Git name and email, then make the first commit once they say it is done.')
    for line in ('.claude/settings.local.json', '.mcp.json', '.claude/worktrees/', 'CLAUDE.local.md'):
        gitignore(path, line)
    git('add', '-A')
    r = git('commit', '-q', '-m', 'Chammo 프로젝트 시작 — 하네스' if ko else 'Start Chammo project — harness')
    if r.returncode == 0:
        return True, ''
    if 'nothing to commit' in (r.stdout + r.stderr):
        return False, ''
    why = ' '.join((r.stderr or r.stdout).split())[:160]
    return False, (f'첫 커밋 실패 — {why}' if ko else f'First commit failed — {why}')


# 10MB 넘는 파일은 커밋을 한 번 멈춘다 — 디자인 원본이 커밋돼 .git 이 사흘에 407MB(2026-11-02, ADR 0024). 영영 막지 않는다:
# 꼭 넣어야 하면 CHAMMO_BIG_OK=1 로 다시(이유는 커밋 메시지에), 사람이 터미널에서 친 커밋은 경고만(사용자 11-02). git 표준 훅이라 어느 세션이든 같다
SIZE_HOOK = r"""#!/bin/sh
# Chammo: files over 10 MB (design, video, archive originals) stop a commit once — they usually stay out of git.
# Chammo: 10MB 넘는 파일(디자인·영상·압축 원본)은 커밋을 한 번 멈춘다 — 보통은 깃에 안 넣는다.
mb=${CHAMMO_COMMIT_MAX_MB:-10}
limit=$((mb * 1024 * 1024))
big=$(git -c core.quotepath=off diff --cached --name-only --diff-filter=AM | while IFS= read -r f; do
  s=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
  [ "$s" -gt "$limit" ] && echo "  $f ($((s / 1048576)) MB)"
done)
[ -z "$big" ] && exit 0
[ "${CHAMMO_BIG_OK:-}" = 1 ] && exit 0
if [ -t 2 ]; then
  echo "Note: files over $mb MB are going into git / 참고: ${mb}MB 넘는 파일이 깃에 들어가요:" >&2
  echo "$big" >&2
  exit 0
fi
echo "Commit stopped once — files over $mb MB (design, video and archive originals usually stay out of git):" >&2
echo "커밋 한 번 멈춤 — ${mb}MB 넘는 파일이에요(디자인·영상·압축 원본은 보통 깃에 안 넣어요):" >&2
echo "$big" >&2
echo "If it really must go in, commit again with CHAMMO_BIG_OK=1 and put the reason in the commit message. Otherwise: git reset <file> and add it to .gitignore." >&2
echo "꼭 넣어야 하면 CHAMMO_BIG_OK=1 로 다시 커밋하고 이유 한 줄을 커밋 메시지에. 아니면 git reset <파일> 하고 .gitignore 에." >&2
exit 1
"""


def size_hook(path):
    """새 깃 프로젝트에 큰 파일 훅 — 있던 훅은 안 덮는다"""
    hook = os.path.join(path, '.git', 'hooks', 'pre-commit')
    if os.path.exists(hook):
        return
    os.makedirs(os.path.dirname(hook), exist_ok=True)
    with open(hook, 'w', encoding='utf-8', newline='\n') as f:
        f.write(SIZE_HOOK)
    os.chmod(hook, 0o755)


def gitignore(path, line):
    """<폴더>/.gitignore 에 한 줄 — 있던 줄은 그대로, 이미 있으면 안 더한다"""
    gi = os.path.join(path, '.gitignore')
    try:
        with open(gi, encoding='utf-8') as f:
            body = f.read()
    except OSError:
        body = ''
    if line in body.splitlines():
        return
    with open(gi, 'w', encoding='utf-8') as f:
        f.write(body + ('' if not body or body.endswith('\n') else '\n') + line + '\n')


def pick_node(data, which=shutil.which, win=None):
    """브라우저 도구를 돌릴 node — 앱이 고른 것(<데이터>/tools/bin/node 링크) → 앱이 받은 것 → PATH·brew.
    .mcp.json 은 이 node 경로를 적으니 Homebrew 버전 폴더가 박히지 않게 링크부터(앱 browser_setup)"""
    win = os.name == 'nt' if win is None else win
    tools = os.path.join(data, 'tools')
    mine = [os.path.join(tools, 'node', 'node.exe')] if win else [os.path.join(tools, 'bin', 'node'), os.path.join(tools, 'node', 'bin', 'node')]
    for p in mine:
        if os.path.isfile(p):  # 링크면 가리키는 게 있어야
            return p
    return which('node') or next((p for p in ['/opt/homebrew/bin/node', '/usr/local/bin/node'] if not win and os.path.isfile(p)), None)


def browser(path, name, data, node=None, git=True):
    """브라우저 자동화가 깔려 있으면 이 프로젝트만의 브라우저 프로필(.mcp.json)을 만들고, 백그라운드 세션이 못 누르는
    MCP 승인 창을 미리 승인해 둔다(.claude/settings.local.json). 여러 세션이 한 브라우저로 부딪히지 않게"""
    tool = os.path.join(data, 'tools/chammo-browser')
    if not os.path.isfile(os.path.join(tool, 'node_modules/@playwright/mcp/package.json')):
        return False
    node = node or pick_node(data)
    if not node or not os.path.isfile(node):
        return False
    env = dict(os.environ, CHAMMO_HOME=data)
    r = subprocess.run([node, os.path.join(tool, 'bin/chammo-browser.js'), 'setup', name, path], env=env, capture_output=True, text=True)
    if r.returncode != 0:
        return False
    local_settings(path, enable=['playwright'])
    if git:
        gitignore(path, '.playwright-mcp/')  # playwright MCP 가 폴더에 남기는 페이지 스냅샷 — git 에 섞이지 않게
    return True


def next_cmd(path, name, first):
    """참모가 칠 세션 띄우기 한 줄 — 경로는 따옴표로(빈칸·한글 폴더 '내 프로젝트')"""
    return f'cd {shlex.quote(path)} && claude --bg --dangerously-skip-permissions -n {name} "{first}<first instruction>"'


def create(name, summary, data=None, home=None, today=None, node=None, win=None, use_git=None):
    """폴더·(고르면)git·하네스. 있는 파일은 안 덮는다. 사용자 project-starter 스킬이 있으면 그 스킬에 맡긴다.
    use_git = --git(True)/--no-git(False), None 이면 설정을 따른다"""
    if not valid_name(name):
        raise ValueError(f'folder name must be lowercase letters, digits, - _ . : {name!r}')
    home = home or os.path.expanduser('~')
    data = data or data_dir(home)
    cfg = config(data)
    dev = expand(cfg.get('devRoot') or '~/Developer', home)
    win = os.name == 'nt' if win is None else win
    path = os.path.join(dev, name)
    if win:
        # 홈(C:\\Users\\me) + 설정 '~/…' + join 이 'C:\\Users\\me/a/b\\c' 로 섞였다 — HQ 와 같게 / 로만(파이썬·bash·claude 다 받는다, 2026-10-22 윈도우 QA 2차)
        path = path.replace('\\', '/')
    existed = os.path.isdir(path)
    os.makedirs(path, exist_ok=True)
    ko = cfg.get('language') == 'ko'
    note = ''
    # 있던 폴더(사용자 것)는 깃을 켜지도 끄지도 않는다. 새 폴더만 고른 대로 — 깃이 기본이던 때 디자인 원본이 커밋돼 .git 407MB(2026-11-02)
    want = not existed and (git_on(cfg) if use_git is None else use_git)
    if want and not git_ok():
        want = False
        note = ('이 기기엔 git 이 없어서 깃 없이 만들었어 — 폴더에 파일만 남는다.' if ko
                else 'git is not available on this device, so the project was made without it — files just stay in the folder.')
    if want:
        subprocess.run(['git', 'init', '-q'], cwd=path, check=False)
    git = os.path.isdir(os.path.join(path, '.git'))
    starter = os.path.isfile(os.path.join(home, '.claude/skills/project-starter/SKILL.md'))
    written = []
    if not starter:
        lang = 'ko' if cfg.get('language') == 'ko' else 'en'
        tpl = os.path.join(data, 'templates/project', lang)
        date = today or datetime.date.today().isoformat()
        for root, _, files in os.walk(tpl):
            for fn in files:
                src = os.path.join(root, fn)
                rel = os.path.relpath(src, tpl)
                if rel == 'gitignore' and not git:
                    continue  # 깃이 없으면 거를 것도 없다
                rel = '.gitignore' if rel == 'gitignore' else rel
                dest = os.path.join(path, rel)
                if os.path.exists(dest):
                    continue
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                with open(src, encoding='utf-8') as f:
                    body = render(f.read(), git).replace('{{name}}', name).replace('{{summary}}', summary).replace('{{date}}', date)
                with open(dest, 'w', encoding='utf-8') as f:
                    f.write(body)
                written.append(rel)
    # 있던 폴더도 사용자가 믿은 프로젝트 폴더 안이면 적는다 — Claude 2.1.306 은 git 저장소 폴더에 위 믿음을 안 물려줘
    # 하네스를 깐 뒤 claude --bg 가 'Workspace not trusted' 였다(2026-10-21). 동의 전엔 몰래 안 믿는다
    trusted = trust(path, home, computer_use=computer_use_on(cfg)) if not existed or under_consent(data, path) else False
    web = False if existed else browser(path, name, data, node, git)  # 있던 폴더(사용자 저장소)의 .mcp.json 은 대신 안 건드린다
    status = os.path.join(data, 'tools/statusline')
    committed = False
    if not existed:
        # 상태줄 = 이 세션의 대화 % 가 사이드바에 뜨게(사용자 원래 상태줄은 그 안에서 그대로).
        # 격리 none = 새 프로젝트는 본 폴더에서 바로 고친다(HQ 와 같은 값) — 결과물이 숨은 .claude/worktrees 에만 생겼다(2026-10-21). 큰 일은 참모가 워크트리로
        # 데이터 폴더를 바꾼 설치(CHAMMO_HOME)면 그 값도 — 참모가 띄운 세션은 claude 데몬 env 로 떠서 CHAMMO_HOME 이 안 넘어가
        # scripts/direct·task·show 가 기본 폴더(~/.chammo)로 샜다(2026-10-22 첫 사용자 QA 1). 기본 폴더면 안 적는다
        custom = os.path.realpath(data) != os.path.realpath(data_dir(home, env=''))
        # 윈도우는 파이썬 도구(scripts/*) 출력이 cp949 라 프로젝트·예약 세션이 받는 한글이 깨졌다 — HQ(hq.rs)처럼 PYTHONUTF8(2026-10-22 윈도우 QA 2차)
        env = {**({'CHAMMO_HOME': data.replace('\\', '/') if win else data} if custom else {}), **({'PYTHONUTF8': '1'} if win else {})}
        local_settings(path, statusline=status if os.path.isfile(status) else None, isolation='none', env=env or None)
        if git:
            size_hook(path)
            committed, note = first_commit(path, 'ko' if ko else 'en')
    first = '/project-starter ' if starter else ''
    return {
        'path': path,
        'existed': existed,
        'git': git,
        'written': sorted(written),
        'projectStarter': starter,
        'trusted': trusted,
        'browser': web,
        'committed': committed,
        **({'note': note} if note else {}),
        'next': next_cmd(path, name, first),
    }


def parse_args(argv):
    """<name> "<summary>" [--git|--no-git] (깃발은 어디든) → (이름, 설명, True/False/None)"""
    use = None
    rest = []
    for a in argv:
        if a in ('--git', '--no-git'):
            use = a == '--git'
        else:
            rest.append(a)
    return (rest[0] if rest else ''), ' '.join(rest[1:]), use


def main(argv):
    name, summary, use = parse_args(argv)
    if not name or not summary:
        print(__doc__, file=sys.stderr)
        return 2
    try:
        out = create(name, summary, use_git=use)
    except ValueError as e:
        print(str(e), file=sys.stderr)
        return 2
    print(json.dumps(out, ensure_ascii=False, indent=2))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
