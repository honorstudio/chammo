#!/bin/sh
''':'
# sh 로 읽으면 맞는 파이썬을 골라 다시 실행한다 — 윈도우의 python3 는 스토어 대리 실행기(종료 49)라 py -3 → python 중 도는 것
[ "$OS" = Windows_NT ] || exec python3 "$0" "$@"
for p in "py -3" python; do $p -c '' >/dev/null 2>&1 && exec $p "$0" "$@"; done
echo "python not found — install Python 3 (winget install Python.Python.3.12)" >&2; exit 127
':'''
__doc__ = """Open files in the app — chat view: the space (Markdown as an editable page, the rest as a preview), terminal view: the reader.
파일을 앱에 띄운다 — 채팅 뷰면 스페이스(마크다운은 고칠 수 있는 문서, 그 밖은 미리보기), 터미널 뷰면 리더.

  scripts/show <file> [<file> ...]
  scripts/show <file> --line 264[-270] | --find "text" | --page 3 | --box x,y,w,h
  scripts/show <file>:264[-270]
  scripts/show http://localhost:3000   — an http(s) address opens in the in-app preview (reload, back, open in Chrome)
  scripts/show <video>                 — a video opens in the review view (notes at times, sent to you; phone too). --plain = just play it

Point at a spot / 짚어 보여 주기 — options apply to the file right before them. The app scrolls there
(PDF·slides: that page) and flashes it for a few seconds. --find works for any kind and beats --line.
--box is an area inside an image as left,top,width,height ratios (0-1).

Relative paths are resolved from the current folder. Missing files and files outside your home folder, the
projects folders, the folders the user opened in Settings (Folders it may open) and the copies of files the user
attached in chat (<data folder>/attach) are refused (the app won't open them either). Log: <data folder>/show.jsonl — {ts, path}. The app checks it
every 0.7 s while it is running.
"""
import datetime, json, os, re, sys, urllib.parse
for _io in (sys.stdin, sys.stdout, sys.stderr):  # 윈도우 파이썬 기본은 cp949 — PYTHONUTF8 없이 떠도(데몬 env 세션·작업 스케줄러) 한글·'—' 를 UTF-8 로(2026-11-01 win-text H1)
    if _io and hasattr(_io, 'reconfigure') and (_io.encoding or '').lower().replace('-', '') != 'utf8':
        _io.reconfigure(encoding='utf-8', errors='replace')


def data_dir(home=None, env=None, exists=os.path.isdir):
    """Data folder — same rule as the app: $CHAMMO_HOME -> ~/.chammo (-> ~/.honor-orchestrator for old installs)"""
    home = home or os.path.expanduser('~')
    env = os.environ.get('CHAMMO_HOME', '') if env is None else env
    if env.strip():
        return os.path.expanduser(env.strip())
    new, old = os.path.join(home, '.chammo'), os.path.join(home, '.honor-orchestrator')
    return old if not exists(new) and exists(old) else new


LOG = os.path.join(data_dir(), 'show.jsonl')
# 스페이스가 그림 한 장(QuickLook)밖에 못 보여 주는 형식 → 그 형식을 여는 참모 앱(app/src/domain/craftOpen craftFirstExts 와 같아야 한다 — 시험이 견준다).
# 사람이 앱에서 누르면 참모 앱으로 열리는 것들 — show 는 미리보기만 띄우고, 보고 고치려면 craft 로 열라고 한 줄
CRAFT_FIRST = {'ai': 'vectorcraft', 'ait': 'vectorcraft', 'eps': 'vectorcraft', 'svgz': 'vectorcraft', 'af': 'vectorcraft', 'afdesign': 'vectorcraft',
               'afpub': 'vectorcraft', 'emf': 'vectorcraft', 'wmf': 'vectorcraft', 'vectorcraft': 'vectorcraft', 'vctemplate': 'vectorcraft',
               'dwg': 'cadcraft', 'dxf': 'cadcraft', 'psd': 'photocraft', 'psb': 'photocraft', 'kra': 'photocraft', 'ora': 'photocraft', 'xcf': 'photocraft',
               'xlsb': 'gridcraft', 'fig': 'figcraft', 'figcraft': 'figcraft', 'designcraft': 'designcraft', 'fcproj': 'filmcraft', 'ecproj': 'effectcraft',
               'scproj': 'soundcraft', 'scraft': 'soundcraft'}


def craft_hint(real):
    """참모 앱이 맞는 형식이면 stderr 에 낼 한 줄, 아니면 None"""
    app = CRAFT_FIRST.get(os.path.splitext(real)[1].lower().lstrip('.'))
    if not app:
        return None
    return (f'preview picture only — to see/edit it as it is, open it in the Chammo app: scripts/craft open {app} --native "{real}" '
            f'(not installed → say you will install it, then go on) / 그림 미리보기뿐 — 제대로 보거나 고치려면 참모 앱으로: scripts/craft open {app} --native …'
            f'(안 깔렸으면 설치한다고 말하고 진행)')
HOME = os.path.realpath(os.path.expanduser('~'))


def web_url(s):
    """The address itself when it is http(s), else None — needs a scheme and host, no spaces or control characters (the app checks again)"""
    if not re.match(r'^https?://[^/?#\s]', s or '', re.I) or any(c.isspace() or ord(c) < 32 or ord(c) == 127 for c in s):
        return None
    try:
        host = urllib.parse.urlsplit(s).hostname
    except ValueError:  # http://[깨진 주소
        return None
    return s if host else None


def user_roots(ddir, home=HOME):
    """Folders a file may come from — home, plus the projects folder (devRoot) and extra projects in Chammo settings.
    On Windows projects often live outside home (D:\\dev) — the first job's result was refused (2026-11-01 win-first H2).
    A drive/disk top (/, D:\\) would open the whole disk, so it is skipped. Same rule as the app (reader::user_roots).
    Plus folders the person opened in Settings (openFolders — a D:\\ drive top is fine there, but never a folder that holds home:
    /, C:\\, C:\\Users) and the copies of files the person attached (<data>/attach) — public issue #19 (work files on D:\\Desktop)"""
    roots = [home]
    try:
        with open(os.path.join(ddir, 'config.json'), encoding='utf-8') as f:
            cfg = json.load(f)
        cands = [cfg.get('devRoot')] + list(cfg.get('extraProjects') or [])
        opened = list(cfg.get('openFolders') or [])
    except Exception:
        cands, opened = [], []
    for c in cands:
        if not isinstance(c, str) or not c.strip():
            continue
        r = os.path.realpath(os.path.expanduser(c.strip()))
        if os.path.isdir(r) and os.path.dirname(r) != r and not inside(os.path.realpath(home), r) and r not in roots:
            roots.append(r)
    h = os.path.realpath(home)
    for c in opened:
        if not isinstance(c, str) or not c.strip():
            continue
        r = os.path.realpath(os.path.expanduser(c.strip()))
        if os.path.isdir(r) and not inside(h, r) and not inside(r, h) and r not in roots:
            roots.append(r)
    a = os.path.realpath(os.path.join(ddir, 'attach'))
    if os.path.isdir(a) and not any(inside(a, r) for r in roots):
        roots.append(a)
    return roots


def inside(real, root):
    """real 이 root 안(또는 root 자체)인가 — 윈도우는 대소문자를 안 가린다, 드라이브 맨 위(D:\\)도"""
    a, b = (os.path.normcase(real), os.path.normcase(root.rstrip('\\/') or root))
    return a == b or a.startswith(b.rstrip(os.sep) + os.sep) or (b.endswith(':') and a.startswith(b + os.sep))


def resolve(p, cwd=None, home=HOME, roots=None):
    """Real absolute path, or None when missing or outside home and the projects folders"""
    real = os.path.realpath(os.path.join(cwd or os.getcwd(), os.path.expanduser(p)))
    if not os.path.isfile(real) or not any(inside(real, r) for r in (roots if roots is not None else [home])):
        return None
    return real


def parse_args(argv):
    """[(file, spot | None)] — --line/--find/--page/--box attach to the file before them; file:line works too"""
    out = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == '--plain' and out:
            out[-1] = (out[-1][0], {**(out[-1][1] or {}), 'plain': True})
            i += 1
            continue
        if a in ('--line', '--find', '--page', '--box') and out and i + 1 < len(argv):
            v = argv[i + 1]
            at = out[-1][1] or {}
            if a == '--line':
                lo, _, hi = v.partition('-')
                at['line'] = int(lo)
                if hi:
                    at['lineEnd'] = int(hi)
            elif a == '--find':
                at['find'] = v
            elif a == '--page':
                at['page'] = int(v)
            else:
                at['box'] = [float(x) for x in v.split(',')][:4]
            out[-1] = (out[-1][0], at)
            i += 2
            continue
        m = None if web_url(a) else re.match(r'^(.+?):(\d+)(?:-(\d+))?$', a)
        if m and not os.path.exists(a):
            at = {'line': int(m.group(2))}
            if m.group(3):
                at['lineEnd'] = int(m.group(3))
            out.append((m.group(1), at))
        else:
            out.append((a, None))
        i += 1
    return out


def fwd(p):
    """윈도우 경로(C:\\… · C:/…)만 / 로, 드라이브 글자는 대문자로 — 웹·폰은 / 로 문서 폴더를 구한다(앱 domain/paths fwd 와 같다, win-text M2)"""
    return p[0].upper() + p[1:].replace('\\', '/') if re.match(r'^[A-Za-z]:[\\/]', p or '') else p


def record(real, env, cwd, ts, at=None):
    """One show.jsonl line — who opened it (a background session's id = end of CLAUDE_JOB_DIR) and the folder,
    so the chat view can group files under the assistant/session that showed them"""
    r = {'ts': ts, 'path': fwd(real)}
    who = os.path.basename((env.get('CLAUDE_JOB_DIR') or '').rstrip('/'))
    if who:
        r['from'] = who
    r['cwd'] = fwd(cwd)
    if at:
        r['at'] = at
    return r


def is_video(p):
    return not web_url(p) and os.path.splitext(p)[1].lower() in ('.mp4', '.mov', '.m4v', '.webm')


def shown_where(ddir):
    """Where it will appear — the app writes its current view to view.json"""
    try:
        with open(os.path.join(ddir, 'view.json'), encoding='utf-8') as f:
            return 'shown in the chat view space / 채팅 뷰 스페이스에 띄움' if json.load(f).get('view') == 'chat' else 'sent to reader / 리더로 넘김'
    except Exception:
        return 'sent to reader / 리더로 넘김'


def main(argv):
    if not argv:
        print(__doc__, file=sys.stderr); return 2
    bad = 0
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    roots = user_roots(os.path.dirname(LOG))
    for p, at in parse_args(argv):
        real = web_url(p) or resolve(p, roots=roots)
        if not real:
            print(f'cannot open (missing, or outside home, the projects folders and the folders opened in Settings › Assistant › Folders it may open) / 못 띄움(없거나 홈·프로젝트·설정에서 연 폴더 밖 — 사용자가 채팅에 붙이거나 설정에서 그 폴더를 열어 줘야 해): {p}', file=sys.stderr); bad += 1; continue
        with open(LOG, 'a', encoding='utf-8') as f:
            f.write(json.dumps(record(real, os.environ, os.getcwd(), datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds'), at), ensure_ascii=False) + '\n')
        print(f'{shown_where(os.path.dirname(LOG))}: {real}' + (f'  (spot / 짚음: {json.dumps(at, ensure_ascii=False)})' if at else ''))
        if is_video(real) and not (at or {}).get('plain'):
            print('opens as a video review — the notes the user leaves at times come to your chat, record in <data folder>/curation/ · --plain to just play / '
                  '영상 검토 화면으로 뜸 — 사람이 시각마다 남긴 말이 채팅으로 온다, 기록은 <데이터>/curation/ · 그냥 재생은 --plain')
        hint = craft_hint(real)
        if hint:
            print(hint, file=sys.stderr)
    return 1 if bad else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
