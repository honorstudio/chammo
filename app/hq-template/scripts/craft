def _hand_words(s):
    return [w.lower() for w in re.findall(r'[a-z]+|[A-Z][a-z]*|\d+', s)]


def _hand_time(app, params):
    """시각 → 'mm:ss' — seconds 는 초, time 은 FilmCraft 면 tick"""
    v = params.get('seconds')
    if not isinstance(v, (int, float)) and isinstance(params.get('time'), (int, float)):
        v = params['time'] / FILM_TICKS if app == 'filmcraft' else params['time']
    if not isinstance(v, (int, float)) or isinstance(v, bool):
        return None
    return f'{int(v) // 60:02d}:{int(v) % 60:02d}'


def _hand_text(t, n=14):
    t = ' '.join(str(t).split())
    return f'“{t[:n].rstrip()}…”' if len(t) > n else f'“{t}”'


def hand_label(app, cmd, params):
    """명령 id → 짧은 한국어 — 앱별 표, 그다음 동사·명사로 짐작, 모르면 id 끝 낱말 그대로. 시각·글·이름을 덧붙인다"""
    params = params if isinstance(params, dict) else {}
    segs = cmd.split('.')
    tail, words = segs[-1], _hand_words(segs[-1])
    rest, up = ''.join(words[1:]), (segs[-2] if len(segs) > 1 else '')  # up = 꼬리 바로 앞 묶음(clip·slide)
    used = set()
    label = (HAND_KO.get(app) or {}).get(cmd)
    if label:
        def fill(m):
            used.add(m.group(1))
            v = params.get(m.group(1))
            return str(v) if isinstance(v, (str, int, float)) else ''
        label = ' '.join(re.sub(r'\{(\w+)\}', fill, label).split())
    elif hand_title(cmd):
        label = f'{HAND_NOUN[rest]} {HAND_TITLE[words[0]]}' if rest in ('all', 'selection') else HAND_TITLE[words[0]]
    elif words and words[0] == 'new' and (HAND_NOUN.get(rest) or (not rest and (up == 'file' or HAND_NOUN.get(up)))):
        label = f"새 {HAND_NOUN.get(rest) or HAND_NOUN.get(up, '문서')}"
    elif words and words[0] in HAND_VERB:
        noun = HAND_NOUN.get(rest) if rest else HAND_NOUN.get(up)  # 모르는 꼬리는 짐작 안 함(removeDuplicates ≠ 표 빼기)
        label = ' '.join(x for x in (noun, HAND_VERB[words[0]]) if x) if noun or not rest else tail
    elif len(segs) > 1 and segs[0] in HAND_VERB and tail in HAND_NOUN:
        label = f'{HAND_NOUN[tail]} {HAND_VERB[segs[0]]}'
    else:
        label = tail
    extra = []
    if hand_title(cmd):
        paths = params.get('paths') if isinstance(params.get('paths'), list) else [params['path']] if isinstance(params.get('path'), str) else []
        if paths:
            extra.append(os.path.basename(str(paths[0])) + (f' 외 {len(paths) - 1}' if len(paths) > 1 else ''))
    t = _hand_time(app, params)
    if t:
        extra.append(t)
    if isinstance(params.get('text'), str) and params['text'].strip() and 'text' not in used:
        extra.append(_hand_text(params['text']))
    if not extra and isinstance(params.get('name'), str) and params['name'] and 'name' not in used:
        extra.append(f'· {params["name"]}')
    return ' '.join([label] + extra)


def hand_title(cmd):
    """제목줄로 갈 명령인가 — 저장·열기·내보내기, 파일 묶음의 닫기(sequence.closeGap 같은 편집은 아님)"""
    segs = cmd.split('.')
    w = _hand_words(segs[-1])
    return bool(w) and w[0] in HAND_TITLE and (len(segs) == 1 or segs[0] in HAND_FILE or len(w) == 1 or ''.join(w[1:]) in ('all', 'selection')
                                               or w[0] in ('save', 'export', 'import'))


def hand_at(app, cmd):
    """그 앱에서 이 명령이 거쳐 갈 단추·패널 이름 — 딱 맞는 것, 그다음 묶음(끝이 *)"""
    t = HAND_AT.get(app) or {}
    return t.get(cmd) or next((v for k, v in t.items() if k.endswith('*') and cmd.startswith(k[:-1])), None)


def hand_read(cmd):
    """읽기만 하는 명령인가 — 끝 낱말의 첫·끝 단어(cell.get·sheet.read·project.inspect·file.get_info·text.fontList)"""
    w = _hand_words(cmd.split('.')[-1])
    return not w or w[0] in HAND_READ or w[-1] in HAND_READ


def common_hand(app, method, params):
    """공통 손 — 만들기·고치기는 명령 전에 작업 영역으로, 저장·열기·내보내기는 끝난 뒤 제목줄로"""
    params = params or {}
    if method in ('app.save', 'app.open'):
        return None, (['@title'], f"{'저장' if method == 'app.save' else '열기'} {params.get('path', '')}".strip())
    if method in ('ui.command', 'ui.menu.invoke'):
        cmd, inner = params.get('id') or '', {}
    elif method == 'engine.execute':
        cmd, inner = params.get('command') or '', params.get('params') or {}
    else:
        return None, None  # ui.* 같은 채널 명령 — 읽기거나 사람 입력 흉내
    if not cmd or hand_read(cmd):
        return None, None
    label, at = hand_label(app, cmd, inner), hand_at(app, cmd)
    if hand_title(cmd):
        return None, (at or ['@title'], label)
    return ((at or []) + ['@canvas'], label), None


def hand_plan(app, method, params):
    """(명령 전 손, 명령 뒤 손) — 손 = (이름들, 글) 또는 None, 명령 뒤 손은 응답을 봐야 하면 함수(hand_after 가 푼다).
    이름 = 앱 손쉬운 사용 이름, '@canvas'(캔버스), '@title'(제목줄), '@doc:…'(문서 좌표), '@bounds:[x,y,w,h]'(창 점).
    명령은 안 늦추고 앞뒤로 줄만 보낸다(빨라도 된다). 10/16 첫 시연(카드뉴스)에서 손이 한 번도 안 보였다 — 만드는 명령을 다 다룬다"""
    if app != 'photocraft':
        return common_hand(app, method, params)
    params = params or {}
    if method in ('app.save', 'app.open'):
        return None, (['@title'], f"{'저장' if method == 'app.save' else '열기'} {params.get('path', '')}".strip())
    if method != 'engine.execute':
        return None, None  # ui.* 같은 채널 명령 — 읽기거나 사람 입력 흉내
    cmd = params.get('command', '')
    inner = params.get('params') or {}
    tail = cmd.split('.')[-1]
    if cmd.startswith('layer.newAdjustmentLayer.'):
        return (['새 칠 또는 조정 레이어 만들기'], f'새 {PC_KIND.get(tail, tail)} 레이어'), _param_hand(inner)
    if cmd == 'layer.setAdjustment':
        return _param_hand({k: v for k, v in inner.items() if k != 'layer'}), None
    if cmd.startswith(('image.adjustments.', 'filter.')):
        return (['@canvas'], PC_KIND.get(tail, tail)), None
    if cmd == 'file.new':
        return None, (['@canvas'], f"새 문서 {inner.get('width', 1920)}×{inner.get('height', 1080)}")
    if cmd.startswith('layer.newFillLayer.'):
        return (['새 칠 또는 조정 레이어 만들기'], f'새 {PC_FILL.get(tail, tail)}'), (['@canvas'], PC_FILL.get(tail, tail))
    if cmd in ('shape.create', 'type.create'):
        shape = cmd == 'shape.create'
        pre = (['@canvas'], f"새 모양 · {PC_SHAPE.get(inner.get('kind', 'rect'), inner.get('kind'))}" if shape else '새 글자')

        def post(resp, ask):
            name = (resp or {}).get('name') or inner.get('name')
            try:
                spot = _doc_spot(ask, (resp or {}).get('bounds'))
                name = name or _layer_name(ask, (resp or {}).get('layer'))
            except CraftError:
                spot = None
            names = [n for n in (spot, name) if n]
            label = name if shape else f"글자 “{inner.get('text', '')}”"
            return (names, label) if names else None
        return pre, post
    if cmd == 'type.setStyle' or cmd.startswith('layer.layerStyle.'):
        label = '글자 모양' if cmd == 'type.setStyle' else f'레이어 스타일 · {PC_STYLE.get(tail, tail)}'

        def post(resp, ask):
            try:
                name = _layer_name(ask, inner.get('layer'))
            except CraftError:
                name = None
            return ([name], label) if name else (['@canvas'], label)
        return None, post
    if any(w in tail for w in READ_ONLY) or not cmd:
        return None, None
    return common_hand(app, method, params)  # 모르는 명령도 최소한 캔버스·제목줄에 사람 말


def hand_after(post, resp, ask):
    """명령 뒤 손 — 함수면 응답·채널(ask)로 자리를 정한다. 못 정하면 None(명령은 이미 끝났다)"""
    if callable(post):
        try:
            return post(resp, ask)
        except Exception:
            return None
    return post


# 보기 따라가기 — 사람이 일하듯 앱 보기 자체를 일하는 자리로: 필름은 재생 위치(타임라인이 넘어간다), 표는 그 칸이 보이게 스크롤, 포토는 긴 캔버스의 그 부분으로.
# 명령 전에 한 번, 손보다 먼저(손은 옮긴 화면에서 자리를 찾는다). 같은 자리 연속이면 안 옮긴다. 끄기 CHAMMO_CRAFT_VIEW=0
VIEW_TIME_KEYS = ('time', 'frame', 'seconds', 'timecode')
PC_CANVAS_PAD = (375, 130)  # 포토 창에서 캔버스 밖(왼쪽 도구·오른쪽 패널, 위 옵션줄·아래 상태줄) — 보이는 문서 범위 어림
_A1 = re.compile(r'^\$?([A-Za-z]{1,3})\$?(\d+)$')


def _pc_rect(cmd, p):
    """포토 명령이 그릴 자리(문서 픽셀 [x, y, w, h]) — 모르면 None"""
    num = lambda *v: all(isinstance(x, (int, float)) for x in v)
    if cmd == 'select.rect' and num(*(p.get(k) for k in ('x', 'y', 'width', 'height'))):
        return [p['x'], p['y'], p['width'], p['height']]
    box = p.get('rect') if cmd == 'shape.create' else p.get('box') if cmd == 'type.create' else None
    if isinstance(box, list) and len(box) == 4 and num(*box):
        return list(box)
    if cmd == 'shape.create' and isinstance(p.get('from'), list) and isinstance(p.get('to'), list):
        (x1, y1), (x2, y2) = p['from'][:2], p['to'][:2]
        return [min(x1, x2), min(y1, y2), abs(x2 - x1), abs(y2 - y1)]
    if cmd == 'type.create' and num(p.get('x'), p.get('y')):
        return [p['x'], p['y'] - 40, 1, 40]  # 글줄 기준선 위로 한 줄
    return None


def view_target(app, method, params):
    """이 명령이 일할 자리 — ('time', 재생 위치 값) · ('cell', 'B7') · ('rect', [x, y, w, h]) 또는 None(옮길 것 없음)"""
    if os.environ.get('CHAMMO_CRAFT_VIEW') == '0' or method != 'engine.execute':
        return None
    cmd, inner = (params or {}).get('command') or '', (params or {}).get('params') or {}
    if not isinstance(inner, dict) or hand_read(cmd):
        return None
    if app == 'filmcraft':
        tp = {k: inner[k] for k in VIEW_TIME_KEYS if k in inner}
        return ('time', tp) if tp and not cmd.startswith('playhead.') else None
    if app == 'gridcraft':
        ref = inner.get('cell') or inner.get('range')
        if cmd.startswith('selection.') or not isinstance(ref, str):
            return None
        m = _A1.match(ref.split('!')[-1].split(',')[0].split(':')[0].strip())
        return ('cell', f'{m.group(1).upper()}{m.group(2)}') if m else None
    if app == 'photocraft':
        r = _pc_rect(cmd, inner)
        return ('rect', r) if r else None
    return None


def _col_n(s):
    n = 0
    for ch in s.upper():
        n = n * 26 + ord(ch) - 64
    return n


def _col_s(n):
    s = ''
    while n:
        n, r = divmod(n - 1, 26)
        s = chr(65 + r) + s
    return s


def _grid_reveal(cell, ask):
    """표 — 엔진 명령(selection.set·cell.set)은 스크롤하지 않고 키보드 이동만 '활성 칸 보이게'를 켠다.
    한 칸 옆을 고르고 화살표로 그 칸에 닿게 한 뒤 원래 선택으로 되돌린다(되돌리기는 스크롤 안 함).
    목표 칸이 화면 끝에 붙지 않게 아래·오른쪽 여유 칸, 위·왼쪽 여유 칸 순서로 두 번 — 어느 쪽에서 와도 둘레가 보인다"""
    m = _A1.match(cell)
    col, row = _col_n(m.group(1)), int(m.group(2))
    doc = lambda: ask('engine.execute', {'command': 'document.inspect', 'params': {}}) or {}
    d = doc()
    prev, active = d.get('selection'), d.get('activeCell')
    for c, r in ((col + 2, row + 4), (max(1, col - 2), max(1, row - 4))):
        to = f'{_col_s(c)}{r}'
        near, key = (f'{_col_s(c)}{r - 1}', 'ArrowDown') if r > 1 else (f'{_col_s(c)}{r + 1}', 'ArrowUp')
        ask('engine.execute', {'command': 'selection.set', 'params': {'range': near}})
        ask('ui.key', {'key': key})
        end = time.time() + 0.5
        while time.time() < end:  # 키는 다음 그림 때 처리된다 — 먼저 되돌리면 키가 되돌린 자리에서 움직인다
            if doc().get('activeCell') == to:
                break
            time.sleep(0.02)
    if prev:
        ask('engine.execute', {'command': 'selection.set', 'params': {'range': prev, **({'active': active} if active else {})}})


def _photo_reveal(r, ask):
    """포토 — 그 자리가 지금 보이는 범위 밖이면 배율은 두고 가운데만 옮긴다(긴 상세페이지 스크롤). 화면보다 크면 들어오게 줄인다"""
    ins = ask('ui.inspect', {}) or {}
    v, win = (ins.get('views') or [{}])[0], ins.get('window') or {}
    (cx, cy), z, (dw, dh) = v['center'], float(v['zoom']), v['doc_size']
    pw, ph = max(100.0, win.get('width', 1360) - PC_CANVAS_PAD[0]), max(100.0, win.get('height', 820) - PC_CANVAS_PAD[1])
    x, y, w, h = r
    if cx - pw / z / 2 <= x and x + w <= cx + pw / z / 2 and cy - ph / z / 2 <= y and y + h <= cy + ph / z / 2:
        return
    nz = min(z, 0.9 * min(pw / max(w, 1), ph / max(h, 1)))
    fit = lambda c, view, size: size / 2 if view >= size else min(max(c, view / 2), size - view / 2)
    ask('ui.set', {'zoom': nz, 'center': [fit(x + w / 2, pw / nz, dw), fit(y + h / 2, ph / nz, dh)]})


def view_move(app, target, ask, last):
    """보기를 그 자리로 → 옮긴 자리(다음 비교용). 같은 자리면 그대로, 실패해도 명령은 막지 않는다(None)"""
    if not target or target == last:
        return last
    kind, v = target
    try:
        if kind == 'time':
            ask('engine.execute', {'command': 'playhead.set', 'params': v})  # 재생 위치가 화면 밖이면 타임라인이 그쪽으로 넘어간다
        elif kind == 'cell':
            _grid_reveal(v, ask)
        elif kind == 'rect':
            _photo_reveal(v, ask)
        return target
    except (CraftError, KeyError, TypeError, ValueError, IndexError, AttributeError):
        return None


GRID_CELL, GRID_Z = (64, 20), 0.8  # 표 기본 칸(시트 단위)과 100% 화면 배율 — 칸 자리를 묻는 명령이 없어 격자 자리·스크롤(시트 단위)에서 센다(10/21 실측)


def _grid_bounds(ask, ref):
    """표 칸·범위(첫 묶음) → '@bounds:[x,y,w,h]'(창 점) — 보이는 격자 밖이면 None"""
    a = ref.split('!')[-1].split(',')[0].strip()
    ends = [_A1.match(x.strip()) for x in a.split(':')]
    if not all(ends):
        return None
    cs, rs = [_col_n(m.group(1)) for m in ends], [int(m.group(2)) for m in ends]
    ui = ask('ui.inspect', {}) or {}
    (gx, gy, gw, gh), (sx, sy) = ui['grid'], ui.get('scroll') or (0, 0)
    (cw, rh), z = GRID_CELL, GRID_Z
    x, y = gx + ((min(cs) - 1) * cw - sx) * z, gy + ((min(rs) - 1) * rh - sy) * z
    w, h = (max(cs) - min(cs) + 1) * cw * z, (max(rs) - min(rs) + 1) * rh * z
    if x + w / 2 < gx or x + w / 2 > gx + gw or y + h / 2 < gy or y + h / 2 > gy + gh:
        return None
    g = lambda n: f'{n:g}'
    return f'@bounds:[{g(x)},{g(y)},{g(w)},{g(h)}]'


def hand_spot(app, method, params, hand, ask):
    """손 자리를 일하는 곳으로 — '@canvas'(가운데) 대신 표는 그 칸, 포토 사각 선택은 그 영역. 모르면 손 그대로(보기 옮긴 뒤에 부른다)"""
    if not hand or method != 'engine.execute':
        return hand
    cmd, inner = (params or {}).get('command') or '', (params or {}).get('params') or {}
    names, label = hand
    try:
        spot = None
        if app == 'gridcraft' and not cmd.startswith('selection.') and isinstance(inner.get('cell') or inner.get('range'), str):
            spot = _grid_bounds(ask, inner.get('cell') or inner.get('range'))
        elif app == 'photocraft' and cmd == 'select.rect':
            r = _pc_rect(cmd, inner)
            spot = r and _doc_spot(ask, r)
    except (CraftError, KeyError, TypeError, ValueError, AttributeError):
        return hand
    return ([n for n in names if n != '@canvas'] + [spot], label) if spot else hand


def view_file(ddir, app):
    return os.path.join(ddir, 'craft-native', f'{app}.view.json')


def load_view(ddir, app):
    t = _read_json(view_file(ddir, app)).get('target')
    return tuple(t) if isinstance(t, list) and len(t) == 2 else None


def save_view(ddir, app, target):
    try:
        _write_json(view_file(ddir, app), {'target': list(target) if target else None})
    except OSError:
        pass


def hand_line(ddir, app, hand, hold=0, keep=False):
    """손 한 줄(app.jsonl) → 그 줄 id. hold 초 = 그동안 손이 머문다(앱이 고리·경과 시간을 그린다).
    keep = 머물기 이어 주기 — '마지막 손' 표(<앱>.hand)를 안 바꿔서, 새 명령의 손이 오면 지켜보기가 물러난다"""
    import datetime, uuid
    if not hand:
        return None
    names, label = hand
    arg = {'verb': 'point', 'app': app, 'names': names, 'label': label}
    if hold:
        arg['hold'] = int(hold)
    line = {'ts': datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds'), 'action': 'craft', 'arg': arg, 'id': uuid.uuid4().hex[:12]}
    with open(os.path.join(ddir, 'app.jsonl'), 'a', encoding='utf-8') as f:
        f.write(json.dumps(line, ensure_ascii=False) + '\n')
    if not keep:
        try:
            os.makedirs(os.path.join(ddir, 'craft-native'), exist_ok=True)
            with open(os.path.join(ddir, 'craft-native', f'{app}.hand'), 'w', encoding='utf-8') as f:
                f.write(line['id'])
        except OSError:
            pass
    return line['id']


def hand_mark(ddir, app):
    try:
        with open(os.path.join(ddir, 'craft-native', f'{app}.hand'), encoding='utf-8') as f:
            return f.read().strip()
    except OSError:
        return None


# 긴 명령(내보내기·렌더) — 손이 그 자리에 머물며 '내보내는 중…', 파일이 다 써지면 '내보냄 a.mp4'(10/20 사용자 "작업하는지 모른다").
# 필름 내보내기는 wait:false 로 바로 답하고 몇 분 쓴다(그동안 조작 채널도 바빠 jobs.list 가 안 됨) — 결과 파일 크기가 멈추면 끝으로 본다
HOLD_S = 30  # 머물기 한 줄 길이 — 그 안에 이어 주기가 안 오면 앱이 손을 내린다(스크립트가 죽어도 손이 안 남게)
HOLD_EVERY = 15


def hand_long(app, method, params):
    """긴 명령이면 (손 자리, 하는 중 글, 끝 글, 기다릴 파일 또는 None), 아니면 None"""
    if method != 'engine.execute':
        return None
    cmd, inner = (params or {}).get('command') or '', (params or {}).get('params') or {}
    w = _hand_words(cmd.split('.')[-1])
    if not w or hand_read(cmd):
        return None
    if w[0] == 'render':
        names, doing, done = ['@canvas'], '렌더 중…', '렌더 끝'
    elif w[0] == 'export' or cmd in ('export.quick', 'export.queue.start', 'export.queue.add'):
        names, doing, done = ['@title'], '내보내는 중…', '내보냄'
    else:
        return None
    path = inner.get('path') if isinstance(inner.get('path'), str) else None
    return names, doing, f'{done} {os.path.basename(path)}' if path else done, path


def hold_watch(ddir, app, names, doing, done, path, hid, pid, sleep=time.sleep, step=5, every=3, cap=3600):
    """파일이 다 써질 때까지 손을 머물게 이어 준다 — step 초마다 크기를 보고 두 번 같으면 끝 글. 새 손이 왔거나 앱이 꺼지면 조용히 물러난다"""
    last = None
    for i in range(int(cap / step)):
        if hand_mark(ddir, app) != hid or not pid_alive(pid):
            return
        size = os.path.getsize(path) if path and os.path.exists(path) else None
        if size and size == last:
            break
        last = size
        if i % every == 0:
            hand_line(ddir, app, (names, doing), hold=HOLD_S, keep=True)
        sleep(step)
    if hand_mark(ddir, app) == hid:
        hand_line(ddir, app, (names, done))


# ── 개입: 사람이 Craft 창에서 직접 조작하는 동안 참모 명령은 멈추고, 돌려받을 때 바뀐 것을 한 줄로 ──

def takeover_file(ddir, app):
    return os.path.join(ddir, 'craft-native', f'{app}.takeover.json')


def save_takeover(ddir, app, obj):
    _write_json(takeover_file(ddir, app), obj)


def drop_takeover(ddir, app):
    try:
        os.remove(takeover_file(ddir, app))
    except OSError:
        pass


def is_read(method, params):
    """보기만 하는 채널 명령인가 — 개입 중에도 된다(사람이 하는 걸 참모가 읽어 볼 수 있게)"""
    if method in ('ui.inspect', 'ui.screenshot', 'engine.commands'):
        return True
    if method == 'engine.execute':
        tail = ((params or {}).get('command') or '').split('.')[-1]
        return any(w in tail for w in READ_ONLY)
    return False


def check_takeover(ddir, app, method=None, params=None):
    if method and is_read(method, params):
        return
    if _read_json(takeover_file(ddir, app)).get('on'):
        raise TakeoverError(f'{display(app)}: a person took over — script stopped. When they hand it back you get the state; ask them what next instead of rerunning / '
                            f'사람이 개입함 — 스크립트 멈춤. 돌려받으면 상태가 오니 남은 걸 다시 돌리지 말고 사람에게 다음을 물어')


def change_summary(before, after):
    """개입 전후 문서 상태(document.inspect) → 사람이 바꾼 것 한 줄(참모 입력칸으로)"""
    out = []
    bl = {x['id']: x for x in before.get('layers', [])}
    al = {x['id']: x for x in after.get('layers', [])}
    out += [f"레이어 '{x['name']}' 추가" for i, x in al.items() if i not in bl]
    out += [f"레이어 '{x['name']}' 지움" for i, x in bl.items() if i not in al]
    for i in [i for i in al if i in bl]:
        a, b = bl[i], al[i]
        if a.get('visible') != b.get('visible'):
            out.append(f"'{b['name']}' {'보임' if b.get('visible') else '숨김'}")
        if abs(a.get('opacity', 1) - b.get('opacity', 1)) > 1e-6:
            out.append(f"'{b['name']}' 불투명도 {round(a.get('opacity', 1) * 100)}→{round(b.get('opacity', 1) * 100)}%")
        pa = (a.get('adjustment') or {}).get('params') or {}
        pb = (b.get('adjustment') or {}).get('params') or {}
        for k, v in pb.items():
            if isinstance(v, (int, float)) and pa.get(k) != v:
                name = PC_PARAM.get(k, k)
                fmt = lambda n: f'{n:g}' if isinstance(n, (int, float)) else str(n)
                out.append(f"'{b['name']}' {name} {fmt(pa.get(k))}→{fmt(v)}")
    h = after.get('history', [])[len(before.get('history', [])):]
    if h:
        out.append(f'작업 내역 +{len(h)}(' + ', '.join(h) + ')')
    # 레이어가 없는 앱(참모 표 — sheets·undo) — 시트마다 칸 수·쓴 범위, 되돌리기 목록에 새로 생긴 일(2026-10-21: B1 을 바꿨는데 '바뀐 것 없음')
    bs = {x.get('name'): x for x in before.get('sheets', []) if isinstance(x, dict)}
    for x in [x for x in after.get('sheets', []) if isinstance(x, dict)]:
        y = bs.pop(x.get('name'), None)
        if y is None:
            out.append(f"시트 '{x.get('name')}' 추가")
            continue
        if y.get('cells') != x.get('cells'):
            out.append(f"'{x.get('name')}' 칸 {y.get('cells')}→{x.get('cells')}")
        if y.get('usedRange') != x.get('usedRange'):
            out.append(f"'{x.get('name')}' 범위 {y.get('usedRange')}→{x.get('usedRange')}")
    out += [f"시트 '{n}' 지움" for n in bs]
    u0, u1 = before.get('undo') or [], after.get('undo') or []
    if isinstance(u0, list) and isinstance(u1, list) and u1 != u0:
        new, undone = undo_diff(u0, u1)
        if new:
            out.append(f'작업 +{new}(' + ', '.join(str(e) for e in u1[:new]) + ')')
        if undone:
            out.append(f'실행 취소 {undone}(' + ', '.join(str(e) for e in u0[:undone]) + ')')
    return ' · '.join(out) or '바뀐 것 없음'


def undo_diff(u0, u1):
    """되돌리기 목록 전후(최근 것이 앞) → (새로 한 일 수, 사람이 실행 취소한 수). 앞에서 j 개를 취소하고 i 개를 새로 했으면
    u1[i:] 가 u0[j:] 와 이어진다(새것이 들어와 목록이 안 줄었으면 상한에 밀려 끝까지 안 닿아도 된다 — 상한 값은 앱마다라 모른다). 가장 적게 바뀐 설명을 고른다 —
    줄어든 목록의 남은 항목을 새 작업으로 세던 것(0.3.6 리뷰 '작업 +2(b, c)')"""
    best = (len(u1), len(u0))
    for i in range(len(u1) + 1):
        rest = u1[i:]
        for j in range(len(u0) + 1):
            if i + j >= sum(best):
                break
            seg = u0[j:j + len(rest)]
            if seg == rest and (j + len(rest) == len(u0) or (i > 0 and len(u1) >= len(u0))):
                best = (i, j)
                break
    return best


# ── 닫기 = 묻지 않고 저장 후 닫기(2026-10-16 결정) ──
# 저장은 한 번에 0.3~0.37초(1520x2000, PSD·PNG 실측) — 명령마다 저장하면 명령이 0.08 → 0.4초로 늘어서 닫을 때·꺼낼 때·앱을 끌 때만 한다
RECENT_MAX = 20


def free_name(path, ours=frozenset()):
    """덮어쓰지 않을 자리 — 있으면 ' 2'·' 3'… 우리가 써 둔 자리(ours, 최근 문서)면 그대로 다시 쓴다"""
    if path in ours or not os.path.lexists(path):
        return path
    stem, ext = os.path.splitext(path)
    n = 2
    while os.path.lexists(f'{stem} {n}{ext}') and f'{stem} {n}{ext}' not in ours:
        n += 1
    return f'{stem} {n}{ext}'


def close_plan(doc, sources, save_dir, work, ours=frozenset(), ext='.psd'):
    """[(작업 폴더 안에 저장할 이름, 옮길 자리)] — 파일에서 왔으면 그 파일(같은 형식) + 옆에 레이어 살린 PSD,
    새 문서면 보관함 Craft 폴더에 그 앱 형식, 보관함을 모르면 작업 폴더. 옆 PSD 는 사람이 가진 파일을 덮지 않는다(' 2') — 우리가 써 둔 것(ours)만 그 자리에 다시.
    새 문서는 우리가 써 둔 자리여도 늘 새 이름 — 이름 없는 새 문서가 다 untitled 라 앞 문서를 덮었다(10-28 참모 벡터)"""
    name = doc.get('name') or ''
    stem, own = os.path.splitext(name or 'untitled')
    src = sources.get(name)
    if src:
        out = [(name, src)]
        if ext == '.psd' and own.lower() != '.psd':  # 레이어 살린 PSD 사본은 PhotoCraft 만
            out.append((stem + '.psd', free_name(os.path.splitext(src)[0] + '.psd', ours)))
        return out
    dest = free_name(os.path.join(save_dir or work, stem + ext))
    return [(stem + ext if save_dir else os.path.basename(dest), dest)]


def recent_file(ddir):
    return os.path.join(ddir, 'craft-native', 'recent.json')


def recent(ddir):
    r = _read_json(recent_file(ddir))
    return r.get('items', []) if isinstance(r, dict) else []


def add_recent(ddir, app, paths, saved=False):
    """최근 Craft 문서 — 새것부터, 같은 자리는 하나, RECENT_MAX 개까지(scripts/craft recent·open <앱> <파일> 로 이어 다룬다).
    saved = 우리가 쓴 파일(다음 닫기 때 그 자리에 다시 써도 되는 것)"""
    now = time.strftime('%Y-%m-%d %H:%M')
    old = {r.get('path'): r for r in recent(ddir)}
    new = [{'app': app, 'path': p, 'at': now, **({'saved': True} if saved or old.get(p, {}).get('saved') else {})} for p in paths]
    keep = [r for r in recent(ddir) if r.get('path') not in paths]
    _write_json(recent_file(ddir), {'items': (new + keep)[:RECENT_MAX]})


def open_file_arg(rest):
    """open <앱> [--native] [<파일>] — 앱 이름 뒤 첫 글자 인자(--work 값은 빼고)"""
    skip = False
    for a in rest[1:]:
        if skip:
            skip = False
        elif a in ('--work', '--wait'):
            skip = True
        elif not a.startswith('--'):
            return a
    return None


def locker_craft_dir(env=os.environ):
    """새 문서를 둘 자리 — 띄운 참모의 보관함 Craft 폴더(scripts/locker 와 같은 규칙). 참모 밖에서 띄웠으면 None"""
    try:
        import importlib.machinery, importlib.util
        path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'locker')
        lo = importlib.machinery.SourceFileLoader('chammo_locker', path)
        lk = importlib.util.module_from_spec(importlib.util.spec_from_loader('chammo_locker', lo))
        lo.exec_module(lk)
        home, d = os.path.expanduser('~'), lk.data_dir()
        root = lk.root_of(home, d, env.get('CHAMMO_LOCKER_ROOT', ''))
        who = lk.find_owner(env, d, root, None)
        return lk.sub_dir(lk.owner_dir(root, *who), 'Craft', make=True) if who else None
    except Exception:
        return None


def opener_id(env=os.environ):
    """이 명령을 부른 참모 세션 번호 — 세션마다 CLAUDE_JOB_DIR 끝이 세션 번호(scripts/locker 와 같은 길). 참모 밖이면 None"""
    return os.path.basename((env.get('CLAUDE_JOB_DIR') or '').rstrip('/')) or None


def opener_for(st, me):
    """돌려받음 [앱] 줄을 받을 참모 — 그 앱을 처음 연 참모. 떠 있는 앱에 다른 참모가 파일을 열어도 안 바꾼다(엉뚱한 참모에게 가던 것)"""
    return st.get('by') or me


# 사람 파일을 여는 길 — 앱마다 다르다(10/21 13개 실측, QA 0.3.6 7c). (열기, 원래 자리에 다시 써도 되는 형식, 그 밖의 파일 가져오기)
# 열기: app.open·ui.open = 채널 명령, 그 밖은 엔진 명령 id(engine.execute). 참모 문서·화면·필름엔 app.open 이 없고 PDF 는 ui.open 만
# 다시 써도 되는 형식: 그 앱이 그 형식 그대로 저장하는 것만(None = 다, 포토는 close_plan 이 옆에 PSD) — 아니면 닫을 때 보관함에 그 앱 형식으로 새로.
#   필름·이펙트·사운드의 file.open·session.open 은 '프로젝트 열기'라 영상·소리는 가져오기 — 닫을 때 영상 자리에 프로젝트를 쓰면 안 된다
OPEN = {
    'photocraft': ('app.open', None, None),
    'wordcraft': ('file.open', {'.docx'}, None),
    'pdfcraft': ('ui.open', {'.pdf'}, None),
    'vectorcraft': ('app.open', {'.vectorcraft', '.svg', '.svgz', '.pdf', '.ai'}, None),
    'designcraft': ('file.open', {'.designcraft'}, None),
    'cadcraft': ('app.open', {'.dwg'}, None),
    'gridcraft': ('app.open', {'.xlsx', '.csv', '.tsv', '.json'}, None),
    'deckcraft': ('app.open', {'.pptx'}, None),
    'figcraft': ('file.open', {'.figcraft'}, None),  # .fig 는 '최선' 읽기·실험 내보내기 — 사람 피그마 파일에 다시 쓰지 않는다
    'filmcraft': ('file.open', {'.fcproj'}, 'file.import'),
    'effectcraft': ('file.open', {'.ecproj'}, 'file.import'),
    'soundcraft': ('session.open', {'.scraft', '.scproj'}, 'file.import_audio'),
    'lightcraft': (None, set(), 'library.import'),  # 보관함 앱 — 사진을 들이기만(mode add = 제자리 참조), 저장은 앱이 스스로
}


def open_call(app, work, name):
    """작업 폴더의 name 을 여는 채널 요청 → (method, params, 닫을 때 원래 자리로 돌려놓아도 되나).
    포토는 작업 폴더 기준 이름(앱이 작업 폴더 밖을 거절), 나머지는 절대 경로(벡터는 상대 경로를 못 씀)"""
    app = base(app)
    how, own, imp = OPEN[app]
    if app == 'photocraft':
        return 'app.open', {'path': name}, True
    full = os.path.join(os.path.abspath(work), name)
    back = own is None or os.path.splitext(name)[1].lower() in own
    if not back and imp:
        p = {'paths': [full]} if app in ('effectcraft', 'lightcraft') else {'path': full}
        if app == 'lightcraft':
            p['mode'] = 'add'
        return 'engine.execute', {'command': imp, 'params': p}, False
    if how in ('app.open', 'ui.open'):
        return how, {'path': full}, back
    return 'engine.execute', {'command': how, 'params': {'path': full}}, back


def open_file(ddir, app, path):
    """사람 파일을 작업 폴더로 복사해 열고, 열기가 된 뒤에야 닫을 때 돌려놓을 자리를 기억한다(원본은 닫을 때까지 안 건드린다).
    열기 전에 기억하면 열기가 실패해도 닫을 때 빈 문서가 사람 파일 자리에 저장됐다(QA 0.3.6 7c — 7,951B 원본 → 빈 문서+한 줄)"""
    st = load_state(ddir, app)
    src = os.path.abspath(os.path.expanduser(path))
    if not os.path.isfile(src):
        raise CraftError(f'no such file / 파일 없음: {path}')
    work = st.get('work') or '.'
    name = os.path.basename(src)
    had = (st.get('sources') or {}).get(name)
    if had and os.path.abspath(had) != src:  # 작업 폴더 사본을 덮고 돌려놓을 자리가 바뀌어 첫 파일에 한 일이 안 돌아갔다
        raise CraftError(f'{name} from another folder is already open ({had}) — open this one in its own instance / 다른 폴더의 같은 이름 파일이 이미 열려 있음 — 따로 띄워서(scripts/craft open {base(app)} --native)')
    here = os.path.join(work, name)
    if not (os.path.exists(here) and os.path.samefile(src, here)):  # --work 가 그 파일 폴더면 복사할 것 없음(SameFileError)
        shutil.copy2(src, here)
    method, params, back = open_call(app, work, name)
    c = Channel(st)
    try:
        c.call(method, params)
    finally:
        c.close()
    st = load_state(ddir, app)
    st['opened'] = [n for n in st.get('opened') or [] if n != name] + [name]  # 연 파일 전부 — 하나일 때만 그 이름으로 저장한다(autosave)
    if back:
        st.setdefault('sources', {})[name] = src
    save_state(ddir, app, st)
    add_recent(ddir, base(app), [src])
    print(f'{display(app)}: opened / 열었음 — {src}' + ('' if back else ' (saved as a new file on close / 닫을 때 새 파일로 저장 — 원본은 그대로)'))


def autosave(ddir, app, st):
    """닫기 전에 — 바뀐 게 있으면 그 앱 저장 명령으로 작업 폴더에 저장하고 원래 자리로 옮긴다. 옮긴 자리 목록(안 바뀌었으면 빈 목록)"""
    # 개입 중이면 사람이 고쳤을 수 있다 — dirty 는 돌려받을 때만 적혀서, 개입 중에 닫으면 사람이 한 게 사라졌다
    status = _read_json(status_file(ddir, app))
    # 사람 화면에 띄운 포토(꺼내기·--here)는 사람이 창에서 직접 고친다 — dirty 는 참모 명령으로만 적혀서 닫을 때 사람이 한 게 사라졌다.
    # 그 포토는 문서 기록(history)으로 본다: 연 것뿐이면 저장 안 함(보기만 한 JPEG 를 다시 저장해 재압축하지 않게), 더 있으면 저장
    known = bool(status.get('dirty')) or bool(_read_json(takeover_file(ddir, app)).get('on'))
    here_photo = bool(st.get('here')) and base(app) == 'photocraft' and not known
    if not known and not here_photo:
        return []
    spec = NATIVE.get(base(app)) or {}
    if not spec.get('save'):
        return []
    work = st.get('work') or '.'
    c = Channel(st)
    try:
        doc = {}
        if base(app) == 'photocraft':
            try:
                doc = c.call('engine.execute', {'command': 'document.inspect'}) or {}
            except CraftError as e:
                if 'no document' in str(e).lower():
                    return []  # 연 문서가 없다
                raise CraftError(f'could not read the open document / 연 문서를 못 읽음: {e}')  # 바쁨·시간 초과를 '저장할 것 없음'으로 넘기지 않는다
            if here_photo and isinstance(doc.get('history'), list) and len(doc['history']) <= 1:
                return []  # 연 뒤로 아무것도 안 했다
        else:
            # 다른 앱은 지금 문서 이름을 물을 길이 앱마다 달라 — 연 파일이 하나면 그 이름(돌려놓을 자리가 있으면 거기), 아니면 새 문서.
            # 둘 이상 열었으면 지금 문서가 어느 것인지 몰라 사람 파일 자리에 쓰지 않는다
            opened = st.get('opened') or list(st.get('sources') or {})  # 옛 상태 파일엔 opened 가 없다
            # 새 문서·문서 바꾸기 뒤면 지금 문서가 그 파일인지 모른다 — 사람 파일 자리 대신 새 파일로
            doc = {'name': opened[0]} if len(opened) == 1 and not status.get('docUnknown') else {}
        ours = {r.get('path') for r in recent(ddir) if r.get('saved')}  # 우리가 저장해 둔 자리 — 옆 PSD 는 다시 쓸 수 있다
        ext = spec.get('ext') or '.psd'
        plan = close_plan(doc, st.get('sources') or {}, st.get('saveDir'), work, ours, ext)
        for name, dest in plan:
            here = os.path.join(work, name)
            if os.path.abspath(dest) == os.path.abspath(here) and os.path.isfile(here):
                keep_copy(here)  # --work 가 사람 파일 폴더면 앱 저장이 그 파일을 바로 덮는다
            m, p = save_call(app, work, name)
            c.call(m, p)
    finally:
        c.close()
    out = []
    fresh = not (st.get('sources') or {}).get(doc.get('name') or '')
    for name, dest in plan:
        here = os.path.join(work, name)
        if fresh and os.path.isfile(here):
            # 앱이 되살린 지난 문서를 안 고치고 닫았다 — 우리가 써 둔 것과 같으면 한 벌 더 만들지 않는다(앱 저장이 작업 폴더에 바로 썼으면 그 사본만 지운다)
            base_ = os.path.join(os.path.dirname(dest), os.path.splitext(doc.get('name') or 'untitled')[0] + ext)
            olds = [base_] + [p for p in ours if p and os.path.dirname(p) == os.path.dirname(dest) and p.lower().endswith(ext.lower())]
            if any(os.path.abspath(o) != os.path.abspath(here) and same_file(here, o) for o in olds):
                if os.path.abspath(dest) == os.path.abspath(here):
                    os.remove(here)
                continue
        if os.path.abspath(dest) != os.path.abspath(here) and os.path.exists(here):
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            _copy_over(here, dest)
        if os.path.exists(dest):
            out.append(dest)
    # 사람이 연 원본은 우리가 쓴 게 아니다 — 옆 PSD·보관함 문서만 '우리 것'
    src = set((st.get('sources') or {}).values())
    add_recent(ddir, base(app), [p for p in out if p in src])
    add_recent(ddir, base(app), [p for p in out if p not in src], saved=True)
    return out


def close_native(ddir, app, st):
    """닫기 — 바뀐 게 있으면 저장하고, 저장이 실패해도 끄기는 끝까지(무인증 포트가 열린 채 남지 않게, 10/16 craft-smoke). 찍을 한 줄을 돌려준다"""
    note = ''
    try:
        saved = autosave(ddir, app, st)
        note = ' — saved / 저장: ' + ', '.join(saved) if saved else ''
    except (CraftError, OSError) as e:
        note = f' — could not save / 저장 못 함: {e}'
    window_line(ddir, 'close', app)
    stop_app(ddir, app, st)
    return f'{display(app)}: closed / 껐음{note}'

def eject_save(app, doc_name):
    """꺼내기 전에 저장할 자리(작업 폴더 기준) — 지금은 PhotoCraft 만(PSD 로 레이어째)"""
    app = base(app)
    if app != 'photocraft':
        return None
    return {'path': os.path.splitext(doc_name or 'untitled')[0] + '.psd'}


def craft_screen(ddir, wait=6, vd_wait=4):
    """Craft 전용 레티나 가짜 화면 자리 — 앱에 부탁(app.jsonl craft screen)하고 <데이터>/craft-native/screen.json 을 기다린다.
    앱이 없거나 옛 판이라 답이 없으면 세션 크롬의 1배 화면(read_vd) — 그것도 필요할 때만 뜨니(10/20) 없으면 부탁(vdisplay want)하고 vd_wait 초.
    끝내 없으면 None(보통 창)"""
    p = os.path.join(ddir, 'craft-native', 'screen.json')

    def live():
        j = _read_json(p)
        return tuple(float(v) for v in j['bounds'][:4]) if j.get('bounds') and pid_alive(j.get('pid')) else None
    if live():
        return live()
    window_line(ddir, 'screen', 'photocraft')
    end = time.time() + wait
    while time.time() < end:
        r = live()
        if r:
            return r
        time.sleep(0.1)
    if read_vd(ddir):
        return read_vd(ddir)
    _append_app_line(ddir, {'action': 'vdisplay', 'arg': {'verb': 'want'}})
    end = time.time() + vd_wait
    while time.time() < end:
        if read_vd(ddir):
            return read_vd(ddir)
        time.sleep(0.1)
    return None


def on_vd(rect, vd):
    """창(x, y, w, h)의 가운데가 가짜 화면 안인가"""
    x, y, w, h = rect
    cx, cy = x + w / 2, y + h / 2
    return vd[0] <= cx < vd[0] + vd[2] and vd[1] <= cy < vd[1] + vd[3]


def scale_order(learned, scales):
    """ui.ron 배율 시도 순서 — 지난번 맞은 것, 그다음 큰 배율부터(이 맥에선 2배가 맞았다)"""
    order = [learned] if learned else []
    return order + [s for s in sorted(set(scales), reverse=True) if s not in order]


JXA_SCREENS = 'ObjC.import("AppKit"); var a=$.NSScreen.screens, o=[]; for (var i=0;i<a.count;i++) o.push(a.objectAtIndex(i).backingScaleFactor); JSON.stringify(o)'
JXA_WINDOW = ('ObjC.import("CoreGraphics"); var a=ObjC.castRefToObject($.CGWindowListCopyWindowInfo(16, 0)), best=null;'
              'for (var i=0;i<a.count;i++){var w=a.objectAtIndex(i); if (w.objectForKey("kCGWindowOwnerPID").js!=__PID__ || w.objectForKey("kCGWindowLayer").js!=0) continue;'
              'var b=w.objectForKey("kCGWindowBounds"), r=[b.objectForKey("X").js,b.objectForKey("Y").js,b.objectForKey("Width").js,b.objectForKey("Height").js];'
              'if (!best || r[2]*r[3] > best[2]*best[3]) best=r} JSON.stringify(best)')
# 같은 창의 번호(screencapture -l) — 겹친 창 사이에서도 그 창만 찍는다
JXA_WINID = (JXA_WINDOW.replace('best=null;', 'best=null, id=null;').replace('best=r}', 'best=r, id=w.objectForKey("kCGWindowNumber").js}')
             .replace('JSON.stringify(best)', 'JSON.stringify(id)'))


def jxa(src):
    r = subprocess.run(['osascript', '-l', 'JavaScript', '-e', src], capture_output=True, text=True, timeout=10)
    return json.loads(r.stdout.strip() or 'null')


def pid_alive(pid):
    if IS_WIN:  # 윈도우 os.kill(pid, 0) 은 CTRL_C_EVENT 를 보낸다 — 살아 있나가 아니다
        return craft_win.os_.pid_alive(pid)
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def proc_exe(pid, run=subprocess.run):
    """맥: 그 pid 의 실행 파일(ps comm) — 못 읽으면 None"""
    try:
        r = run(['ps', '-o', 'comm=', '-p', str(int(pid))], capture_output=True, text=True, timeout=5)
    except (OSError, ValueError, TypeError, subprocess.TimeoutExpired):
        return None
    return (r.stdout or '').strip() or None


def inst_alive(st, exe_of=proc_exe):
    """그 상태 파일의 앱이 아직 떠 있나 — pid 가 살아 있고, 적어 둔 실행 파일(exe) 아래 프로세스일 때만. pid 만 보면 재부팅·번호 재사용 뒤
    남의 프로세스를 '이미 떠 있음'으로 보고 열기를 막거나 close 가 그 프로세스를 껐다(2026-10-21 리뷰). 실행 파일을 못 읽으면 예전처럼 산 걸로"""
    if not st or not pid_alive(st.get('pid')):
        return False
    want = st.get('exe')
    if IS_WIN or not want:
        return True
    got = exe_of(st['pid'])
    return got is None or os.path.realpath(got).startswith(os.path.realpath(want).rstrip('/') + '/')


def find_pid(marker, wait=15):
    """띄운 앱 pid — 인자에 든 표(--control <포트|파일>)로 찾는다"""
    for _ in range(wait * 4):
        r = subprocess.run(['pgrep', '-f', '--', marker], capture_output=True, text=True).stdout.split()
        if r:
            return int(r[0])
        time.sleep(0.25)
    return None


def key_alt(port, home=None):
    """WordCraft 0.7 은 설정 폴더 변수를 아직 안 읽어 키를 기본 설정 폴더에 쓴다"""
    return os.path.join(home or os.path.expanduser('~'), 'Library', 'Application Support', 'WordCraft', f'control-key.local-{port}')


def wait_channel(st, wait=20):
    """조작 채널이 열릴 때까지(키·control 파일은 앱이 포트를 잡은 뒤에 쓴다)"""
    last = None
    for _ in range(wait * 4):
        if st['auth'] == 'key' and not os.path.exists(st['secret']) and os.path.exists(key_alt(st['port'])):
            st['secret'] = key_alt(st['port'])
        try:
            c = Channel(st, timeout=5)
            c.close()
            return
        except CraftError as e:
            last = e
            time.sleep(0.25)
    raise CraftError(f'control channel did not open / 조작 채널이 안 열림: {last}')


def stop_app(ddir, app, st):
    """채널로 끄고, 안 꺼지면 SIGTERM — 무인증 포트가 남지 않게"""
    try:
        c = Channel(st, timeout=5)
        try:
            c.call(quit_method(app))
        except CraftError:
            pass
        c.close()
    except CraftError:
        pass
    ours = inst_alive(st)  # 번호가 남에게 넘어간 옛 기록이면 신호를 보내지 않는다(그 프로세스는 우리 앱이 아니다)
    for _ in range(20):
        if not ours or not pid_alive(st.get('pid')):
            break
        time.sleep(0.25)
    else:
        if IS_WIN:
            craft_win.os_.kill(st['pid'])
        else:
            with contextlib.suppress(OSError):
                os.kill(int(st['pid']), signal.SIGTERM)
            for _ in range(12):
                if not pid_alive(st.get('pid')):
                    break
                time.sleep(0.25)
            else:  # 저장 중·멈춘 앱이 SIGTERM 도 안 받으면 무인증 포트를 연 채 기록 없이 남았다
                with contextlib.suppress(OSError):
                    os.kill(int(st['pid']), signal.SIGKILL)
    drop_takeover(ddir, app)  # 앱이 꺼지면 개입도 끝 — 남으면 다시 띄운 앱에 참모 명령이 계속 막힌다
    drop_state(ddir, app)


def front_app(run=subprocess.run):
    """맨 앞 앱 (pid, 번들 자리) — lsappinfo 모양이 판마다 달라("pid"=1 · pid=1) 둘 다. 못 읽으면 (None, None)"""
    try:
        asn = run(['lsappinfo', 'front'], capture_output=True, text=True, timeout=3).stdout.strip()
        out = run(['lsappinfo', 'info', '-only', 'pid', '-only', 'bundlepath', asn], capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return None, None
    pid, path = re.search(r'pid"?\s*=\s*(\d+)', out, re.I), re.search(r'bundlepath"?\s*=\s*"([^"]*)"', out, re.I)
    return (int(pid.group(1)) if pid else None), (path.group(1) if path else None)


def raise_app(back):
    subprocess.run(['open', '-a', back[1]], capture_output=True, timeout=5)  # osascript activate 는 자동화 권한 창이 뜬다


def start_guard(app, secs=None):
    """뒤에서 사람 앞 앱을 지킨다 — 참모 앱이 스스로 앞으로 나와도(켜질 때·참모 벡터는 찍을 때마다) 바로 되돌림"""
    back = front_app()
    if back[1] and os.path.realpath(back[1]) != os.path.realpath(app_path(app)):
        subprocess.Popen([sys.executable, os.path.abspath(__file__), '_guard', app, json.dumps([list(back), app_path(app)], ensure_ascii=False)]
                         + ([str(secs)] if secs else []), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def focus_guard(ddir, app, back, bundle, front=front_app, raise_=raise_app, sleep=time.sleep, secs=20, step=0.05):
    """참모 앱은 뜨자마자 앞으로 나와 사람 타자를 가져간다 — winit 이 켜질 때 activateIgnoringOtherApps 를 부른다(LSUIElement·open -g 와 상관없이,
    10/20 시험 표 A1 에 사람 타자 'ㅎㅏㄴㅁ'). 띄우기 전 맨 앞 앱(back)을 secs 동안 지킨다 — 그 번들이 앞에 오면 바로 back 을 다시 앞으로.
    사람이 넘겨받으면(개입) 그만. 되돌린 횟수"""
    n, mine = 0, os.path.realpath(bundle)
    for _ in range(int(secs / step)):
        if _read_json(takeover_file(ddir, app)).get('on'):
            break
        _, path = front()
        if path and os.path.realpath(path) == mine:
            raise_(back)
            n += 1
        sleep(step)
    return n


def open_native_ctl(ddir, app, work=None, here=False, window=True):
    """맥 앱을 조작 채널과 함께 띄운다 — 가짜 화면이 있으면 거기(ui.ron 을 아는 앱), 상태는 <데이터>/craft-native/<인스턴스 키>.json.
    app 은 인스턴스 키 — 고르기·줄 서기는 open_for"""
    if IS_WIN:
        return craft_win.open_native_ctl(ddir, app, work, here, window)
    name = display(app)
    st = load_state(ddir, app)
    if inst_alive(st):
        print(f'{name}: already open / 이미 떠 있음 — work / 작업 폴더: {st.get("work")}')
        if window and not here:
            window_line(ddir, 'open', app)  # 다시 열면 다시 보이게(앱을 다시 켰거나 탭을 닫았을 때)
        return 0
    work = os.path.abspath(work or os.path.join(native_dir(ddir, app), 'work'))
    os.makedirs(work, exist_ok=True)
    vd = None if here else craft_screen(ddir)
    if not here and not vd:
        print(f'{name}: no hidden screen yet — opening as a normal window / 가짜 화면이 없어 보통 창으로 띄움(사람 화면에 보임)', file=sys.stderr)
    place = bool(vd)  # 다 가짜 화면으로 — ui.ron 을 읽는 앱(PhotoCraft 계열)은 미리 자리, 나머지는 띄운 뒤 System Events 로 옮긴다
    learned_file = os.path.join(ddir, 'craft-native', 'scale.json')
    try:
        with open(learned_file, encoding='utf-8') as f:
            learned = json.load(f).get('scale')
    except Exception:
        learned = None
    scales = scale_order(learned, jxa(JXA_SCREENS) or [1.0]) if place else [1.0]
    tried = []
    if not here:
        start_guard(app)
    for scale in scales:
        plan = launch_plan(ddir, app, free_port(), work, vd if place else None, scale)
        os.makedirs(plan['config'], exist_ok=True)
        if plan['uiron']:
            with open(plan['uiron'][0], 'w', encoding='utf-8') as f:
                f.write(plan['uiron'][1])
        if NATIVE[base(app)]['auth'] == 'token' and not os.path.exists(plan['secret']):
            fd = os.open(plan['secret'], os.O_WRONLY | os.O_CREAT, 0o600)
            os.write(fd, (os.urandom(32).hex() + '\n').encode())
            os.close(fd)
        if NATIVE[base(app)]['auth'] == 'file' and os.path.exists(plan['secret']):
            os.remove(plan['secret'])  # 옛 포트·토큰을 새것으로 읽지 않게
        if subprocess.run(plan['argv'], capture_output=True, env=child_env()).returncode != 0:
            # 안 깔림 → 처음 한 번 릴리스 DMG 를 받아(SHA·공증·번들 id 확인) /Applications 에, 그다음 다시 띄운다
            size = (release_info(ddir, base(app)) or {}).get('dmg_size')
            print(f'{name}: installing the macOS app / 맥 앱 설치 중(처음 한 번{", " + human(size) if size else ""})…', file=sys.stderr)
            with slot_lock(ddir, base(app) + '.update'):  # 두 세션이 같이 처음 열어도 한 번만 받는다(auto_update 와 같은 자물쇠)
                if not native_version(app_path(app)):  # 기다리는 동안 다른 세션이 깔았으면 받지 않는다
                    print(f'{name}: installed / 설치함 — {install_native(base(app), ddir=ddir)}', file=sys.stderr)
            if subprocess.run(plan['argv'], capture_output=True, env=child_env()).returncode != 0:
                return open_native(base(app))
        args = plan['argv'][plan['argv'].index('--args') + 1:]
        pid = find_pid('--control ' + args[args.index('--control') + 1])
        if not pid:
            raise CraftError(f'{name} did not start / 안 떴음')
        st = {'app': base(app), 'key': app, 'pid': pid, 'port': plan['port'], 'auth': NATIVE[base(app)]['auth'], 'secret': plan['secret'], 'work': work,
              'exe': os.path.join(app_path(app), 'Contents', 'MacOS'), 'here': bool(here)}  # exe: 앱이 끌 때 pid 가 그 앱인지 대조 · here: 사람 화면에 띄운 것
        try:
            wait_channel(st)
        except CraftError:
            os.kill(pid, signal.SIGTERM)  # 상태 파일 없이 포트가 열린 채 남지 않게
            raise
        if place:
            rect = None
            uiron = bool(NATIVE[base(app)]['uiron'])
            # 채널이 창보다 먼저 열릴 때가 있다 — 창이 생길 때까지(ui.ron 앱 3초, 나머지는 창이 8~10초 걸리기도 해서 15초)
            for _ in range(12 if uiron else 60):
                rect = jxa(JXA_WINDOW.replace('__PID__', str(pid)))
                if rect and rect[2] > 300:
                    break
                time.sleep(0.25)
            if not uiron:
                # ui.ron 을 안 읽는 앱 — 뜬 창을 바로 가짜 화면으로(사람 화면에 0.5~8초 보이는 건 아직 남는다, 10/16 실측)
                x, y = win_spot(vd, inst_no(app))[:2]
                if rect and not on_vd(rect, vd):
                    place_window(pid, x, y)
                    time.sleep(0.3)
                    rect = jxa(JXA_WINDOW.replace('__PID__', str(pid)))
                if not rect:
                    # 창이 아주 늦게 뜨는 앱(EffectCraft 첫 실행 GPU 준비 66초) — 끄지 않고 뒤에서 기다렸다 옮긴다
                    subprocess.Popen([sys.executable, os.path.abspath(__file__), '_place', str(pid), str(x), str(y)],
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                    rect = (x, y, 1, 1)
            if rect and NATIVE[base(app)].get('frame') and not on_vd(rect, vd):
                # 창 자리 명령이 있는 앱 — 짐작이 빗나갔으면 그 자리에서 옮긴다(다시 띄우지 않고)
                c = Channel(st)
                try:
                    c.call('ui.window.frame', frame_params(vd, inst_no(app)))
                except CraftError:
                    pass
                finally:
                    c.close()
                time.sleep(0.3)
                rect = jxa(JXA_WINDOW.replace('__PID__', str(pid)))
            tried.append((scale, rect))
            if not rect or (not on_vd(rect, vd) and uiron):
                jxa(f'ObjC.import("AppKit"); $.NSRunningApplication.runningApplicationWithProcessIdentifier({pid}).hide; 0')
                stop_app(ddir, app, st)
                continue
            if uiron:
                with open(learned_file, 'w', encoding='utf-8') as f:
                    json.dump({'scale': scale}, f)
        st['version'] = native_version(app_path(app)) or ''
        st['name'] = name  # 앱 창 머리줄 이름 — 갈아끼운 판이면 그 이름
        save_state(ddir, app, st)
        _write_json(status_file(ddir, app), {'last': '', 'dirty': False})
        where = 'agents screen / 가짜 화면' if place else 'normal window / 보통 창'
        print(f'{name}: open with control channel / 조작 채널로 띄움 ({where}) — work / 작업 폴더: {work}')
        if place and window:  # 가짜 화면에 띄웠으면 Chammo 따로 창에 비춘다
            window_line(ddir, 'open', app)
        if not NATIVE[base(app)]['auth']:
            print('this app\'s control port has no auth — scripts/craft close when done / 인증 없는 포트라 끝나면 close', file=sys.stderr)
        return 0
    raise CraftError(f'{name}: the window did not land on the agents screen / 창이 가짜 화면에 안 떴음 {tried} — try --here')


# 경로 이름표 — 작업 폴더 기준 상대 경로를 절대 경로로 바꿔 넘긴다(앱마다 상대 경로를 거부하거나 나중에 거부 창, 2026-10-19 VectorCraft)
PATH_KEYS = {'path', 'paths', 'out', 'output', 'outputpath', 'file', 'filepath', 'dest', 'destination', 'target', 'savepath', 'dir', 'folder'}


def abs_paths(params, work):
    """params 안 경로 이름표의 상대 경로 → work 기준 절대 경로, ~ 는 홈. 주소(://)·절대 경로는 그대로"""
    def fix(v):
        if not isinstance(v, str) or not v or '://' in v:
            return v
        if v.startswith('~'):
            return os.path.expanduser(v)
        return v if os.path.isabs(v) else os.path.join(work, v)

    def walk(x, key=''):
        if isinstance(x, dict):
            return {k: walk(v, k.lower()) for k, v in x.items()}
        if isinstance(x, list):
            return [walk(v, key) for v in x]
        return fix(x) if key in PATH_KEYS else x
    return walk(params)


# 한 Craft 에 참모 둘이 같이 붙지 않게 — do/run 을 부른 참모가 '쓰는 참모', 이만큼 쉬면 다른 참모가 넘겨받는다(2026-10-19 같은 VectorCraft 충돌)
LEASE_IDLE = 180


def lease_holder(st, me, now):
    """지금 이 앱을 쓰는 다른 참모(막아야 하면 그 세션 번호), 아니면 None. 참모 밖(me=None)은 막지 않는다"""
    lease = st.get('lease') or {}
    who = lease.get('by')
    if not me or not who or who == me or now - lease.get('at', 0) > LEASE_IDLE:
        return None
    return who


def lease_take(st, me, now):
    if me:
        st['lease'] = {'by': me, 'at': now}


def session_name(sid):
    """세션 번호 → 이름(claude agents --json), 못 찾으면 번호"""
    try:
        rows = json.loads(subprocess.run(['claude', 'agents', '--json'], capture_output=True, text=True, timeout=10).stdout or '[]')
        rows = rows if isinstance(rows, list) else rows.get('agents', [])
        return next((r.get('name') or sid for r in rows if str(r.get('id', '')).startswith(sid) or sid.startswith(str(r.get('id', '')) or '-')), sid)
    except (OSError, ValueError, subprocess.SubprocessError):
        return sid


def dialog_of(inspect):
    """ui.inspect 답에서 떠 있는 대화창(kind·fields), 없으면 None"""
    if not isinstance(inspect, dict):
        return None
    return (inspect.get('ui') or {}).get('dialog') or inspect.get('dialog') or None


# 대화창 닫기 — 앱마다 있는 메서드가 다르다(10/19: VectorCraft·GridCraft 등은 cancel, WordCraft·DeckCraft 는 close, FilmCraft·PdfCraft 등은 dialog.* 없음)
DIALOG_CLOSE = [('ui.dialog.cancel', None), ('ui.dialog.close', None), ('ui.dialog.dismiss', None), ('ui.dialog.confirm', 'message'), ('ui.key', {'key': 'Escape'})]


def close_dialog(call):
    """떠 있는 대화창을 닫는다 — 닫은 길 이름(없었으면 None). call(method, params) 는 채널 한 번. 확인(confirm)은 메시지 창(OK 하나)일 때만"""
    def look():
        try:
            return dialog_of(call('ui.inspect', None)), True
        except CraftError:
            return None, False
    d, can_look = look()
    if can_look and not d:
        return None
    for method, cond in DIALOG_CLOSE:
        if cond == 'message' and (d or {}).get('kind') != 'message':
            continue
        params = cond if isinstance(cond, dict) else None
        try:
            call(method, params)
        except CraftError:
            continue
        label = method + (' Escape' if params else '')
        if not can_look:
            return label
        time.sleep(0.2)
        if not look()[0]:
            return label
    raise CraftError('the dialog did not close / 대화창이 안 닫힘 — scripts/craft shot 으로 보고 ui.click 으로(참모 화면은 ui.mouse)')


def native_cmd(ddir, cmd, rest):
    """do|run|shot|close|status — 답은 JSON 그대로"""
    if cmd == 'status':
        for a in NATIVE:
            for k, st in live_instances(ddir, a):
                who = f'  by {session_name(st["by"])}' if st.get('by') else ''
                print(f'{display(k)} ({k})  pid {st["pid"]}  port {st.get("port") or "-"}  work {st.get("work")}{who}')
        return 0
    force = '--force' in rest
    rest = [r for r in rest if r != '--force']
    me = opener_id()
    base_app, chosen = inst_arg(rest[0])
    app = pick_instance(ddir, base_app, me, chosen)  # 이제부터 app = 인스턴스 키(첫 번째면 앱 이름 그대로)
    st = load_state(ddir, app)
    owner = st.get('by')
    if cmd in ('run', 'do', 'close', 'eject') and me and owner and owner != me and not force:
        who = session_name(owner)
        raise CraftError(f'{display(app)} belongs to {who} / {who} 세션 것 — 내 것은 scripts/craft open {base_app} --native 로 따로, 남의 창에 쓰려면 --force')
    if cmd == 'close':
        print(close_native(ddir, app, st))  # 묻지 않고 저장 후 닫기 — 저장이 실패해도 끈다
        return 0
    if cmd == 'save':
        # 끄지 않고 저장만(앱을 끌 때 사람 화면에 꺼내 둔 앱) — 바뀐 게 없으면 아무것도 안 한다
        saved = autosave(ddir, app, st)
        print(f'{display(app)}: ' + ('saved / 저장: ' + ', '.join(saved) if saved else 'nothing to save / 저장할 것 없음'))
        return 0
    if cmd == 'eject':
        return eject(ddir, app, st)
    if cmd == 'takeover':
        return takeover(ddir, app, st, rest[1] if len(rest) > 1 else '')
    if cmd == 'dialog':
        c = Channel(st)
        try:
            call = lambda m, q=None: c.call(m, q) if q is not None else c.call(m)
            if len(rest) > 1 and rest[1] == 'close':
                how = close_dialog(call)
                print(f'{display(app)}: ' + (f'closed / 닫음 ({how})' if how else 'no dialog / 대화창 없음'))
            else:
                print(json.dumps(dialog_of(call('ui.inspect')), ensure_ascii=False))
        finally:
            c.close()
        return 0
    if cmd in ('run', 'do') and len(rest) > 1:
        now = time.time()
        holder = lease_holder(st, me, now)
        if holder and not force:
            who = session_name(holder)
            raise CraftError(f'{who} is using {display(app)} / {who} 참모가 쓰는 중 — 덮어쓰려면 --force')
        lease_take(st, me, now)
        save_state(ddir, app, st)
        q = json.loads(rest[2]) if len(rest) > 2 else None
        check_takeover(ddir, app, *((rest[1], q) if cmd == 'do' else run_call(app, rest[1], q)))
    touch_used(ddir, app)
    c = Channel(st)
    try:
        if cmd == 'shot':
            work = os.path.abspath(st.get('work') or '.')
            out = rest[rest.index('--out') + 1] if '--out' in rest else os.path.join(work, 'chammo-shot.png')
            # 앱마다 답 모양이 달라(10/16) — 작업 폴더 안 절대 경로를 같이 넘기고, 바이트·경로·그 자리 파일 중 있는 것으로
            asked = os.path.join(work, '.chammo-shot.png')
            if os.path.exists(asked):
                os.remove(asked)
            params = dict(shot_params(app), **({} if base(app) == 'photocraft' else {'path': asked}))
            if not st.get('here'):
                start_guard(app, 5)  # 참모 벡터는 찍을 때마다 앞으로 나와 그대로 쥔다(10/21 QA)
            try:
                res = c.call('ui.screenshot', params)
            except CraftError:
                res = {}  # PdfCraft 처럼 못 찍는 앱 — 아래 화면 캡처로
            png = shot_file(res, asked)
            if png is None:
                # 창 번호로 — 같은 앱 여러 개가 가짜 화면에 겹쳐 있어도 그 창만(자리 -R 로 찍으면 위에 있는 남의 창이 찍힌다)
                wid = None if IS_WIN else jxa(JXA_WINID.replace('__PID__', str(st['pid'])))  # 윈도우 대비 화면 캡처는 아직 없음
                if wid and subprocess.run(['screencapture', '-x', '-o', '-l', str(int(wid)), out], capture_output=True).returncode == 0:
                    print(os.path.abspath(out))
                    return 0
                print(json.dumps(res, ensure_ascii=False))
                return 0
            with open(out, 'wb') as f:
                f.write(png)
            if os.path.exists(asked):
                os.remove(asked)
            print(os.path.abspath(out))
            return 0
        params = abs_paths(json.loads(rest[2]) if len(rest) > 2 else None, os.path.abspath(st.get('work') or '.'))
        method, p = (rest[1], params) if cmd == 'do' else run_call(app, rest[1], params)
        lng = hand_long(base(app), method, p)
        if lng:
            return run_long(ddir, app, st, c, method, p, lng)
        ask = lambda m, q=None: c.call(m, q)
        tgt = view_target(base(app), method, p)
        if tgt:  # 보기 먼저 — 사람이 그 자리로 가서 일하듯(필름 재생 위치·표 스크롤·포토 캔버스), 손은 옮긴 화면에서 자리를 찾는다
            save_view(ddir, app, view_move(base(app), tgt, ask, load_view(ddir, app)))
        pre, post = hand_plan(base(app), method, p)
        pre = hand_spot(base(app), method, p, pre, ask) if tgt else pre
        hand_line(ddir, app, pre)  # 참모 손: 누를 곳 → 명령 → 바뀐 곳(앱이 안 보는 중이면 그냥 넘긴다) — run 이든 do 든
        resp = c.call(method, p)
        print(json.dumps(resp, ensure_ascii=False), flush=True)  # 답 먼저 — 손 자리 묻기는 그 뒤라 명령을 안 늦춘다
        hand_line(ddir, app, hand_after(post, resp, lambda m, q=None: c.call(m, q) if q is not None else c.call(m)))
        note_call(ddir, app, method, p)
        if IS_WIN and not is_read(method, p):
            craft_win.pane_shot(ddir, app, st, c)  # 칸 그림 — 명령 직후 한 장(앱이 보는 중엔 1fps 이하로 더)
        return 0
    finally:
        c.close()


def run_long(ddir, app, st, c, method, p, lng):
    """긴 명령 — 손을 머물게 해 두고 보낸다. 답을 기다리는 동안(wait:true)은 여기서, 답 뒤 파일이 다 써질 때까지는 뒤에서(_hold) 이어 준다"""
    import threading
    names, doing, done, path = lng
    hid = hand_line(ddir, app, (names, doing), hold=HOLD_S)
    if ((p or {}).get('params') or {}).get('wait') is True:
        c.s.settimeout(3600)  # 끝날 때까지 답이 없다 — 70초면 craft: timeout(10/20 필름 현장 막힘 ③)
    stop = threading.Event()

    def keep():
        while not stop.wait(HOLD_EVERY) and hand_mark(ddir, app) == hid:
            hand_line(ddir, app, (names, doing), hold=HOLD_S, keep=True)
    threading.Thread(target=keep, daemon=True).start()
    try:
        resp = c.call(method, p)
    finally:
        stop.set()
    print(json.dumps(resp, ensure_ascii=False), flush=True)
    note_call(ddir, app, method, p)
    if path and hand_mark(ddir, app) == hid:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), '_hold', app, json.dumps([names, doing, done, path, hid, st.get('pid')], ensure_ascii=False)],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    elif hand_mark(ddir, app) == hid and ((p or {}).get('params') or {}).get('wait') is True:
        hand_line(ddir, app, (names, done))  # 기다려서 끝난 렌더 — 파일이 없으니 여기서 끝 글
    return 0


def takeover(ddir, app, st, onoff):
    """개입 켜기(지금 문서 상태를 떠 둔다)·끄기(다시 떠서 바뀐 것 한 줄을 찍는다 — 앱이 참모 입력칸으로 넘긴다)"""
    # 문서 상태는 읽을 수 있을 때만 — 문서를 안 열었거나 document.inspect 가 없는 앱(포토 말고)에서 여기서 멈추면 잠금이 안 걸려 스크립트가 계속 썼다(10/19 실측)
    c = Channel(st)
    try:
        doc = c.call('engine.execute', {'command': 'document.inspect'}) or {}
    except CraftError:
        doc = None
    finally:
        c.close()
    if onoff == 'on':
        save_takeover(ddir, app, {'on': True, 'before': doc, 'at': time.strftime('%H:%M:%S')})
        print(f'{display(app)}: a person has control / 사람이 조작 중')
        return 0
    lock = _read_json(takeover_file(ddir, app))
    before = lock.get('before')
    drop_takeover(ddir, app)
    if before is None or doc is None or change_summary(before, doc) != '바뀐 것 없음':
        _write_json(status_file(ddir, app), {'last': 'person / 사람이 고침', 'dirty': True})  # 닫을 때 저장되게(못 읽었으면 바뀐 걸로)
    shot = os.path.join(os.path.abspath(st.get('work') or '.'), 'chammo-handback.png')
    try:
        with contextlib.redirect_stdout(io.StringIO()):
            native_cmd(ddir, 'shot', [inst_name(app), '--out', shot])
    except Exception:
        pass
    shot = shot if os.path.exists(shot) else None
    if before is None or doc is None:  # 이 앱(또는 이때)은 문서 상태를 못 읽음 — 바뀐 게 없다고 하지 않고 화면으로
        print('바뀐 것은 문서 상태로 못 읽음 — 화면으로 확인' + (f' · 화면 {shot}' if shot else ''))
    else:
        print(handback_text(before, doc, shot))
    return 0


def handback_text(before, after, shot):
    """돌려받음 한 줄 — 사람이 바꾼 것 + 지금 문서 상태(이름·레이어 수·찍은 화면). 세션이 이걸 보고 상황을 파악한 뒤 사람 지시를 기다린다(2026-10-19)"""
    now = []
    if after.get('name'):
        now.append(f"'{after['name']}'")
    if isinstance(after.get('layers'), list):
        now.append(f"레이어 {len(after['layers'])}개")
    if shot:
        now.append(f'화면 {shot}')
    line = change_summary(before, after) + (f" · 지금 문서 {' · '.join(now)}" if now else '')
    return ' '.join(line.split())


def eject(ddir, app, st):
    """꺼내기 — 지금 문서를 작업 폴더에 저장하고, 앱을 끈 뒤 사람 화면(--here)에 다시 열어 그 파일을 연다. 따로 창은 닫는다"""
    c = Channel(st)
    try:
        doc = c.call('engine.execute', {'command': 'document.inspect'}) or {}
        save = eject_save(app, doc.get('name', ''))
        if save is None:
            raise CraftError(f'{display(app)}: pop out is PhotoCraft-only for now / 꺼내기는 아직 PhotoCraft 만')
        c.call('app.save', save)
    finally:
        c.close()
    window_line(ddir, 'close', app)
    stop_app(ddir, app, st)
    open_native_ctl(ddir, app, st.get('work'), here=True, window=False)
    new = load_state(ddir, app) or {}
    # 저장 자리(보관함)·주인은 그대로 — 새 상태엔 없어서 닫을 때 작업 폴더에만 남고 주인 없는 앱이 됐다
    for k in ('saveDir', 'by'):
        if st.get(k) and not new.get(k):
            new[k] = st[k]
    save_state(ddir, app, new)
    c = Channel(new)
    try:
        c.call('app.open', save)
    finally:
        c.close()
    print(f'{display(app)}: popped out / 꺼냄 — {os.path.join(st.get("work") or "", save["path"])}')
    return 0


def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__, file=sys.stderr)
        return 2
    cmd, rest = argv[0], argv[1:]
    if cmd == '_serve':
        serve_main(*rest)
        return 0
    if cmd == '_place':
        # 뒤에서 — 창이 생기면(최대 120초) 가짜 화면으로 옮기고 끝
        pid, x, y = int(rest[0]), rest[1], rest[2]
        for _ in range(240):
            if not pid_alive(pid):
                return 0
            r = jxa(JXA_WINDOW.replace('__PID__', str(pid)))
            if r and r[2] > 300:
                place_window(pid, float(x), float(y))
                return 0
            time.sleep(0.5)
        return 0
    ddir = data_dir()
    if cmd == '_guard':
        back, bundle = json.loads(rest[1])
        focus_guard(ddir, rest[0], tuple(back), bundle, **({'secs': float(rest[2])} if len(rest) > 2 else {}))
        return 0
    if cmd == '_hold':
        # 뒤에서 — 내보낸 파일이 다 써질 때까지 참모 손을 머물게 이어 준다(run_long)
        names, doing, done, path, hid, pid = json.loads(rest[1])
        hold_watch(ddir, rest[0], names, doing, done, path, hid, pid)
        return 0
    global NATIVE, LOCAL
    NATIVE, LOCAL = chammo_table(NATIVE, local_config(ddir))  # 로컬 DMG 가 있는 앱만 참모 앱으로
    root = os.path.join(ddir, 'craft')
    os.makedirs(root, exist_ok=True)
    try:
        if cmd == 'list':
            if '--json' in rest:  # 앱 서랍이 읽는 길(--refresh = 새 판 다시 확인, --fast = 네트워크 없이 먼저)
                print(json.dumps(drawer_rows(ddir, root, refresh='--refresh' in rest, fast='--fast' in rest), ensure_ascii=False))
            else:
                print(listing(root, ddir))
        elif cmd == 'open' and rest:
            app, chosen = inst_arg(rest[0])
            if '--native' in rest:
                if sys.platform != 'darwin' and not IS_WIN:
                    return open_native(app)
                if IS_WIN and not craft_win.supported(app):
                    raise craft_win.not_yet(app)  # 자리를 잡기 전에 — 윈도우판이 없는 앱은 줄도 안 선다
                work = rest[rest.index('--work') + 1] if '--work' in rest else None
                wait = float(rest[rest.index('--wait') + 1]) if '--wait' in rest else WAIT_MAX
                f = open_file_arg(rest)
                app, claimed = open_slot(ddir, app, opener_id(), chosen, wait)  # 이제부터 app = 인스턴스 키
                try:
                    auto_update(ddir, app)  # 우리가 깐 앱이 꺼져 있고 릴리스가 더 새것이면 먼저 바꾼다(실패하면 옛 판 그대로)
                    rc = open_native_ctl(ddir, app, work, '--here' in rest)
                finally:
                    if claimed:
                        unclaim(ddir, app)
                if rc:
                    return rc
                st = load_state(ddir, app)
                if not st.get('saveDir'):
                    st['saveDir'] = locker_craft_dir()  # 새 문서 저장 자리 — 띄운 참모의 보관함(창 단추로 닫을 땐 참모가 없어 지금 정해 둔다)
                    save_state(ddir, app, st)
                by = opener_for(st, opener_id())
                if by and st.get('by') != by:
                    st['by'] = by  # 돌려받음 [앱] 줄을 받을 참모 — 대표 참모가 아니라 이 앱을 처음 연 참모(10/16 실사용: 회사 비서로 갔다)
                    save_state(ddir, app, st)
                if f:
                    open_file(ddir, app, f)
                return 0
            touch_used(ddir, app)
            if not installed(root, app):
                print(f'{APPS[app][0]}: downloading the web build / 웹판 받는 중…', file=sys.stderr)
            ver, _ = ensure(root, app)
            port = start_server(ddir, root)
            url = f'http://127.0.0.1:{port}/{app}/{ver}/'
            print(f'{APPS[app][0]} {ver} — {url}')  # 웹판은 ArtCraft 원본 — 원래 이름으로
            print('no autosave in the web build — save before closing / 웹판은 자동 저장 없음, 닫기 전에 저장', file=sys.stderr)
            show = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'show')
            return subprocess.run([sys.executable, show, url]).returncode
        elif cmd == 'prefetch':
            if '--status' in rest:
                print(json.dumps(prefetch_state(ddir), ensure_ascii=False))
                return 0
            st = prefetch(ddir, reset='--reset' in rest)
            print(json.dumps(st, ensure_ascii=False))
            return 0
        elif cmd == 'install' and rest:
            app = app_key(base(rest[0]))
            if IS_WIN and not craft_win.supported(app):
                raise craft_win.not_yet(app)
            r = install_only(ddir, app)
            print(f'{display(app)}: installed / 깔았음 (not opened / 띄우지 않음)' if r == 'installed' else f'{display(app)}: already installed / 이미 깔림')
            return 0
        elif cmd == 'recent':
            for r in recent(ddir):
                if not rest or r.get('app') == app_key(rest[0]):
                    print(f"{r.get('at', '')}  {display(r['app']) if r.get('app') in APPS else r.get('app')}  {r['path']}{'' if os.path.exists(r['path']) else '  (gone / 없음)'}")
            return 0
        elif cmd == 'update':
            apps = [app_key(rest[0])] if rest else [k for k in APPS if installed(root, k)]
            for a in apps:
                old, new = update(root, a)
                print(f'{display(a)}: {old or "-"} → {new}' if old != new else f'{display(a)}: {new} (latest / 최신)')
            # 맥 앱 — 내가 /Applications 에 깐 것만 같은 길(DMG·SHA·공증)로
            for a in ([app_key(rest[0])] if rest else list(APPS)) if sys.platform == 'darwin' else []:
                if native_version(app_path(a)):
                    old, new = update_native(a, ddir=ddir)
                    print(f'{display(a)} (macOS app / 맥 앱): {old} → {new}' if old != new else f'{display(a)} (macOS app / 맥 앱): {new} (latest / 최신)')
        elif cmd == 'remove' and rest:
            app = app_key(rest[0])
            gone = remove_app(ddir, app)
            for g in gone:
                print(f'→ Trash / 휴지통: {g}')
            print(f'{display(app)}: removed / 지웠음' if gone else f'{display(app)}: nothing of ours to remove / 우리가 깐 게 없음')
        elif cmd == 'cli' and rest:
            if IS_WIN:
                raise CraftError('cli: not on Windows yet / 윈도우 cli 는 다음 판 — open <app> --native 로')
            exe = ensure_cli(root, rest[0])
            hint = cli_hint(rest)
            if hint:
                print(hint, file=sys.stderr)
            os.execv(exe, [exe] + rest[1:])
        elif cmd in ('do', 'run') and len(rest) >= 2 or cmd in ('shot', 'close', 'save', 'eject', 'takeover', 'dialog') and rest or cmd == 'status':
            return native_cmd(ddir, cmd, rest)
        elif cmd == 'stop':
            print('stopped / 껐음' if stop_server(ddir, root) else 'not running / 안 떠 있음')
        else:
            print(__doc__, file=sys.stderr)
            return 2
    except TakeoverError as e:
        print(f'craft: {e}', file=sys.stderr)
        return 4
    except CraftError as e:
        print(f'craft: {e}', file=sys.stderr)
        return 1
    return 0


craft_win.bind(globals())


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
