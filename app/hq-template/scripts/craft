#!/bin/sh
''':'
# sh 로 읽으면 맞는 파이썬을 골라 다시 실행한다 — 윈도우의 python3 는 스토어 대리 실행기(종료 49)라 py -3 → python 중 도는 것
[ "$OS" = Windows_NT ] || exec python3 "$0" "$@"
for p in "py -3" python; do $p -c '' >/dev/null 2>&1 && exec $p "$0" "$@"; done
echo "python not found — install Python 3 (winget install Python.Python.3.12)" >&2; exit 127
':'''
__doc__ = """Open the open-source Craft apps (ArtCraft, github.com/storytold) inside the app, unchanged.
Craft 앱(ArtCraft 오픈소스)을 고치지 않은 원본 그대로 앱 안에서 연다.

  scripts/craft list [--json [--refresh]]  — apps, the version you have / 앱 목록과 받은 판 (--json: 앱 서랍이 읽는 모양)
  scripts/craft open <app>           — first time: download the web build, then show it in the space / 처음엔 받아서 스페이스에
  scripts/craft open <app> --native [--work <dir>] [--here]
                                     — the macOS app with its control channel, on the agents screen when it can (--here: a normal
                                       window). Not installed → the first time it downloads the release DMG, checks SHA256SUMS,
                                       the bundle id and Apple notarization, and installs it to /Applications (any mismatch: nothing
                                       installed) / 맥 앱을 조작 채널과 함께 — 없으면 처음 한 번 DMG 를 맞춰 보고 설치
                                     An app Chammo installed that is not running is updated first when the release has a newer
                                       version (same checks; release checked every 6 h; offline or a failed check → the old version
                                       opens, one line) / 우리가 깐 앱이 꺼져 있고 새 판이 있으면 열기 전에 바꾼다(못 받으면 옛 판)
  scripts/craft run <app> <command id> ['<json params>']  — one app command (menu item), reply as JSON / 앱 명령 하나
  scripts/craft do <app> <method> ['<json>']              — a raw control-channel call (app.open, ui.inspect …) / 채널 명령 그대로
  scripts/craft shot <app> [--out <png>]  ·  close <app>  ·  status   — window picture / save if changed, then quit (closes the port) / what's open
  scripts/craft open <app> --native <file>  — open a file of the person's; on close it is saved back there (+ a layered .psd beside it)
                                     / 사람 파일 열기 — 닫을 때 그 자리에 저장(+ 옆에 레이어 살린 PSD)
  scripts/craft save <app>             — save if changed, keep the app open / 끄지 않고 저장만
  scripts/craft dialog <app> [close]   — the open dialog (kind, text) / close it whatever the app calls it / 떠 있는 대화창 보기·닫기(앱마다 다른 메서드를 알아서)
  macOS apps are the Chammo builds (참모 ○○, ArtCraft rebuilt) from one release of the Chammo GitHub repo, tag crafts-<date>
               (13 DMGs + SHA256SUMS.txt). Testing your own DMGs: {"root": "<release folder>"} in <data folder>/craft-native/local-releases.json
               wins for apps with a DMG there (checksum·bundle id·notarization checked as usual) / 맥 앱은 참모 앱 공개 릴리스에서, 내 DMG 폴더가 있으면 그게 먼저
  scripts/craft install <app>          — install the macOS app only (same checks as open --native), don't open it — the drawer's Get
                                     / 깔기만 하고 띄우지 않는다(서랍 '받기')
  scripts/craft prefetch [--status|--reset]  — install the basic five (Grid, PDF, Deck, Word, Vector) that are missing, one by one, same checks;
                                     skipped under 5 GB free or when Settings > Features turns it off; one the person removed stays
                                     removed until reinstalled or --reset (the switch turned back on). The app runs it after setup
                                     / 기본 다섯(표·PDF·슬라이드·문서·벡터) 중 없는 것을 차례로 — 앱이 첫 설정 뒤 뒤에서 돌린다
  scripts/craft recent [<app>]         — recently saved/opened Craft documents / 최근 Craft 문서
  scripts/craft takeover <app> on|off  — (the app's Take over / Hand back) on: commands pause; off: prints what the person changed
                                     / 개입 켜기·끄기 — 끄면 사람이 바꾼 것 한 줄
  scripts/craft eject <app>          — pop out: save (PSD), quit, reopen on your screen with the file / 꺼내기 — 저장 후 내 화면에 다시 열기
  scripts/craft cli <app> [args…]   — the windowless engine (<app>-cli: convert, run, batch, commands --filter, mcp) /
                                     창 없는 엔진 — 일괄 처리·명령 찾기. First time: downloads the release CLI zip (SHA256SUMS)
                                     Nobody sees it — to make or edit something the person should watch, use open <app> --native / 사람이 못 봄 — 만들고 고치는 일은 open --native
  scripts/craft update [<app>]       — newer release → download it, drop the old one; macOS apps it installed too / 새 판 받기(맥 앱도)
  scripts/craft remove <app>         — to the Trash: downloaded web build/CLI, the macOS app if Chammo installed it (yours stays), its
                                     settings and work folder / 받은 것·우리가 깐 맥 앱·설정·작업 폴더를 휴지통으로
  scripts/craft stop                 — stop the local server / 로컬 서버 끄기

<app> = photocraft, photo, PhotoCraft … (any case, 'craft' optional).
The web build (a static WebAssembly site) comes from the app's latest GitHub release and must match the release's
SHA256SUMS.txt, or it is thrown away. It lives in <data folder>/craft/<app>/<version>/ with the repo's LICENSE-MIT,
LICENSE-APACHE and NOTICE beside it, and is served on 127.0.0.1 only. The space opens it through the address preview,
which can't call the app or read your files (only the browser's own open/save dialogs).
The web build has no autosave — save or download before closing.
"""
import contextlib, hashlib, http.server, io, json, os, re, shutil, signal, socket, subprocess, sys, tempfile, time, urllib.error, urllib.request, zipfile
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import craft_win  # 윈도우 길(설치·띄우기·지우기 — 참모 앱 portable zip). 맥 길은 이 파일 그대로
IS_WIN = sys.platform == 'win32'

OWNER = 'storytold'
# 저장소 이름 → (보이는 이름, 하는 일). 맥 앱 이름·번들 id·자리는 아래 NATIVE 표(갈아끼울 땐 거기만)
APPS = {
    'photocraft': ('PhotoCraft', 'photo editing / 사진 편집'),
    'lightcraft': ('LightCraft', 'photo library, raw / 사진 보관·RAW 현상'),
    'filmcraft': ('FilmCraft', 'video editing / 영상 편집'),
    'effectcraft': ('EffectCraft', 'motion graphics / 모션그래픽·합성'),
    'vectorcraft': ('VectorCraft', 'vector art / 벡터 그림'),
    'designcraft': ('DesignCraft', 'page layout / 지면·레이아웃'),
    'pdfcraft': ('PdfCraft', 'PDF / PDF 읽기·편집'),
    'wordcraft': ('WordCraft', 'documents / 문서'),
    'gridcraft': ('GridCraft', 'spreadsheets / 표 계산'),
    'deckcraft': ('DeckCraft', 'slides / 발표 자료'),
    'figcraft': ('FigCraft', 'interface design / 화면 설계'),
    'cadcraft': ('CADCraft', 'CAD / 캐드'),
    'soundcraft': ('SoundCraft', 'audio / 오디오 편집'),
}
NOTICES = ('LICENSE-MIT', 'LICENSE-APACHE', 'NOTICE')
APPS_DIR = os.environ.get('CHAMMO_CRAFT_APPS_DIR') or '/Applications'  # 맥 앱을 까는 자리(시험은 CHAMMO_CRAFT_APPS_DIR 로 따로)
LICENSE_LINE = ('open source · MIT OR Apache-2.0 — ArtCraft (github.com/storytold), unchanged. '
                'The ArtCraft name and logos are ArtCraft Team trademarks. / 오픈소스 · MIT OR Apache-2.0, 원본 그대로')
# 서버 응답에 붙이는 표 — 떠 있는 서버가 이 데이터 폴더 것인지 본다
MARK = 'X-Chammo-Craft'


class CraftError(Exception):
    pass


class TakeoverError(CraftError):
    """사람이 개입해 쓰기 명령을 막음 — 종료 코드 4(다른 실패 1 과 갈라 돌던 스크립트가 알아본다)"""


class FetchError(CraftError):
    pass


class BusyError(CraftError):
    """앱이 떠 있어서 못 바꿈 — 저절로 새 판(auto_update)은 이걸 실패로 치지 않는다(끄고 다시 열면 바뀐다)"""


def data_dir(home=None, env=None, exists=os.path.isdir):
    """데이터 폴더 — 앱(config.rs)·scripts/show 와 같은 규칙: $CHAMMO_HOME → ~/.chammo → 단 ~/.chammo 가 없고 ~/.honor-orchestrator 가 있으면 그것"""
    home = home or os.path.expanduser('~')
    env = os.environ.get('CHAMMO_HOME', '') if env is None else env
    if env.strip():
        return os.path.expanduser(env.strip())
    new, old = os.path.join(home, '.chammo'), os.path.join(home, '.honor-orchestrator')
    return old if not exists(new) and exists(old) else new


def fetch(url, timeout=120):
    """주소 → 바이트(리다이렉트 따라감). 실패는 FetchError. 절대 경로면 그 파일(CHAMMO_CRAFT_LOCAL 릴리스)"""
    if os.path.isabs(url):
        try:
            with open(url, 'rb') as f:
                return f.read()
        except OSError as e:
            raise FetchError(f'{url} — {e}') from e
    req = urllib.request.Request(url, headers={'User-Agent': 'Chammo-craft', 'Accept': '*/*'})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.read()
    except (urllib.error.URLError, OSError) as e:
        raise FetchError(f'{url} — {e}') from e


def app_key(name):
    """'PhotoCraft'·'photo'·'photocraft' → 'photocraft'. 모르는 이름은 CraftError"""
    k = (name or '').strip().lower()
    k = k if k.endswith('craft') else k + 'craft'
    if k not in APPS:
        raise CraftError(f'unknown app / 모르는 앱: {name} — {", ".join(APPS)}')
    return k


# 같은 앱을 세션마다 따로(2026-10-20) — 인스턴스 키: 첫 번째는 앱 이름 그대로(세션 하나면 지금과 같은 파일·창), 2·3번째는 '<앱>-2'·'<앱>-3'
MAX_INSTANCES = 3


def inst_key(app, n):
    return app if n == 1 else f'{app}-{n}'


def inst_no(key):
    m = re.fullmatch(r'(.+)-(\d+)', key or '')
    return int(m[2]) if m and m[1] in APPS else 1


def base(key):
    """인스턴스 키 → 앱('photocraft-2' → 'photocraft')"""
    m = re.fullmatch(r'(.+)-(\d+)', key or '')
    return m[1] if m and m[1] in APPS else key


def inst_name(key):
    """인스턴스 키 → 그 인스턴스만 가리키는 인자(첫 번째는 '<앱>-1' — 이름만이면 '내 것'이라)"""
    return key if inst_no(key) > 1 else f'{key}-1'


def inst_arg(name):
    """명령 인자 → (앱, 고른 인스턴스 또는 None). 이름만이면 '내 것'(None), '-N' 이 붙으면 그 인스턴스(-1 = 첫 번째)"""
    m = re.fullmatch(r'(.+)-(\d+)', (name or '').strip().lower())
    if not m:
        return app_key(name), None
    app, n = app_key(m[1]), int(m[2])
    if not 1 <= n <= MAX_INSTANCES:
        raise CraftError(f'{name}: up to {MAX_INSTANCES} per app / 한 앱에 {MAX_INSTANCES}개까지')
    return app, inst_key(app, n)


def ver_key(v):
    return tuple(int(x) if x.isdigit() else 0 for x in re.split(r'[.\-+]', v))


def parse_sums(text):
    """SHA256SUMS.txt → {파일 이름: 해시}"""
    out = {}
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 2:
            out[parts[-1].lstrip('*')] = parts[0].lower()
    return out


def local_release(folder):
    """CHAMMO_CRAFT_LOCAL=<폴더> — 공개 저장소 전, 우리가 빌드한 DMG 와 SHA256SUMS.txt 가 든 폴더를 릴리스처럼(설치 확인은 그대로)"""
    names = os.listdir(folder)
    dmgs = [n for n in names if re.search(r'-\d+\.\d+\.\d+-macos-universal\.dmg$', n) and '-cli-' not in n]
    if len(dmgs) != 1 or 'SHA256SUMS.txt' not in names:
        raise CraftError(f'CHAMMO_CRAFT_LOCAL: need one *-<ver>-macos-universal.dmg and SHA256SUMS.txt / DMG 하나와 체크섬 파일이 있어야 함 ({folder})')
    ver = re.search(r'-(\d+\.\d+\.\d+)-macos-universal\.dmg$', dmgs[0]).group(1)
    return ver, os.path.join(folder, dmgs[0]), os.path.join(folder, 'SHA256SUMS.txt')


def latest(app, get=fetch, native=False):
    """최신 릴리스에서 판·웹판 zip·체크섬·맥 DMG 주소 — 맥 전용 릴리스(웹판 없음)면 zip 은 None.
    native=True(맥 앱 설치·업데이트)만 앱 표의 저장소·CHAMMO_CRAFT_LOCAL 을 본다 — 웹판·CLI 는 늘 ArtCraft 원본에서"""
    app = app_key(app)
    if native and IS_WIN:
        return craft_win.latest(app, get)
    if native and app in LOCAL:
        return local_latest(app, LOCAL[app])
    local = os.environ.get('CHAMMO_CRAFT_LOCAL', '').strip() if native else ''
    row = (NATIVE.get(app) or {}) if native else {}
    if local:
        ver, dmg, sums = local_release(local)
        return {'app': app, 'tag': 'v' + ver, 'ver': ver, 'zip': None, 'zip_name': None, 'sums': sums, 'dmg': dmg, 'cli': None, 'cli_name': None}
    if native and bundle_id(app).startswith('app.chammo.') and app in CHAMMO:
        return crafts_latest(app, get)
    if row.get('bundle') and not row.get('repo'):
        # 갈아끼운 판인데 받을 저장소가 아직 없다 — 원본(ArtCraft) 저장소로 가면 번들 id 가 달라 어차피 안 깔린다
        raise CraftError(f'{display(app)}: no public release yet / 아직 공개 릴리스 없음 — CHAMMO_CRAFT_LOCAL=<DMG folder / DMG 폴더>')
    rel = json.loads(get(f'https://api.github.com/repos/{repo_of(app) if native else OWNER + "/" + app}/releases/latest'))
    tag = rel['tag_name']
    ver = tag.lstrip('v')
    urls = {a['name']: a['browser_download_url'] for a in rel.get('assets', [])}
    sizes = {a['name']: a.get('size') for a in rel.get('assets', [])}
    if 'SHA256SUMS.txt' not in urls:
        raise CraftError(f'{app} {tag}: no SHA256SUMS.txt in the release / 릴리스에 체크섬 파일이 없음')
    zname = f'{app}-web-{ver}.zip'
    dname = next((n for n in urls if n.endswith('-macos-universal.dmg') and '-cli-' not in n), None)
    dmg = urls.get(dname) if dname else None
    cname = f'{app}-cli-{ver}-macos-universal.zip'
    return {'app': app, 'tag': tag, 'ver': ver, 'zip': urls.get(zname), 'zip_name': zname, 'sums': urls['SHA256SUMS.txt'], 'dmg': dmg,
            'dmg_size': sizes.get(dname) if dname else None, 'cli': urls.get(cname), 'cli_name': cname}


def installed(root, app):
    """받아 둔 판(작은 것부터) — index.html 이 있는 폴더만, 받다 만 .tmp-* 는 빼고"""
    d = os.path.join(root, app)
    if not os.path.isdir(d):
        return []
    vs = [v for v in os.listdir(d) if not v.startswith('.') and os.path.isfile(os.path.join(d, v, 'index.html'))]
    return sorted(vs, key=ver_key)


def safe_extract(zbytes, dest):
    """zip 을 dest 에 푼다 — dest 밖으로 나가는 이름(../·절대 경로)이 하나라도 있으면 아무것도 안 풀고 거절"""
    import io
    dest = os.path.realpath(dest)
    with zipfile.ZipFile(io.BytesIO(zbytes)) as z:
        for n in z.namelist():
            t = os.path.realpath(os.path.join(dest, n))
            if os.path.isabs(n) or not (t == dest or t.startswith(dest + os.sep)):
                raise CraftError(f'unsafe path in zip / zip 안 경로가 밖으로 나감: {n}')
        z.extractall(dest)


def site_root(d):
    """index.html 이 있는 곳 — zip 맨 위 폴더 하나는 벗긴다"""
    if os.path.isfile(os.path.join(d, 'index.html')):
        return d
    subs = [os.path.join(d, x) for x in os.listdir(d) if os.path.isdir(os.path.join(d, x))]
    if len(subs) == 1 and os.path.isfile(os.path.join(subs[0], 'index.html')):
        return subs[0]
    raise CraftError('no index.html in the web build / 웹판에 index.html 이 없음')


def install(root, rel, get=fetch):
    """웹판을 받아 SHA-256 을 맞춰 보고 <root>/<앱>/<판>/ 에 푼다. 안 맞으면 아무것도 안 남기고 CraftError"""
    app, ver = rel['app'], rel['ver']
    if not rel.get('zip'):
        raise CraftError(f'{display(app)} {rel["tag"]}: no web build / 웹판이 없는 앱 — scripts/craft open {app} --native')
    zbytes = get(rel['zip'])
    want = parse_sums(get(rel['sums']).decode('utf-8', 'replace')).get(rel['zip_name'])
    if not want:
        raise CraftError(f'{rel["zip_name"]} is not in SHA256SUMS.txt / 체크섬 목록에 없음 — not installed')
    got = hashlib.sha256(zbytes).hexdigest()
    if got != want:
        raise CraftError(f'SHA-256 mismatch / 체크섬이 안 맞음 ({rel["zip_name"]}: {got[:12]}… ≠ {want[:12]}…) — thrown away')
    appdir = os.path.join(root, app)
    os.makedirs(appdir, exist_ok=True)
    tmp = tempfile.mkdtemp(prefix='.tmp-', dir=appdir)
    try:
        safe_extract(zbytes, tmp)
        site = site_root(tmp)
        raw = f'https://raw.githubusercontent.com/{OWNER}/{app}/{rel["tag"]}/'
        for f in NOTICES:  # 저장소의 원본 고지 — 웹판 zip 엔 NOTICE 가 없다
            try:
                with open(os.path.join(site, f), 'wb') as out:
                    out.write(get(raw + f))
            except FetchError:
                pass
        final = os.path.join(appdir, ver)
        if not os.path.isdir(final):
            os.rename(site, final)
        return final
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def ensure_cli(root, app, get=fetch):
    """창 없는 엔진(<앱>-cli) — 받아 둔 게 있으면 그것, 없으면 최신 릴리스 CLI zip 을 SHA256SUMS 로 맞춰 <root>/<앱>/cli/<판>/ 에"""
    app = app_key(app)
    d = os.path.join(root, app, 'cli')
    exe = f'{app}-cli'
    have = sorted((v for v in os.listdir(d) if not v.startswith('.') and os.path.isfile(os.path.join(d, v, exe))), key=ver_key) if os.path.isdir(d) else []
    if have:
        return os.path.join(d, have[-1], exe)
    rel = latest(app, get)
    if not rel.get('cli'):
        raise CraftError(f'{app} {rel["tag"]}: no macOS CLI in the release / 릴리스에 맥 CLI 가 없음')
    zbytes = get(rel['cli'])
    want = parse_sums(get(rel['sums']).decode('utf-8', 'replace')).get(rel['cli_name'])
    if not want or hashlib.sha256(zbytes).hexdigest() != want:
        raise CraftError(f'SHA-256 mismatch or missing / 체크섬이 안 맞거나 없음 ({rel["cli_name"]}) — thrown away')
    os.makedirs(d, exist_ok=True)
    tmp = tempfile.mkdtemp(prefix='.tmp-', dir=d)
    try:
        safe_extract(zbytes, tmp)
        top = tmp if os.path.isfile(os.path.join(tmp, exe)) else next(
            (os.path.join(tmp, x) for x in os.listdir(tmp) if os.path.isfile(os.path.join(tmp, x, exe))), None)
        if not top:
            raise CraftError(f'no {exe} in the CLI zip / CLI zip 에 {exe} 가 없음')
        os.chmod(os.path.join(top, exe), 0o755)  # zip 은 실행 권한을 안 실어 온다
        os.rename(top, os.path.join(d, rel['ver']))
        return os.path.join(d, rel['ver'], exe)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def ensure(root, app, get=fetch):
    """(판, 폴더) — 받아 둔 게 있으면 그 중 최신(네트워크 안 씀), 없으면 최신 릴리스를 받는다"""
    app = app_key(app)
    have = installed(root, app)
    if have:
        return have[-1], os.path.join(root, app, have[-1])
    rel = latest(app, get)
    return rel['ver'], install(root, rel, get)


def update(root, app, get=fetch):
    """(옛 판, 지금 판) — 새 판이 있으면 받고 옛 판은 지운다"""
    app = app_key(app)
    have = installed(root, app)
    old = have[-1] if have else None
    rel = latest(app, get)
    if old == rel['ver']:
        return old, old
    install(root, rel, get)
    for v in have:
        if v != rel['ver']:
            shutil.rmtree(os.path.join(root, app, v), ignore_errors=True)
    return old, rel['ver']


def listing(root, ddir=None, apps_dir=APPS_DIR):
    """앱마다 웹판 판 · 맥 앱 판(우리가 깐 것 = ours) · 차지하는 크기 · 마지막으로 쓴 날"""
    w = max(len(n) for n, _ in APPS.values())
    recs = load_installs(ddir) if ddir else {}
    used = _read_json(os.path.join(ddir, 'craft-native', 'used.json')) if ddir else {}
    lines = []
    for k, (name, what) in APPS.items():
        where = app_path(k, apps_dir)  # 줄 이름은 ArtCraft 이름(웹판), 맥 앱을 갈아끼웠으면 맥 앱 칸에 그 이름
        have = installed(root, k)
        size = dir_size(os.path.join(root, k)) if os.path.isdir(os.path.join(root, k)) else 0
        appv = native_version(where)
        native = ''
        if appv:
            mine = recs.get(k, {}).get('path') == where
            size += dir_size(where) if mine else 0
            native = f'app {appv}{"" if display(k) == name else " " + display(k)}{"" if mine else " (yours / 직접 깐 것)"}'
        if ddir and os.path.isdir(native_dir(ddir, k)):
            size += dir_size(native_dir(ddir, k))
        extra = f'  {native.ljust(14)}  {(human(size) if size else "-").ljust(7)}  {used.get(k, "-").ljust(10)}' if ddir else ''
        mark = '  [basic / 기본 — keep / 지우자고 안 함]' if k in BASICS else ''  # 미리 깔아 두는 다섯 — 30일 안 써도 정리 제안에서 뺀다
        lines.append(f'{name.ljust(w)}  {(have[-1] if have else "-").ljust(8)}{extra}  {what}{mark}')
    lines.append(LICENSE_LINE)
    return '\n'.join(lines)


# ── 앱 서랍(2026-10-17) — 13개 앱 아이콘 격자: 깔린 것(판·크기·마지막 사용)·깔 수 있는 것(새 판·DMG 크기) ──

def pick_icon(paths):
    """저장소 assets/app-icon 에서 쓸 그림 하나 — 맥 512 PNG > 256 PNG > 1024 PNG > hicolor 128 > SVG"""
    icons = [p for p in paths if '/app-icon/' in f'/{p}']
    for test in (lambda p: p.endswith('-macos-512.png'), lambda p: p.endswith('-256.png'), lambda p: p.endswith('-1024.png'),
                 lambda p: '/128x128/' in p and p.endswith('.png'), lambda p: p.endswith('.svg')):
        hit = next((p for p in icons if test(p)), None)
        if hit:
            return hit
    return None


RELEASE_TTL = 6 * 3600  # 새 판 확인을 묵히는 시간 — 서랍·open 의 저절로 새 판이 같이 쓴다(그 사이엔 GitHub 에 안 묻는다)


def release_info(ddir, app, get=fetch, refresh=False, offline=False):
    """새 판·DMG 크기 — <데이터>/craft-native/releases.json 에 6시간 묵혀 둔다(13개를 열 때마다 GitHub 에 묻지 않게). 못 받으면 None.
    offline = 받아 둔 것만(묵었어도) — 서랍이 먼저 그릴 때(v8 A2). 못 받았고 받아 둔 것도 없으면 {'error': 까닭 한 줄},
    받아 둔 게 있으면 그것에 stale=True(다시 물었는데 못 받음 — 오프라인)"""
    if app in LOCAL:  # 로컬 DMG — 묵히지 않고 바로(새 판이 같은 자리에 쌓인다)
        try:
            return local_latest(app, LOCAL[app])
        except CraftError:
            return None
    p = os.path.join(ddir, 'craft-native', 'releases.json')
    cache = _read_json(p)
    hit = cache.get(app)
    if offline or (hit and not refresh and time.time() - hit.get('at', 0) < RELEASE_TTL):
        return hit
    try:
        rel = latest(app, get, native=True)
    except (CraftError, FetchError, ValueError, KeyError) as e:
        return dict(hit, stale=True) if hit else {'error': str(e)}
    cache[app] = {'ver': rel['ver'], 'tag': rel['tag'], 'dmg_size': rel.get('dmg_size'), 'at': time.time()}
    _write_json(p, cache)
    return cache[app]


def icon_file(ddir, app, apps_dir=APPS_DIR, tag=None, get=fetch, run=subprocess.run):
    """앱 아이콘 PNG(256 — 레티나에서 64점 칸이 선명하게) — <데이터>/craft-native/icons/. 깔린 앱은 번들 icns(이름에 번들·수정 시각 — 앱이 바뀌면 새로),
    안 깐 참모 앱은 로컬 DMG 를 읽기 전용으로 붙여 그 안 앱 icns, 없으면 공개 릴리스의 아이콘 PNG, 안 깐 원본 앱은 저장소 릴리스 태그의 assets/app-icon.
    윈도우는 늘 릴리스 아이콘 PNG(번들 icns·sips 가 없다). 못 구하면 None"""
    if IS_WIN:
        return craft_win.icon_file(ddir, app, tag, get)
    icons = os.path.join(ddir, 'craft-native', 'icons')
    os.makedirs(icons, exist_ok=True)
    bundle = app_path(app, apps_dir)

    def bundle_icns(b):
        import plistlib
        try:
            with open(os.path.join(b, 'Contents', 'Info.plist'), 'rb') as f:
                name = plistlib.load(f).get('CFBundleIconFile') or ''
        except (OSError, ValueError):
            return None
        return os.path.join(b, 'Contents', 'Resources', name if name.endswith('.icns') else name + '.icns')

    def to_png(src, out):
        if src.endswith('.svg'):
            ok = run(['qlmanage', '-t', '-s', '256', '-o', os.path.dirname(out), src], capture_output=True).returncode == 0
            if ok and os.path.exists(src + '.png'):
                os.replace(src + '.png', out)
        else:
            run(['sips', '-s', 'format', 'png', '-Z', '256', src, '--out', out], capture_output=True)
        return out if os.path.exists(out) else None

    if native_version(bundle):
        try:
            mtime = os.path.getmtime(os.path.join(bundle, 'Contents', 'Info.plist'))
        except OSError:
            return None
        out = os.path.join(icons, icon_cache_name(app, bundle, mtime))
        if os.path.exists(out):
            return out
        src = bundle_icns(bundle)
        return to_png(src, out) if src and os.path.exists(src) else None
    if app in LOCAL:
        try:
            ver, dmg, _ = local_release(LOCAL[app])
        except CraftError:
            return None
        out = os.path.join(icons, f'{app}-dmg-{ver}.png')
        if os.path.exists(out):
            return out
        mnt = tempfile.mkdtemp(prefix='chammo-icon-')
        try:
            if run(['hdiutil', 'attach', '-nobrowse', '-readonly', '-noautoopen', '-mountpoint', mnt, dmg], capture_output=True).returncode != 0:
                return None
            found = [x for x in os.listdir(mnt) if x.endswith('.app')]
            src = bundle_icns(os.path.join(mnt, found[0])) if found else None
            return to_png(src, out) if src and os.path.exists(src) else None
        finally:
            run(['hdiutil', 'detach', mnt, '-quiet'], capture_output=True)
            shutil.rmtree(mnt, ignore_errors=True)
    if app in CHAMMO and tag:  # 안 깐 참모 앱 — 공개 릴리스의 아이콘 PNG(chammo-<영문>-<판>-icon.png, SHA256SUMS 에 있는 것만)
        ver = tag.lstrip('v')
        out = os.path.join(icons, f'{app}-release-{ver}.png')
        if os.path.exists(out):
            return out
        name = f'chammo-{CHAMMO[app]["short"]}-{ver}-icon.png'
        try:
            assets, sums, _ = crafts_release(get)
            if name not in assets or name not in sums:
                return None
            data = get(assets[name][0])
        except CraftError:
            return None
        if hashlib.sha256(data).hexdigest() != sums[name]:
            return None
        with open(out + '.tmp', 'wb') as f:
            f.write(data)
        os.replace(out + '.tmp', out)
        return out
    if not tag or (NATIVE.get(app) or {}).get('bundle'):
        return None
    out = os.path.join(icons, f'{app}-{tag}.png')
    if os.path.exists(out):
        return out
    try:
        tree = json.loads(get(f'https://api.github.com/repos/{repo_of(app)}/git/trees/{tag}?recursive=1'))
        hit = pick_icon([t.get('path', '') for t in tree.get('tree', [])])
        if not hit:
            return None
        src = os.path.join(icons, f'.{app}-src{os.path.splitext(hit)[1]}')
        with open(src, 'wb') as f:
            f.write(get(f'https://raw.githubusercontent.com/{repo_of(app)}/{tag}/{hit}'))
    except (FetchError, ValueError, OSError):
        return None
    try:
        return to_png(src, out)
    finally:
        try:
            os.remove(src)
        except OSError:
            pass


def based_on(bundle):
    """참모 앱 Info.plist 의 ChammoBasedOn(원작 판), 없으면 None — 윈도우는 chammo-app.json 의 basedOn"""
    if IS_WIN:
        return (craft_win.info(bundle) or {}).get('basedOn')
    import plistlib
    try:
        with open(os.path.join(bundle, 'Contents', 'Info.plist'), 'rb') as f:
            return plistlib.load(f).get('ChammoBasedOn')
    except (OSError, ValueError):
        return None


def drawer_rows(ddir, root, apps_dir=APPS_DIR, get=fetch, refresh=False, icons=True, fast=False):
    """서랍 줄 — 앱마다 이름·하는 일·깔린 판(없으면 None)·우리가 깔았나·차지하는 크기·마지막 사용·새 판·DMG 크기·아이콘 자리,
    라이선스 창(원작 이름·저장소·기반 판·참모 앱인가), 안 깔렸는데 받을 수 없으면 그 까닭(unavailable). fast = 네트워크 없이(깔린 앱·로컬 DMG·받아 둔 것만 — 서랍이 먼저 그린다)"""
    if fast:
        def get(u):
            raise FetchError('offline')
    recs = load_installs(ddir)
    used = _read_json(os.path.join(ddir, 'craft-native', 'used.json'))
    rows = []
    for k, (_, what) in APPS.items():
        where = app_path(k, apps_dir)
        ver = native_version(where)
        mine = bool(ver) and recs.get(k, {}).get('path') == where
        size = (dir_size(where) if mine else 0) + (dir_size(native_dir(ddir, k)) if os.path.isdir(native_dir(ddir, k)) else 0)
        rel = release_info(ddir, k, get, refresh, offline=fast) or {}
        rows.append({'app': k, 'name': display(k), 'what': what, 'installed': ver, 'mine': mine, 'size': size, 'used': used.get(k),
                     'latest': rel.get('ver'), 'dmgSize': rel.get('dmg_size'), 'unavailable': None if ver else rel.get('error'),
                     'newer': bool(ver and rel.get('ver') and ver_key(rel['ver']) > ver_key(ver)),
                     'icon': icon_file(ddir, k, apps_dir, rel.get('tag'), get) if icons else None,
                     'origName': APPS[k][0], 'repo': f'github.com/{OWNER}/{k}', 'basedOn': based_on(where) if ver else None,
                     'chammo': bundle_id(k).startswith('app.chammo.'), 'basic': k in BASICS, 'prefetching': prefetching(ddir, k)})
    return rows


# ── 로컬 서버: <root> 를 127.0.0.1 에서만, 폴더 목록 없이 ──

def make_server(root, port):
    root = os.path.realpath(root)

    class Handler(http.server.SimpleHTTPRequestHandler):
        def __init__(self, *a, **kw):
            super().__init__(*a, directory=root, **kw)

        def list_directory(self, path):  # index.html 없는 폴더는 목록 대신 404
            self.send_error(404)
            return None

        def end_headers(self):
            self.send_header(MARK, root)
            self.send_header('Cache-Control', 'no-cache')
            super().end_headers()

        def log_message(self, *a):
            pass

    Handler.extensions_map = {**http.server.SimpleHTTPRequestHandler.extensions_map, '.wasm': 'application/wasm', '.js': 'text/javascript'}
    return http.server.ThreadingHTTPServer(('127.0.0.1', port), Handler)


def alive(root, port):
    """그 포트에 이 데이터 폴더의 craft 서버가 떠 있나"""
    try:
        r = urllib.request.urlopen(f'http://127.0.0.1:{port}/', timeout=1)
        h = r.headers
    except urllib.error.HTTPError as e:
        h = e.headers
        e.close()
    except (urllib.error.URLError, OSError):
        return False
    return h.get(MARK) == os.path.realpath(root)


def state_path(ddir):
    return os.path.join(ddir, 'craft-server.json')


def read_state(ddir):
    try:
        with open(state_path(ddir), encoding='utf-8') as f:
            return json.load(f)
    except Exception:
        return {}


def start_server(ddir, root):
    """떠 있으면 그 포트, 없으면 새로 띄운다(앱 저장소가 이어지게 지난 포트부터) — 한 번에 한 스크립트만:
    두 세션이 같이 띄우면 둘 다 _serve 를 띄우고 나중 것이 상태 파일을 덮어 첫 서버는 stop 으로 못 끄는 고아로 남았다(2026-10-21 리뷰 ③-18)"""
    with file_lock(os.path.join(ddir, 'craft-server.lock')):
        return _start_server(ddir, root)


def _start_server(ddir, root):
    st = read_state(ddir)
    if st.get('port') and alive(root, st['port']):
        return st['port']
    me = os.path.abspath(__file__)
    subprocess.Popen([sys.executable, me, '_serve', ddir, root, str(st.get('port') or 0)],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(50):
        time.sleep(0.1)
        st = read_state(ddir)
        if st.get('port') and alive(root, st['port']):
            return st['port']
    raise CraftError('local server did not start / 로컬 서버가 안 떴음')


def serve_main(ddir, root, port):
    try:
        srv = make_server(root, int(port))
    except OSError:
        srv = make_server(root, 0)
    # 다 쓴 뒤 갈아 끼운다 — 읽는 쪽이 반쯤 쓴 JSON 을 안 보게
    tmp = f'{state_path(ddir)}.{os.getpid()}.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump({'pid': os.getpid(), 'port': srv.server_address[1]}, f)
    os.replace(tmp, state_path(ddir))
    srv.serve_forever()


def stop_server(ddir, root):
    st = read_state(ddir)
    if st.get('port') and alive(root, st['port']) and st.get('pid'):
        os.kill(st['pid'], signal.SIGTERM)
        return True
    return False


def child_env(env=None):
    """참모 앱에 물려줄 env — 부른 세션의 CLAUDE_*(메시지 토큰·소켓·세션 번호·JOB_DIR 등)는 뺀다. 맥 open 도 부른 쪽 env 를 앱에 넘긴다(QA 0.3.6 포토 env 13개,
    앱(Rust) 쪽은 0.3.5 에 7개 지움)"""
    env = os.environ if env is None else env
    return {k: v for k, v in env.items() if not k.startswith('CLAUDE')}


def open_native(app, get=fetch):
    name = display(app)
    if sys.platform == 'darwin' and subprocess.run(['open', '-b', bundle_id(app)], capture_output=True, env=child_env()).returncode == 0:
        print(f'{name}: opened the macOS app / 맥 앱 열었음')
        return 0
    try:
        dmg = latest(app, get, native=True).get('dmg')
    except CraftError:
        dmg = None
    print(f'{name}: not installed / 안 깔려 있음 — install it yourself / 설치는 직접: '
          f'{dmg or (f"https://github.com/{CRAFTS_REPO}/releases/tag/{CRAFTS_TAG}" if app in CHAMMO else f"https://github.com/{repo_of(app)}/releases/latest")}', file=sys.stderr)
    return 1


# ── 맥 앱 조종 길: 13개 다 127.0.0.1 조작 채널(--control, JSON 한 줄 = 요청 하나) ──
# auth: token = 토큰 파일을 앱에 넘김(첫 줄 auth params.token) / key = 앱이 설정 폴더에 키 파일을 씀(auth 줄 key)
#       file = --control <파일> 에 앱이 {port, token} 을 씀 / None = 인증 없음(쓸 때만 켜고 close 로 닫는다)
# env: 앱 설정 폴더를 따로 두는 환경 변수 — 사람이 쓰는 그 앱 설정과 안 섞이게
# roots: 데스크톱 앱이 받는 작업 폴더 묶기(r = 읽기만). 모르는 인자를 주면 앱이 안 떠서 받는 앱에만
# uiron: 창 자리를 <설정>/ui.ron 에 저장하는 앱 — 가짜 화면 좌표를 미리 써 넣을 수 있다
# 앱 자체(이름·번들 id·받는 저장소·깔린 자리)도 이 표 한 곳에서 — 같은 앱을 우리가 빌드한 판으로 갈아끼울 땐 그 줄만 바꾼다
#   name: 보이는 이름이자 <이름>.app (없으면 APPS 의 이름) / bundle: 번들 id (없으면 ai.storyteller.<키>)
#   repo: 릴리스를 받는 저장소 owner/name (없으면 storytold/<키>) / path: 깔린 자리를 못 박을 때(없으면 /Applications/<이름>.app)
#   frame: 앱에 창 자리 명령(ui.window.frame {x,y,width,height}, 맥 점)이 있다 — 띄운 뒤 바로 가짜 화면으로 옮긴다(ui.ron 배율 짐작이 빗나가도)
#   save: 닫기 전 저장 명령(engine.execute 명령 id, params {path: 작업 폴더 안 절대 경로}) · ext: 그 앱 문서 형식(새 문서 저장 이름)
#         save=None 이면 앱이 스스로 쓴다(LightCraft 보관함) — 10/16 craft-smoke: PSD 길을 12개에 쓰면 거절되거나 바꾼 걸 버렸다
#   args: 설정·데이터 자리를 우리 폴더로 보내는 앱 인자({dir} = <데이터>/craft-native/<앱>) · extra: 그래도 앱이 홈에 만드는 설정(remove 가 휴지통으로)
def _n(auth=None, env=None, roots=None, uiron=False, name=None, bundle=None, repo=None, path=None, frame=False, save=None, ext='', args=(), extra=()):
    return {'auth': auth, 'env': env, 'roots': roots, 'uiron': uiron, 'name': name, 'bundle': bundle, 'repo': repo, 'path': path, 'frame': frame,
            'save': save, 'ext': ext, 'args': list(args), 'extra': list(extra)}


_AS = 'Library/Application Support/'  # 홈 기준


NATIVE = {
    # 참모 포토 — PhotoCraft 를 우리가 빌드한 판(Dock 안 보임·끌기·창 자리 명령). 공개 저장소가 정해지면 repo 만 채운다(그전엔 CHAMMO_CRAFT_LOCAL)
    'photocraft': _n('token', 'PHOTOCRAFT_CONFIG_DIR', 'rw', True, name='참모 포토', bundle='app.chammo.photo', path='/Applications/Chammo Photo.app', frame=True,
                     save='app.save', ext='.psd'),
    'wordcraft': _n('key', 'WORDCRAFT_PROFILE_DIR', save='file.saveAs', ext='.docx', extra=[_AS + 'WordCraft']),
    'pdfcraft': _n('file', save='file.save', ext='.pdf', extra=[_AS + 'PdfCraft']),
    'vectorcraft': _n(env='VECTORCRAFT_CONFIG_DIR', roots='rw', save='file.saveAs', ext='.vectorcraft'),
    'effectcraft': _n(env='EFFECTCRAFT_CONFIG_DIR', save='file.saveAs', ext='.ecproj'),  # 0.10 은 --automation-read-root 를 몰라 안 뜬다
    'lightcraft': _n(env='LIGHTCRAFT_CONFIG_DIR', args=['--library', '{dir}/library']),
    'designcraft': _n(env='DESIGNCRAFT_CONFIG_DIR', save='file.saveAs', ext='.dcdoc'),
    'cadcraft': _n(env='CADCRAFT_CONFIG_DIR', save='saveas', ext='.dwg', extra=[_AS + 'ai.storyteller.cadcraft']),
    'soundcraft': _n(env='SOUNDCRAFT_CONFIG_DIR', save='session.save', ext='.scproj'),
    'filmcraft': _n(save='file.saveAs', ext='.fcproj', args=['--data-dir', '{dir}/data']),
    'gridcraft': _n(save='file.saveAs', ext='.xlsx', extra=[_AS + 'GridCraft']),
    'deckcraft': _n(save='file.saveAs', ext='.pptx', extra=[_AS + 'DeckCraft']),
    'figcraft': _n(save='file.saveAs', ext='.fig', extra=[_AS + 'FigCraft']),
}
WIN = (1360.0, 820.0)  # 가짜 화면에 띄울 창 크기(화면이 작으면 줄인다)

# 참모 앱 — ArtCraft 원본을 우리가 빌드한 판(번들 app.chammo.<영문>, 'Chammo <영문>.app', 서랍 이름 '참모 ○○'). 맥 앱 표는 13개 다 이것(10/19 공개판 —
# 원본 ArtCraft 맥 앱 길은 끝, 웹판·CLI 만 원본). 받기는 아래 공개 릴리스, <데이터>/craft-native/local-releases.json 에 DMG 폴더
# ({"root": "<release 폴더>"} 또는 {"<앱>": "<DMG 폴더>"})가 있으면 그 앱은 거기서(내 맥 시험용 덮어쓰기). 원본이 깔린 맥도 자리·번들이 달라 새 앱을 따로 깐다.
# 설정 env·조작 인자는 원본 그대로, 작업 폴더·첫 자리는 env 로
CHAMMO = {
    'photocraft': {'short': 'photo'},  # 이미 참모 포토 표 — 로컬 DMG 자리만(창 첫 자리는 ui.ron)
    'vectorcraft': {'short': 'vector', 'name': '참모 벡터', 'bundle': 'app.chammo.vector', 'path': '/Applications/Chammo Vector.app'},
    'wordcraft': {'short': 'word', 'name': '참모 문서', 'bundle': 'app.chammo.word', 'path': '/Applications/Chammo Word.app', 'work': True},
    'pdfcraft': {'short': 'pdf', 'name': '참모 PDF', 'bundle': 'app.chammo.pdf', 'path': '/Applications/Chammo PDF.app', 'env': 'PDFCRAFT_CONFIG_DIR', 'work': True},
    'deckcraft': {'short': 'deck', 'name': '참모 슬라이드', 'bundle': 'app.chammo.deck', 'path': '/Applications/Chammo Deck.app', 'env': 'DECKCRAFT_CONFIG_DIR', 'work': True},
    'designcraft': {'short': 'design', 'name': '참모 디자인', 'bundle': 'app.chammo.design', 'path': '/Applications/Chammo Design.app', 'work': True, 'ext': '.designcraft'},  # .dcdoc 로 저장하면 '.dcdoc.designcraft' 가 된다
    'gridcraft': {'short': 'grid', 'name': '참모 표', 'bundle': 'app.chammo.grid', 'path': '/Applications/Chammo Grid.app', 'env': 'GRIDCRAFT_CONFIG_DIR', 'work': True},
    'figcraft': {'short': 'fig', 'name': '참모 화면', 'bundle': 'app.chammo.fig', 'path': '/Applications/Chammo Fig.app', 'env': 'FIGCRAFT_CONFIG_DIR', 'work': True},
    'filmcraft': {'short': 'film', 'name': '참모 필름', 'bundle': 'app.chammo.film', 'path': '/Applications/Chammo Film.app', 'work': True},  # 데이터 자리는 원본 --data-dir 그대로
    'effectcraft': {'short': 'effect', 'name': '참모 이펙트', 'bundle': 'app.chammo.effect', 'path': '/Applications/Chammo Effect.app', 'work': True},  # 설정 env 원본 그대로
    'lightcraft': {'short': 'light', 'name': '참모 라이트', 'bundle': 'app.chammo.light', 'path': '/Applications/Chammo Light.app', 'work': True},  # 설정 env·--library 원본 그대로
    'soundcraft': {'short': 'sound', 'name': '참모 사운드', 'bundle': 'app.chammo.sound', 'path': '/Applications/Chammo Sound.app', 'work': True},  # 설정 env 원본 그대로
    'cadcraft': {'short': 'cad', 'name': '참모 캐드', 'bundle': 'app.chammo.cad', 'path': '/Applications/Chammo CAD.app', 'work': True},  # 설정 env 원본 그대로
}
LOCAL = {}  # 앱 → 로컬 DMG 폴더(main 이 local-releases.json 으로 채운다)

# 참모 앱 공개 릴리스 — Chammo 공개 저장소(CRAFTS_REPO)의 릴리스 하나(태그 crafts-<날짜>)에 13개 DMG(chammo-<영문>-<판>-macos-universal.dmg)와
# 합친 SHA256SUMS.txt(scripts/craft-release-assets 가 만든다). 판·파일 이름·체크섬은 SHA256SUMS 에서, 받을 주소·크기는 자산 목록에서.
# 새 판은 같은 태그에 DMG 를 바꿔 올리고 SHA256SUMS 를 다시 — 깐 앱의 '새 판 확인'이 그걸 본다. 로컬 DMG 폴더가 있으면 그게 이긴다
# 저장소 이름은 앱 업데이터 주소와 같은 공개 저장소 — 템플릿 이름 검사(test_hq_scripts) 목록 글자라 조각으로 잇는다
CRAFTS_REPO, CRAFTS_TAG = 'honor' + 'studio/chammo', 'crafts-2026.10.19'
_CRAFTS = {}  # (주소, 받기 함수) → (자산 {이름: (주소, 크기)}, 체크섬 {이름: 해시}, 체크섬 주소) 또는 못 받은 까닭 — 13개가 같은 릴리스라 한 번만


def crafts_release_url(env=None):
    """참모 앱 릴리스 JSON 주소 — 시험은 CHAMMO_CRAFT_RELEASE 로 가짜 서버를"""
    env = os.environ if env is None else env
    return env.get('CHAMMO_CRAFT_RELEASE') or f'https://api.github.com/repos/{CRAFTS_REPO}/releases/tags/{CRAFTS_TAG}'


def crafts_release(get=fetch):
    url = crafts_release_url()
    key = (url, get)
    if key not in _CRAFTS:
        try:
            rel = json.loads(get(url))
            assets = {a['name']: (a['browser_download_url'], a.get('size')) for a in rel.get('assets', [])}
            if 'SHA256SUMS.txt' not in assets:
                raise CraftError('no SHA256SUMS.txt / 체크섬 파일이 없음')
            sums_url = assets['SHA256SUMS.txt'][0]
            _CRAFTS[key] = (assets, parse_sums(get(sums_url).decode('utf-8', 'replace')), sums_url)
        except (CraftError, ValueError, KeyError, TypeError, AttributeError) as e:
            why = str(e).rsplit(' — ', 1)[-1] if isinstance(e, FetchError) else str(e) or type(e).__name__
            _CRAFTS[key] = f'{CRAFTS_TAG}: could not get the Chammo apps release / 참모 앱 공개 릴리스를 못 받음 — {why}'
    hit = _CRAFTS[key]
    if isinstance(hit, str):
        raise CraftError(hit)
    return hit


def crafts_latest(app, get=fetch):
    """공개 릴리스에서 그 앱의 가장 높은 판 — SHA256SUMS 와 자산 목록에 다 있는 DMG 만"""
    assets, sums, sums_url = crafts_release(get)
    pat = re.compile(rf'chammo-{re.escape(CHAMMO[app]["short"])}-(\d+\.\d+\.\d+)-macos-universal\.dmg')
    found = [(m.group(1), n) for n in sums if (m := pat.fullmatch(n)) and n in assets]
    if not found:
        raise CraftError(f'{display(app)}: not in the release {CRAFTS_TAG} / 공개 릴리스에 없음')
    ver, name = max(found, key=lambda f: _ver_key(f[0]))
    url, size = assets[name]
    return {'app': app, 'tag': 'v' + ver, 'ver': ver, 'zip': None, 'zip_name': None, 'sums': sums_url, 'dmg': url,
            'dmg_size': size, 'cli': None, 'cli_name': None}


def _ver_key(v):
    return tuple(int(x) for x in v.split('.'))


def _has_dmg(f):
    """그 폴더에 이 플랫폼 설치 파일(맥 DMG · 윈도우 zip)이 있나"""
    if IS_WIN:
        return craft_win.has_pkg(f)
    try:
        return any(n.endswith('-macos-universal.dmg') for n in os.listdir(f))
    except OSError:
        return False


def resolve_local(folder):
    """앱별로 적은 폴더 — 판 폴더(X.Y.Z)들을 담았으면 DMG 가 든 가장 높은 판, 아니면 DMG 가 바로 든 그 폴더, 둘 다 아니면 None.
    참모 포토 DMG 는 다른 저장소(chammo-photo) .shots/release/<판>/ 이고 맨 위에 옛 DMG 가 섞여 있다(10/19)"""
    base = os.path.dirname(folder.rstrip('/'))
    return newest_local(base, os.path.basename(folder.rstrip('/'))) or (folder if _has_dmg(folder) else None)


def newest_local(root, short):
    """<root>/<short>/<판>/ 중 DMG 가 든 가장 높은 판 폴더(숫자로 견줌), 없으면 None"""
    base = os.path.join(root, short)
    try:
        vers = [v for v in os.listdir(base) if re.fullmatch(r'\d+\.\d+\.\d+', v)]
    except OSError:
        return None
    for v in sorted(vers, key=_ver_key, reverse=True):
        f = os.path.join(base, v)
        if _has_dmg(f):
            return f
    return None


def chammo_table(native, cfg):
    """(앱 표, 로컬 DMG 폴더) — 13개 다 참모 앱 값으로 덮고, 로컬 DMG 폴더는 있는 앱만(내 맥 시험용 — 있으면 공개 릴리스보다 먼저). 넘긴 표는 안 바꾼다"""
    out, local = dict(native), {}
    root = os.path.expanduser(cfg.get('root') or '')
    for app, row in CHAMMO.items():
        mine = os.path.expanduser(cfg.get(app) or '')
        folder = resolve_local(mine) if mine else (newest_local(root, row['short']) if root else None)
        if folder and os.path.isdir(folder):
            local[app] = folder
        over = {k: v for k, v in row.items() if k not in ('short', 'work')}
        if app != 'photocraft':
            over.update(frame=True, chammo=True, work=bool(row.get('work')), uiron=False)
        out[app] = {**native[app], **over}
    return out, local


NATIVE = chammo_table(NATIVE, {})[0]  # 기본 = 참모 앱 13개(main 이 local-releases.json 으로 로컬 DMG 자리를 더한다)


def local_config(ddir):
    return _read_json(os.path.join(ddir, 'craft-native', 'local-releases.json')) if ddir else {}


def local_latest(app, folder):
    """로컬 DMG 폴더를 릴리스처럼 — 판·DMG·체크섬·크기(설치 확인은 그대로). 윈도우는 zip 폴더"""
    if IS_WIN:
        return craft_win.local_latest(app, folder)
    ver, dmg, sums = local_release(folder)
    return {'app': app, 'tag': 'v' + ver, 'ver': ver, 'zip': None, 'zip_name': None, 'sums': sums, 'dmg': dmg,
            'dmg_size': os.path.getsize(dmg), 'cli': None, 'cli_name': None}


def icon_cache_name(app, bundle, mtime):
    """아이콘 캐시 파일 이름 — 앱 번들 이름 + Info.plist 수정 시각(앱이 바뀌면 새로). 앱(craft_dock.rs icon_of)과 같은 규칙"""
    base = re.sub(r'[^A-Za-z0-9]+', '_', os.path.basename(bundle.rstrip('/'))[:-4] if bundle.endswith('.app') else os.path.basename(bundle)).strip('_')
    return f'{app}-{base}-{int(mtime)}.png'


def win_spot(vd, n=1):
    """n 번째 인스턴스 창 왼쪽 위·크기 — 첫 번째는 왼쪽 위에서 조금 비켜, 다음은 계단처럼 아래 오른쪽으로(가짜 화면 안에서, 화면이 작으면 줄여서).
    1920x1200 가짜 화면에 1360x820 셋은 다 안 겹치게 못 놓는다 — 비추기(SCK 창 하나)·찍기(-l 창 번호)는 겹쳐도 그 창만 본다"""
    x, y, w, h = vd
    ww, hh = min(WIN[0], w - 80), min(WIN[1], h - 80)
    dx, dy = (n - 1) * min(250, max(0, (w - ww - 60) // 2)), (n - 1) * min(160, max(0, (h - hh - 66) // 2))
    return x + 30 + dx, y + 33 + dy, ww, hh


def frame_params(vd, n=1):
    """창 자리 명령 값(uiron_text 와 같은 자리)"""
    x, y, w, h = win_spot(vd, n)
    return {'x': x, 'y': y, 'width': w, 'height': h}


def display(app):
    """보이는 이름 — 맥 앱 표에 이름이 있으면 그것(갈아끼운 판), 없으면 ArtCraft 이름. 2·3번째 인스턴스는 뒤에 번호"""
    a, n = base(app), inst_no(app)
    return ((NATIVE.get(a) or {}).get('name') or APPS[a][0]) + (f' {n}' if n > 1 else '')


def bundle_id(app):
    app = base(app)
    return (NATIVE.get(app) or {}).get('bundle') or f'ai.storyteller.{app}'


def repo_of(app):
    app = base(app)
    return (NATIVE.get(app) or {}).get('repo') or f'{OWNER}/{app}'


def app_path(app, apps_dir=APPS_DIR):
    """깔린 자리 — 표에 박힌 자리가 있으면 그것, 다른 앱 폴더를 주면(시험) 그 폴더 안 같은 이름. 윈도우는 %LOCALAPPDATA%\\Programs\\Chammo\\<이름>"""
    app = base(app)
    if IS_WIN:
        return craft_win.app_path(app)
    pinned = (NATIVE.get(app) or {}).get('path')
    if pinned:
        return pinned if os.path.dirname(pinned) == apps_dir else os.path.join(apps_dir, os.path.basename(pinned))
    return os.path.join(apps_dir, display(app) + '.app')


def native_dir(ddir, app):
    return os.path.join(ddir, 'craft-native', app)


def free_port():
    s = socket.socket()
    s.bind(('127.0.0.1', 0))
    p = s.getsockname()[1]
    s.close()
    return p


def read_vd(ddir):
    """앱이 띄운 가짜 화면(Chammo agents) 자리 (x, y, w, h) — <데이터>/browser/vdisplay.json, 없으면 None.
    가짜 화면은 필요할 때만 떠서(10/20) 도우미(pid)가 죽은 자리 파일은 옛 자리 — 안 믿는다"""
    try:
        with open(os.path.join(ddir, 'browser', 'vdisplay.json'), encoding='utf-8') as f:
            j = json.load(f)
        return tuple(float(v) for v in j['bounds'][:4]) if pid_alive(j.get('pid')) else None
    except Exception:
        return None


def uiron_text(vd, scale, n=1):
    """가짜 화면 왼쪽 위에서 조금 비켜(n 번째 인스턴스는 계단처럼) 띄울 eframe 창 기록. 이 앱들은 자리를 '배율 곱한 픽셀'로 읽는다(맥북 2배+가짜 화면 1배면 2)"""
    x, y, ww, hh = win_spot(vd, n)
    ix, iy = x * scale, y * scale
    win = (f'(inner_position_pixels:Some((x:{ix:.1f},y:{iy:.1f})),outer_position_pixels:Some((x:{ix:.1f},y:{iy - 28 * scale:.1f})),'
           f'fullscreen:false,maximized:false,inner_size_points:Some((x:{ww:.1f},y:{hh:.1f})))')
    return json.dumps({'window': win})


def launch_plan(ddir, app, port, work, vd=None, scale=1.0):
    """띄울 명령·비밀 파일·ui.ron — 비밀 값은 인자에 넣지 않는다(파일 경로만). app 은 인스턴스 키(설정·작업·비밀 폴더가 인스턴스마다 따로)"""
    spec, n = NATIVE[base(app)], inst_no(app)
    cfg = os.path.join(native_dir(ddir, app), 'config')
    argv = ['open', '-n', '-g', '-a', app_path(app)]  # 자리로 연다 — 같은 번들 id 판이 여럿이어도 표에 적힌 그 앱
    if spec['env']:
        argv += ['--env', f'{spec["env"]}={cfg}']
    if spec.get('chammo'):  # 참모 앱 — 작업 폴더·첫 자리(보이기 전에 가짜 화면에 놓인다 — ui.ron·System Events 옮기기 대신)
        if spec.get('work') and work:
            argv += ['--env', f'CHAMMO_WORK_DIR={work}']
        if vd:
            fp = frame_params(vd, n)
            argv += ['--env', 'CHAMMO_WINDOW_FRAME=' + ','.join(str(int(fp[k])) for k in ('x', 'y', 'width', 'height'))]
    elif vd and base(app) == 'photocraft':
        # 참모 포토는 자리를 ui.ron 으로 받지만, 켜질 때 앞으로 안 나오기(focus-root)는 이 신호로 가른다 — 값만 넘기고 자리는 ui.ron 그대로
        fp = frame_params(vd, n)
        argv += ['--env', 'CHAMMO_WINDOW_FRAME=' + ','.join(str(int(fp[k])) for k in ('x', 'y', 'width', 'height'))]
    args, secret = [], None
    if spec['auth'] == 'file':
        secret = os.path.join(native_dir(ddir, app), 'control.json')
        args += ['--control', secret]
        port = None
    else:
        args += ['--control', str(port)]
    if spec['auth'] == 'token':
        secret = os.path.join(native_dir(ddir, app), 'control.token')
        args += ['--control-token-file', secret]
    elif spec['auth'] == 'key':
        secret = os.path.join(cfg, f'control-key.local-{port}')
    args += [a.replace('{dir}', native_dir(ddir, app)) for a in spec['args']]  # 설정·데이터 자리를 우리 폴더로(홈에 안 남게)
    if spec['roots'] and work:
        args += ['--automation-read-root', work]
        if spec['roots'] == 'rw':
            args += ['--automation-write-root', work]
    uiron = (os.path.join(cfg, 'ui.ron'), uiron_text(vd, scale, n)) if spec['uiron'] and vd else None
    return {'argv': argv + ['--args'] + args, 'secret': secret, 'port': port, 'config': cfg, 'uiron': uiron}


def state_file(ddir, app):
    return os.path.join(ddir, 'craft-native', f'{app}.json')


def save_state(ddir, app, st):
    p = state_file(ddir, app)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    fd = os.open(p + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w', encoding='utf-8') as f:
        json.dump(st, f)
    _replace(p + '.tmp', p)


def load_state(ddir, app):
    try:
        with open(state_file(ddir, app), encoding='utf-8') as f:
            return json.load(f)
    except Exception:
        return None


def drop_state(ddir, app):
    try:
        os.remove(state_file(ddir, app))
    except OSError:
        pass


# ── 인스턴스 고르기 — 세션(CLAUDE_JOB_DIR 끝 번호 = by)마다 자기 것, 한 앱에 MAX_INSTANCES 개, 넘으면 줄 서기 ──

def live_instances(ddir, app):
    """떠 있는 인스턴스 [(키, 상태)] — 1번부터"""
    out = []
    for n in range(1, MAX_INSTANCES + 1):
        k = inst_key(app, n)
        st = load_state(ddir, k)
        if inst_alive(st):
            out.append((k, st))
    return out


def pick_instance(ddir, app, me, key=None, name_of=None):
    """명령이 갈 인스턴스 — 고른 키 > 내가 연 것 > (세션 밖이면) 첫 번째·하나뿐인 것 > 주인 없는 것. 남의 것만 있으면 따로 띄우라고"""
    if key:
        if not any(k == key for k, _ in live_instances(ddir, app)):
            raise CraftError(f'{display(key)} is not open / 안 띄움 — scripts/craft open {app} --native')
        return key
    live = live_instances(ddir, app)
    if not live:
        # 꺼진 앱의 상태 파일만 남았으면 그것(close 가 치운다 — 지금처럼), 그것도 없으면 안 띄움
        dead = [(k, st) for k, st in ((inst_key(app, n), load_state(ddir, inst_key(app, n))) for n in range(1, MAX_INSTANCES + 1)) if st]
        pick = next((k for k, st in dead if me and st.get('by') == me), None) or next((k for k, st in dead if not st.get('by') or not me), None)
        if pick:
            return pick
        raise CraftError(f'{display(app)} is not open / 안 띄움 — scripts/craft open {app} --native')
    mine = [k for k, st in live if me and st.get('by') == me]
    if mine:
        return mine[0]
    if not me:
        return next((k for k, _ in live if k == app), live[0][0])
    free = [k for k, st in live if not st.get('by')]
    if free:
        return free[0]
    who = ', '.join(f'{(name_of or session_name)(st["by"])} ({k})' for k, st in live)
    raise CraftError(f'{display(app)}: in use by {who} — open your own: scripts/craft open {app} --native / 다른 세션이 쓰는 중 — '
                     f'내 것은 scripts/craft open {app} --native 로 따로(남의 창에 쓰려면 <키> --force)')


def claim_file(ddir, key):
    return os.path.join(ddir, 'craft-native', f'{key}.claim.json')


def _taken(ddir, key):
    st = load_state(ddir, key)
    return inst_alive(st) or pid_alive(_read_json(claim_file(ddir, key)).get('pid'))


def slot_lock(ddir, app):
    """자리 고르기·줄은 한 번에 한 스크립트만 — 둘이 같이 띄워도 같은 자리를 안 잡게"""
    return file_lock(os.path.join(ddir, 'craft-native', f'{app}.lock'))


@contextlib.contextmanager
def file_lock(p):
    """그 잠금 파일을 쥔 동안 다른 스크립트는 기다린다(프로세스 사이)"""
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, 'a', encoding='utf-8') as f:
        if IS_WIN:  # 윈도우엔 fcntl 이 없다 — msvcrt 잠금(craft_win.lock)
            craft_win.lock(f)
        else:
            import fcntl
            fcntl.flock(f, fcntl.LOCK_EX)
        try:
            yield
        finally:
            craft_win.unlock(f) if IS_WIN else fcntl.flock(f, fcntl.LOCK_UN)


def _claim_free(ddir, app, me):
    for n in range(1, MAX_INSTANCES + 1):
        k = inst_key(app, n)
        if not _taken(ddir, k):
            _write_json(claim_file(ddir, k), {'pid': os.getpid(), 'by': me or '', 'at': time.time()})
            return k
    return None


def claim(ddir, app, me):
    """빈 자리를 잡는다(띄우는 동안 이 스크립트 pid 로) — 키, 다 찼으면 None"""
    with slot_lock(ddir, app):
        return _claim_free(ddir, app, me)


def unclaim(ddir, key):
    try:
        os.remove(claim_file(ddir, key))
    except OSError:
        pass


def open_choice(ddir, app, me):
    """open 이 할 일 — ('reuse', 키)·('new', 빈 자리 키)·('wait', None)"""
    live = live_instances(ddir, app)
    mine = [k for k, st in live if me and st.get('by') == me]
    if mine:
        return 'reuse', mine[0]
    if live and not me:
        return 'reuse', next((k for k, _ in live if k == app), live[0][0])  # 사람이 서랍·독에서 — 떠 있는 걸 보여 준다
    free = [k for k, st in live if not st.get('by')]
    if free:
        return 'reuse', free[0]  # 사람이 연 것 — 세션이 넘겨받는다(지금처럼)
    k = next((inst_key(app, n) for n in range(1, MAX_INSTANCES + 1) if not _taken(ddir, inst_key(app, n))), None)
    return ('new', k) if k else ('wait', None)


def open_slot(ddir, app, me, chosen=None, wait=None, say=None):
    """open 이 띄울(또는 다시 보일) 인스턴스 — (키, 잡았나). 잡았으면 띄운 뒤 unclaim. 다 찼으면 줄 서서 기다린다"""
    if chosen:
        if any(k == chosen for k, _ in live_instances(ddir, app)):
            return chosen, False
        with slot_lock(ddir, app):
            if _taken(ddir, chosen):
                raise CraftError(f'{display(chosen)} is being opened / 띄우는 중')
            _write_json(claim_file(ddir, chosen), {'pid': os.getpid(), 'by': me or '', 'at': time.time()})
        return chosen, True
    how, k = open_choice(ddir, app, me)
    if how == 'reuse':
        return k, False
    k = claim(ddir, app, me) or wait_slot(ddir, app, me, WAIT_MAX if wait is None else wait, say)
    return k, True


def queue_file(ddir, app):
    return os.path.join(ddir, 'craft-native', f'{app}.queue.json')


def read_queue(ddir, app):
    return [x for x in (_read_json(queue_file(ddir, app)).get('items') or []) if pid_alive(x.get('pid'))]


def write_queue(ddir, app, items):
    _write_json(queue_file(ddir, app), {'items': items})


WAIT_MAX = 1800  # 줄 서서 기다리는 최대(초) — 남의 편집이 끝나기를 기다리니 넉넉히


def wait_slot(ddir, app, me, timeout=WAIT_MAX, say=None, sleep=time.sleep, now=time.time):
    """다 찼을 때 — 줄을 서서(먼저 온 순서, 기다리던 스크립트가 죽으면 빠짐) 자리가 나면 잡는다. 몇 번째인지 바뀔 때마다 say. 너무 오래면 CraftError"""
    say = say or (lambda t: print(t, file=sys.stderr, flush=True))
    mine = {'pid': os.getpid(), 'by': me or '', 'at': now()}
    end, told = now() + timeout, None
    try:
        while True:
            with slot_lock(ddir, app):
                q = [x for x in read_queue(ddir, app) if x.get('pid') != mine['pid']]
                q.insert(next((i for i, x in enumerate(q) if x.get('at', 0) > mine['at']), len(q)), mine)
                pos = q.index(mine) + 1
                k = _claim_free(ddir, app, me) if pos == 1 else None
                write_queue(ddir, app, [x for x in q if x is not mine or not k])
            if k:
                return k
            if pos != told:
                say(f'{display(app)}: all {MAX_INSTANCES} in use — waiting (#{pos}), opens by itself when one closes / '
                    f'{MAX_INSTANCES}개 다 쓰는 중 — 대기 중 ({pos}번째, 자리가 나면 저절로 이어서 띄움, 최대 {int(timeout // 60)}분)')
                told = pos
            if now() >= end:
                raise CraftError(f'{display(app)}: waited {int(timeout)}s, all {MAX_INSTANCES} still in use / {MAX_INSTANCES}개가 계속 쓰는 중 — 나중에 다시')
            sleep(2)
    finally:
        with slot_lock(ddir, app):
            q = read_queue(ddir, app)
            if any(x.get('pid') == mine['pid'] for x in q):
                write_queue(ddir, app, [x for x in q if x.get('pid') != mine['pid']])


class Channel:
    """띄운 앱의 조작 채널 — 연결하고 앱 방식대로 인증한 뒤 call(method, params) → result. 실패는 CraftError"""

    def __init__(self, st, timeout=70):
        self.i = 0
        port, secret = st.get('port'), None
        try:
            if st['auth'] == 'file':
                with open(st['secret'], encoding='utf-8') as f:
                    j = json.load(f)
                port, secret = j['port'], j['token']
            elif st['auth']:
                with open(st['secret'], encoding='utf-8') as f:
                    secret = f.read().strip()
            self.s = socket.create_connection(('127.0.0.1', int(port)), timeout=timeout)
        except (OSError, ValueError, KeyError, TypeError) as e:
            raise CraftError(f'{st.get("app")}: not running or no control channel / 안 떠 있음 — scripts/craft open {st.get("app")} --native ({e})') from e
        self.f = self.s.makefile('rw', encoding='utf-8')
        try:
            if st['auth'] == 'key':
                self._send({'method': 'auth', 'key': secret})
            elif st['auth']:
                self._send({'method': 'auth', 'params': {'token': secret}})
        except CraftError:
            self.close()
            raise

    def _send(self, req):
        self.i += 1
        req['id'] = self.i
        try:
            self.f.write(json.dumps(req) + '\n')
            self.f.flush()
            line = self.f.readline()
        except OSError as e:
            raise CraftError(f'control channel: {e}') from e
        if not line:
            raise CraftError('control channel closed / 앱이 연결을 끊음 (wrong key? / 비밀이 틀렸나)')
        r = json.loads(line)
        if 'jsonrpc' in r:  # PdfCraft — JSON-RPC 2.0(ok 없음, 오류는 {code, message})
            if r.get('error'):
                e = r['error']
                raise CraftError(e.get('message') if isinstance(e, dict) else str(e))
            return r.get('result')
        if not r.get('ok'):
            raise CraftError(r.get('error') or 'error')
        return r.get('result')

    def call(self, method, params=None):
        return self._send({'method': method, 'params': params or {}})

    def close(self):
        for x in (getattr(self, 'f', None), getattr(self, 's', None)):
            try:
                x and x.close()
            except OSError:
                pass


def run_call(app, cmd, params):
    """명령 id → 채널 요청. 다 engine.execute, PdfCraft 만 ui.command(메뉴 명령)"""
    app = base(app)
    if app == 'pdfcraft':
        return 'ui.command', {'id': cmd}
    return 'engine.execute', ({'command': cmd, 'params': params} if params is not None else {'command': cmd})


SHOT_NO_FOCUS = {'photocraft', 'vectorcraft', 'designcraft'}  # ui.screenshot 이 기본으로 창을 앞으로 부르는 앱(focus 인자를 안다)


def shot_params(app):
    # 칸 그림·shot 마다 앞 창을 가져가지 않게 — 참모 디자인은 띄운 직후 칸 그림에서 사람 앞 창을 가져갔다(10/21 윈도우 시험 PC).
    # 인자를 모르는 앱엔 안 준다
    return {'focus': False} if base(app) in SHOT_NO_FOCUS else {}


def shot_bytes(res):
    for k in ('base64', 'png', 'png_base64', 'pngBase64'):
        if isinstance(res, dict) and isinstance(res.get(k), str):
            import base64
            return base64.b64decode(res[k])
    return None


def shot_file(res, asked):
    """찍기 답 → PNG 바이트. 앱마다 모양이 다르다(10/16): 바이트(base64) · 그림 경로만(CAD 임시 폴더) · 크기만 주고 넘긴 자리(asked)에 씀. 없으면 None"""
    b = shot_bytes(res)
    if b:
        return b
    for p in ([res.get('path')] if isinstance(res, dict) and isinstance(res.get('path'), str) else []) + [asked]:
        if p and os.path.isfile(p):
            with open(p, 'rb') as f:
                return f.read()
    return None


def ax_ok():
    """손쉬운 사용 허용이 있나 — 묻지 않고 보기만(이 스크립트를 띄운 앱 기준). 없을 때 System Events 를 부르면 맥이 권한 창을 띄운다(2026-10-19)"""
    if sys.platform != 'darwin':
        return False
    try:
        import ctypes
        lib = ctypes.cdll.LoadLibrary('/System/Library/Frameworks/ApplicationServices.framework/ApplicationServices')
        lib.AXIsProcessTrusted.restype = ctypes.c_bool
        return bool(lib.AXIsProcessTrusted())
    except OSError:
        return False


def place_window(pid, x, y, ax=ax_ok, run=subprocess.run):
    """띄운 창을 가짜 화면으로 — 손쉬운 사용 허용이 있을 때만(없으면 묻는 창 대신 그대로 둔다). 옮겼으면 True"""
    if not ax():
        print('no Accessibility permission — window left where it opened / 손쉬운 사용 허용이 없어 창을 못 옮김(설정 > 기능 > 손쉬운 사용)', file=sys.stderr)
        return False
    run(['osascript', '-e', move_window_script(pid, x, y)], capture_output=True, timeout=10)
    return True


def move_window_script(pid, x, y):
    """띄운 창을 가짜 화면으로 — System Events(손쉬운 사용). 12개 다 먹는다(10/16 실측, PhotoCraft 계열만 ui.ron·창 자리 명령)"""
    return f'tell application "System Events" to tell (first process whose unix id is {int(pid)}) to set position of window 1 to {{{int(x)}, {int(y)}}}'


def save_call(app, work, name):
    """닫기 전 저장 채널 요청 — None 이면 그 앱은 스스로 쓴다. PhotoCraft 는 작업 폴더 기준 이름, 나머지는 절대 경로(VectorCraft 는 상대 경로를 못 씀)"""
    app = base(app)
    cmd = (NATIVE.get(app) or {}).get('save')
    if not cmd:
        return None
    if app == 'photocraft':
        return 'app.save', {'path': name}
    if app == 'pdfcraft':
        return 'ui.command', {'id': cmd}  # 메뉴 명령 — 제자리 저장
    return 'engine.execute', {'command': cmd, 'params': {'path': os.path.join(work, name)}}


def quit_method(app):
    return 'ui.quit' if base(app) == 'pdfcraft' else 'app.quit'


def native_version(app_path):
    """깔린 맥 앱의 판(Info.plist), 없으면 None — 윈도우는 chammo-app.json"""
    if IS_WIN:
        return craft_win.native_version(app_path)
    import plistlib
    try:
        with open(os.path.join(app_path, 'Contents', 'Info.plist'), 'rb') as f:
            return plistlib.load(f).get('CFBundleShortVersionString')
    except (OSError, ValueError):
        return None


def install_native(app, get=fetch, run=subprocess.run, apps_dir=APPS_DIR, ddir=None, rel=None, busy=None):
    """최신 릴리스(rel 을 주면 그것) 맥 DMG → SHA256SUMS 대조 → 마운트 → 번들 id·공증(spctl)·판 확인 → <apps_dir>/<이름>.app(있던 건 바꿔 끼움).
    하나라도 안 맞으면 아무것도 안 깔고 CraftError. busy() 가 참이면(바꿔 끼우기 직전 — 받는 동안 사람이 켰다) BusyError"""
    app = app_key(base(app))  # 'gridcraft-2' 도(둘째 인스턴스의 처음 설치 길)
    rel = rel or latest(app, get, native=True)
    if not rel.get('dmg'):
        raise CraftError(f'{app} {rel["tag"]}: no macOS DMG in the release / 릴리스에 맥 DMG 가 없음')
    dname = rel['dmg'].rsplit('/', 1)[-1]
    data = get(rel['dmg'])
    want = parse_sums(get(rel['sums']).decode('utf-8', 'replace')).get(dname)
    if not want or hashlib.sha256(data).hexdigest() != want:
        raise CraftError(f'SHA-256 mismatch or missing / 체크섬이 안 맞거나 없음 ({dname}) — thrown away, not installed')
    tmp = tempfile.mkdtemp(prefix='craft-dmg-')
    mnt = os.path.join(tmp, 'mnt')
    try:
        with open(os.path.join(tmp, dname), 'wb') as f:
            f.write(data)
        if run(['hdiutil', 'attach', '-nobrowse', '-readonly', '-noautoopen', '-mountpoint', mnt, os.path.join(tmp, dname)], capture_output=True, text=True).returncode != 0:
            raise CraftError(f'could not open the DMG / DMG 를 못 열었음 ({dname})')
        try:
            found = [x for x in os.listdir(mnt) if x.endswith('.app')]
            if len(found) != 1:
                raise CraftError(f'expected one .app in the DMG / DMG 안 앱이 하나가 아님: {found}')
            src = os.path.join(mnt, found[0])
            sig = run(['codesign', '-dv', src], capture_output=True, text=True)
            ident = re.search(r'^Identifier=(\S+)', sig.stderr or '', re.M)
            if not ident or ident.group(1) != bundle_id(app):
                raise CraftError(f'unexpected bundle id / 다른 앱: {ident.group(1) if ident else "unsigned"} — not installed')
            gk = run(['spctl', '-a', '-t', 'exec', '-vv', src], capture_output=True, text=True)
            if gk.returncode != 0 or 'Notarized Developer ID' not in (gk.stderr or '') + (gk.stdout or ''):
                raise CraftError('not notarized by Apple / 애플 공증이 아님 — not installed')
            got = native_version(src)
            if got != rel['ver']:  # 파일 이름 판과 다르면 — 깔면 열 때마다 '새 판'으로 또 받는다
                raise CraftError(f'version {got} ≠ {rel["ver"]} in the file name / 판이 파일 이름과 다름 — not installed')
            if busy and busy():
                raise BusyError(f'{display(app)} is running / 떠 있음 — not replaced')
            dest = os.path.join(apps_dir, found[0])
            new = tempfile.mkdtemp(prefix=found[0] + '.craft-new-', dir=apps_dir)  # 둘이 같이 깔아도 같은 자리에 안 쓴다
            os.rmdir(new)
            cp = run(['ditto', src, new], capture_output=True, text=True)
            if cp.returncode != 0:  # 반쯤 쓰다 멈춤(디스크가 참 등) — 반쪽 앱으로 바꿔 끼우지 않는다
                shutil.rmtree(new, ignore_errors=True)
                raise CraftError(f'could not copy the app / 앱을 못 옮겼음 — {(cp.stderr or "").strip() or cp.returncode}')
            if not os.path.isdir(new):
                shutil.copytree(src, new, symlinks=True)
            old = dest + '.craft-old'
            shutil.rmtree(old, ignore_errors=True)
            if os.path.exists(dest):
                os.rename(dest, old)  # 지우고 옮기다 멈추면 앱이 없었다 — 옛 것은 새것이 자리 잡은 뒤에 지운다
            try:
                os.rename(new, dest)
            except OSError:
                shutil.rmtree(new, ignore_errors=True)
                if os.path.exists(old):
                    os.rename(old, dest)
                raise
            shutil.rmtree(old, ignore_errors=True)
            if ddir:
                record_install(ddir, app, dest, rel['ver'])
            return dest
        finally:
            run(['hdiutil', 'detach', mnt, '-quiet'], capture_output=True)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def _replace(src, dst, tries=20):
    """os.replace — 윈도우는 다른 프로세스(Chammo 앱이 1초마다 상태 파일을 읽는다)가 연 파일을 못 바꿔 PermissionError(WinError 5).
    잠깐씩 다시(최대 1초). 맥·리눅스는 첫 번에 된다"""
    for i in range(tries):
        try:
            return os.replace(src, dst)
        except PermissionError:
            if i == tries - 1:
                raise
            time.sleep(0.05)


def _write_json(path, obj):
    """임시 이름은 부를 때마다 다르게 — 늘 <파일>.tmp 면 둘이 같이 쓸 때(Chammo 끄기가 close 를 앱마다 같이 띄운다) 늦은 쪽 replace 가 FileNotFoundError"""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=os.path.basename(path) + '.', suffix='.tmp', dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(obj, f, ensure_ascii=False)
        _replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.remove(tmp)
        raise


def _copy_over(src, dest):
    """사람 파일 자리에 돌려놓기 — 옆 임시 이름에 다 쓴 뒤 바꿔 끼운다(copy2 로 바로 쓰면 디스크가 차거나 멈출 때 원본이 잘린다)"""
    dest = os.path.realpath(dest)  # 바로가기(심볼릭 링크)면 가리키는 파일을 바꾼다 — 링크를 파일로 바꿔 끼우지 않게
    if os.path.isfile(dest):
        keep_copy(dest)
    fd, tmp = tempfile.mkstemp(prefix='.' + os.path.basename(dest) + '.', suffix='.chammo', dir=os.path.dirname(dest) or '.')
    os.close(fd)
    try:
        shutil.copy2(src, tmp)
        _replace(tmp, dest)
    except BaseException:
        with contextlib.suppress(OSError):
            os.remove(tmp)
        raise


TRASH = os.path.expanduser('~/.Trash')


def keep_copy(path):
    """덮기 직전 — 그 파일 사본을 휴지통에 시각 붙은 이름으로(덮인 앞 문서를 되살릴 길, 10-28 untitled 덮어쓰기). 못 남기면 CraftError — 덮지 않는다"""
    stem, ext = os.path.splitext(os.path.basename(path))
    label = f'{stem} (덮기 전 {time.strftime("%Y-%m-%d %H.%M.%S")}){ext}'
    try:
        if IS_WIN:  # 윈도우 휴지통은 옮기기만 된다 — 옆에 사본을 만들어 옮기고, 안 되면 사본을 옆에 둔다
            near = free_name(os.path.join(os.path.dirname(path), label))
            shutil.copy2(path, near)
            craft_win._trash(near, tries=2)
            return near
        dest = free_name(os.path.join(TRASH, label))
        shutil.copy2(path, dest)
        return dest
    except OSError as e:
        raise CraftError(f'could not keep a copy before overwriting, left as is / 덮기 전 사본을 못 남겨 안 덮음: {path} ({e})')


def same_file(a, b):
    """내용이 같은 파일인가 — 크기부터 보고 같을 때만 해시"""
    try:
        if os.path.getsize(a) != os.path.getsize(b):
            return False
        h = [hashlib.sha256(), hashlib.sha256()]
        for x, p in zip(h, (a, b)):
            with open(p, 'rb') as f:
                for chunk in iter(lambda: f.read(1 << 20), b''):
                    x.update(chunk)
        return h[0].digest() == h[1].digest()
    except OSError:
        return False


def _read_json(path):
    try:
        with open(path, encoding='utf-8') as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def load_installs(ddir):
    return _read_json(os.path.join(ddir, 'craft-native', 'installed.json'))


def record_install(ddir, app, dest, ver):
    """우리가 깐 것 — remove 는 이 기록에 있는 것만 지운다. 다시 깔았으면(사람이 다시 열었다) 지운 기본 앱 기록도 푼다"""
    recs = load_installs(ddir)
    recs[app] = {'path': dest, 'ver': ver, 'at': time.strftime('%Y-%m-%d')}
    _write_json(os.path.join(ddir, 'craft-native', 'installed.json'), recs)
    undecline(ddir, app)


# ── 기본 참모 앱 미리 받기(2026-10-26) — 표·PDF·슬라이드·문서·벡터는 첫 설정 뒤 뒤에서 깔고, 나머지 8개는 쓸 때 ──
BASICS = ('gridcraft', 'pdfcraft', 'deckcraft', 'wordcraft', 'vectorcraft')  # 작은 것부터(설치 뒤 85·282·315·345·527MB)
BASICS_MIN_FREE = 5 * 1024 ** 3  # 이보다 적게 남았으면 안 받고 쓸 때 설치로


def basics():
    """미리 받을 앱 — 윈도우는 윈도우판이 준비된 것만"""
    return [a for a in BASICS if not IS_WIN or craft_win.supported(a)]


def is_basic(app):
    return base(app) in BASICS


def basics_on(ddir):
    """설정 > 기능 '기본 참모 앱 미리 받기'(features.craftBasics, 기본 켬) — 받는 동안 꺼도 다음 앱 앞에서 멈춘다"""
    return (_read_json(os.path.join(ddir, 'config.json')).get('features') or {}).get('craftBasics', True) is not False


def declined_file(ddir):
    return os.path.join(ddir, 'craft-native', 'basics-declined.json')


def declined(ddir):
    """사람이 지운 기본 앱 {앱: 날} — prefetch 가 다시 안 받는다(다시 깔거나 설정을 껐다 켜면 풀림)"""
    return _read_json(declined_file(ddir))


def decline(ddir, app):
    d = declined(ddir)
    d[app] = time.strftime('%Y-%m-%d')
    _write_json(declined_file(ddir), d)


def undecline(ddir, app):
    d = declined(ddir)
    if d.pop(app, None):
        _write_json(declined_file(ddir), d)


def prefetch_file(ddir):
    return os.path.join(ddir, 'craft-native', 'prefetch.json')


def prefetch_state(ddir):
    return _read_json(prefetch_file(ddir))


def prefetching(ddir, app):
    """지금 뒤에서 받는 앱인가 — 받기 스크립트가 살아 있을 때만(죽은 기록은 아니다)"""
    st = prefetch_state(ddir)
    return st.get('state') == 'running' and st.get('app') == base(app) and pid_alive(st.get('pid'))


def disk_free(path):
    while path and not os.path.exists(path):
        path = os.path.dirname(path)
    return shutil.disk_usage(path or '/').free


def prefetch(ddir, install=None, have=None, free=None, apps_dir=APPS_DIR, reset=False):
    """기본 앱 중 안 깔린 것을 차례로 — open --native 와 같은 설치 길(체크섬·번들 id·공증). 상태는 prefetch.json
    (running·done·low-disk·off·busy, 받는 앱, 깐 것, 실패한 것, 사람이 지워서 건너뛴 것). 하나가 실패해도 나머지는 받는다.
    reset = 설정을 껐다 켰다 — 지운 기록을 비우고 다시 다 받는다"""
    install = install or (lambda a: craft_win.install(a, ddir=ddir) if IS_WIN else install_native(a, apps_dir=apps_dir, ddir=ddir))
    have = have or (lambda a: bool(native_version(app_path(a, apps_dir))))
    free = free or (lambda: disk_free(craft_win.apps_root() if IS_WIN else apps_dir))
    old = prefetch_state(ddir)
    if old.get('state') == 'running' and old.get('pid') != os.getpid() and pid_alive(old.get('pid')):
        return {'state': 'busy', 'app': old.get('app')}
    if reset and os.path.exists(declined_file(ddir)):
        os.remove(declined_file(ddir))
    skip = declined(ddir)
    st = {'state': 'running', 'app': None, 'pid': os.getpid(), 'done': [], 'failed': {}, 'declined': sorted(skip), 'at': time.strftime('%Y-%m-%d %H:%M')}
    _write_json(prefetch_file(ddir), st)
    for a in basics():
        if not basics_on(ddir):
            st['state'] = 'off'
            break
        if have(a) or a in skip:
            continue
        if free() < BASICS_MIN_FREE:
            st['state'] = 'low-disk'
            break
        st['app'] = a
        _write_json(prefetch_file(ddir), st)
        try:
            with slot_lock(ddir, a + '.update'):  # 사람이 그 앱을 처음 여는 중이면 그쪽 설치를 기다린다(같은 자물쇠)
                if not have(a):
                    install(a)
                    st['done'].append(a)
        except (CraftError, FetchError, OSError) as e:
            st['failed'][a] = str(e)[:200]
    else:
        st['state'] = 'done'
    st['app'] = None
    _write_json(prefetch_file(ddir), st)
    return st


def install_only(ddir, app, install=None, have=None, apps_dir=APPS_DIR):
    """앱 서랍 '받기' — 깔기만 하고 띄우지 않는다(10/28). 여는 건 사람이 다시 누를 때.
    설치 길은 open --native·prefetch 와 같다(체크섬·번들 id·공증, 같은 자물쇠). 'installed' 또는 'already'"""
    app = app_key(base(app))
    install = install or (lambda a: craft_win.install(a, ddir=ddir) if IS_WIN else install_native(a, apps_dir=apps_dir, ddir=ddir))
    have = have or (lambda a: bool(native_version(app_path(a, apps_dir))))
    with slot_lock(ddir, app + '.update'):  # prefetch·open 이 같은 앱을 까는 중이면 기다린다
        if have(app):
            return 'already'
        install(app)
    return 'installed'


def touch_used(ddir, app, when=None):
    """마지막으로 쓴 날 — list 에 보이고, 오래 안 쓴 것 정리 제안의 근거(지우기는 사람이 고른 뒤에만)"""
    app = base(app)
    p = os.path.join(ddir, 'craft-native', 'used.json')
    used = _read_json(p)
    used[app] = when or time.strftime('%Y-%m-%d')
    try:
        _write_json(p, used)
    except OSError:
        pass


def dir_size(path):
    if os.path.isfile(path):
        return os.path.getsize(path)
    n = 0
    for base, _, files in os.walk(path):
        for f in files:
            try:
                n += os.lstat(os.path.join(base, f)).st_size
            except OSError:
                pass
    return n


def human(n):
    for unit in ('B', 'KB', 'MB', 'GB'):
        if n < 1024 or unit == 'GB':
            v = round(n, 1) if unit == 'GB' else round(n)
            return f'{v:g} {unit}'
        n /= 1024


def to_trash(path, trash=None, label=None):
    """지우지 않고 휴지통으로 — 이름표(label)로, 같은 이름이 있으면 시각을 붙인다"""
    trash = trash or os.path.expanduser('~/.Trash')
    dest = os.path.join(trash, label or os.path.basename(path.rstrip('/')))
    if os.path.exists(dest):
        dest += time.strftime(' %H%M%S')
    shutil.move(path, dest)
    return dest


def remove_app(ddir, app, apps_dir=APPS_DIR, trash=None, home=None):
    """받은 웹판·CLI, 우리가 깐 맥 앱(설치 기록에 있고 번들 id 가 맞을 때만), 맥 앱 설정·작업 폴더 → 휴지통. 옮긴 자리 목록"""
    app = app_key(app)
    if IS_WIN:
        gone = craft_win.remove_app(ddir, app)
        if is_basic(app):
            decline(ddir, app)
        return gone
    if live_instances(ddir, app):
        raise CraftError(f'{display(app)} is open — scripts/craft close {app} first / 떠 있음, 먼저 close')
    gone = []
    recs = load_installs(ddir)
    rec = recs.get(app)
    if rec and os.path.isdir(rec['path']):
        import plistlib
        try:
            with open(os.path.join(rec['path'], 'Contents', 'Info.plist'), 'rb') as f:
                ident = plistlib.load(f).get('CFBundleIdentifier')
        except (OSError, ValueError):
            ident = None
        if ident == bundle_id(app):
            if subprocess.run(['pgrep', '-f', rec['path'] + '/Contents/MacOS/'], capture_output=True).returncode == 0:
                raise CraftError(f'{display(app)} is running / 떠 있음 — quit it first')
            gone.append(to_trash(rec['path'], trash))
    if rec:
        recs.pop(app)
        _write_json(os.path.join(ddir, 'craft-native', 'installed.json'), recs)
    name = display(app)
    home = home or os.path.expanduser('~')
    extra = [(os.path.join(home, e), f'{name} app settings — {os.path.basename(e)} (Chammo)') for e in (NATIVE.get(app) or {}).get('extra', [])]
    for p, label in [(os.path.join(ddir, 'craft', app), f'{name} downloads (Chammo)'), (native_dir(ddir, app), f'{name} settings and work (Chammo)')] + \
            [(native_dir(ddir, inst_key(app, n)), f'{name} {n} settings and work (Chammo)') for n in range(2, MAX_INSTANCES + 1)] + extra:
        if os.path.exists(p):
            gone.append(to_trash(p, trash, label))
    drop_state(ddir, app)
    if is_basic(app):
        decline(ddir, app)  # 사람이 지운 기본 앱 — 다음 켤 때 prefetch 가 다시 깔지 않게
    return gone


def update_native(app, get=fetch, run=subprocess.run, apps_dir=APPS_DIR, ddir=None):
    """(옛 판, 지금 판) — 내가 깐 자리(<apps_dir>/<이름>.app)에 있을 때만. 안 깔렸으면 (None, None)"""
    app = app_key(app)
    dest = app_path(app, apps_dir)
    old = native_version(dest)
    if not old:
        return None, None
    ver = latest(app, get, native=True)['ver']
    if ver_key(ver) <= ver_key(old):
        return old, old
    if subprocess.run(['pgrep', '-f', dest + '/Contents/MacOS/'], capture_output=True).returncode == 0:
        raise BusyError(f'{display(app)} is running — close it first / 떠 있음, 끄고 다시 (scripts/craft close {app})')
    install_native(app, get, run, apps_dir, ddir)
    return old, native_version(dest)


def installed_id(path):
    """깔린 앱의 번들 id(맥 Info.plist) — 윈도우는 chammo-app.json 의 id, 없으면 None"""
    if IS_WIN:
        return (craft_win.info(path) or {}).get('id')
    import plistlib
    try:
        with open(os.path.join(path, 'Contents', 'Info.plist'), 'rb') as f:
            return plistlib.load(f).get('CFBundleIdentifier')
    except (OSError, ValueError):
        return None


def app_running(ddir, app, apps_dir=APPS_DIR):
    """그 앱이 어디서든 떠 있나 — 맥은 그 자리 실행 파일(사람이 띄운 것도), 윈도우는 우리가 띄운 인스턴스(사람이 띄운 건 바꿔 끼우기가 막힌다)"""
    if IS_WIN:
        return bool(live_instances(ddir, app))
    return subprocess.run(['pgrep', '-f', app_path(app, apps_dir) + '/Contents/MacOS/'], capture_output=True).returncode == 0


def auto_update(ddir, app, get=fetch, run=subprocess.run, apps_dir=APPS_DIR, running=None, say=None, now=time.time):
    """open --native 때 저절로 새 판 — 우리가 깐 참모 앱(설치 기록·같은 자리·같은 번들 id)이 꺼져 있고 릴리스가 더 새것이면 띄우기 전에 받아 바꾼다.
    확인은 설치와 같다(SHA256SUMS·번들 id·공증·판). 릴리스 확인은 RELEASE_TTL 묵힌 것, 못 물으면(오프라인) 그냥 둔다.
    못 받거나 안 맞으면 옛 판 그대로 한 줄 — 확인이 안 맞은 판은 RELEASE_TTL 동안 다시 안 받는다(열 때마다 DMG 를 받지 않게).
    떠 있으면 한 줄만(끄고 다시 열면 바뀐다). (옛 판, 지금 판) 또는 None — 오류를 내지 않는다(열기를 막지 않게)"""
    st = load_state(ddir, app)
    if inst_alive(st):
        return None  # 그 인스턴스가 떠 있다 — 이 open 은 보이기만(파일 열기 등), 묻지도 말하지도 않는다
    app = base(app)
    say = say or (lambda line: print(line, file=sys.stderr))
    running = running or (lambda: app_running(ddir, app, apps_dir))
    dest = app_path(app, apps_dir)
    rec = load_installs(ddir).get(app) or {}
    if not native_version(dest) or rec.get('path') != dest or installed_id(dest) != bundle_id(app):
        return None  # 안 깔림(처음 설치 길) · 사람이 깐 앱 · 다른 앱
    quick = (lambda u: fetch(u, timeout=15)) if get is fetch else get  # 묻기는 짧게 — 네트워크가 멈춰 있어도 열기가 오래 안 막히게
    name, failed_p = display(app), os.path.join(ddir, 'craft-native', 'update-failed.json')
    try:
        with slot_lock(ddir, app + '.update'):  # 두 인스턴스를 같이 열어도 한 번만 받는다
            old = native_version(dest)  # 기다리는 동안 다른 스크립트가 바꿨을 수 있다
            info = release_info(ddir, app, quick) or {}
            new = info.get('ver')
            if info.get('stale') or not new or not old or ver_key(new) <= ver_key(old):
                return None
            miss = _read_json(failed_p).get(app) or {}
            if miss.get('ver') == new and now() - miss.get('at', 0) < RELEASE_TTL:
                return None
            if running():
                say(f'{name}: new version {new} — running, so {old} stays; quit and reopen to update / 새 판 {new} 있음 — 떠 있어서 {old} 그대로(끄고 다시 열면 바뀜)')
                return None
            try:
                rel = latest(app, quick, native=True)  # 받을 주소 — 막 물었으면 이 프로세스가 기억한 것(_CRAFTS)
            except CraftError as e:
                say(f'{name}: could not get {new} — opening {old} / 새 판 {new} 을 못 받아 옛 판 {old} 로 엶 — {str(e).rsplit(" — ", 1)[-1]}')
                return None
            new = rel['ver']
            if ver_key(new) <= ver_key(old):
                return None
            say(f'{name}: updating {old} → {new} before opening / 새 판 {new} 받는 중(지금 {old})…')
            try:
                if IS_WIN:
                    craft_win.install(app, get, ddir=ddir, rel=rel)
                else:
                    install_native(app, get, run, apps_dir, ddir, rel=rel, busy=running)
            except BusyError:
                say(f'{name}: started while downloading — {old} stays / 받는 동안 켜져서 {old} 그대로(끄고 다시 열면 바뀜)')
                return None
            except FetchError as e:
                say(f'{name}: could not download {new} — opening {old} / 새 판 {new} 을 못 받아 옛 판 {old} 로 엶 — {str(e).rsplit(" — ", 1)[-1]}')
                return None
            except CraftError as e:  # 확인이 안 맞음·못 옮김 — 이 판은 한동안 다시 안 받는다
                fails = _read_json(failed_p)
                fails[app] = {'ver': new, 'at': now(), 'why': str(e)}
                _write_json(failed_p, fails)
                say(f'{name}: could not install {new} — opening {old} / 새 판 {new} 을 깔지 못해 옛 판 {old} 로 엶 — {e}')
                return None
            fails = _read_json(failed_p)
            if fails.pop(app, None) is not None:
                _write_json(failed_p, fails)
            got = native_version(dest)
            say(f'{name}: updated {old} → {got} / 새 판으로 바꿈')
            return old, got
    except (CraftError, OSError, ValueError, KeyError, TypeError) as e:  # 뜻밖의 것 — 옛 판으로 연다
        say(f'{name}: update check failed — opening as is / 새 판 확인 실패, 그대로 엶 — {e}')
        return None


# ── Chammo 따로 창과 잇기: 창 열기·닫기 줄(app.jsonl) + 머리줄이 읽는 마지막 일·저장 상태(<앱>.status.json) ──

def window_line(ddir, verb, app):
    arg = {'verb': verb, 'app': app}
    who = os.path.basename((os.environ.get('CLAUDE_JOB_DIR') or '').rstrip('/'))  # 띄운 세션 — 앱이 그 세션을 맡긴 참모 탭에 칸을(scripts/show 의 from 과 같은 규칙)
    if who:
        arg['by'] = who
    _append_app_line(ddir, {'action': 'craft', 'arg': arg})


def _append_app_line(ddir, body):
    """앱 조작 줄(app.jsonl) 한 줄 — ts·id 를 붙인다"""
    import datetime, uuid
    line = {'ts': datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds'), **body, 'id': uuid.uuid4().hex[:12]}
    os.makedirs(ddir, exist_ok=True)
    with open(os.path.join(ddir, 'app.jsonl'), 'a', encoding='utf-8') as f:
        f.write(json.dumps(line, ensure_ascii=False) + '\n')


def cli_hint(rest):
    """창 없는 엔진으로 오래 도는 일(serve·run) — 사람이 못 본다. 만들고 고치는 일이면 맥 앱으로 띄우라는 한 줄, 아니면 None
    (2026-10-19 세션들이 cli serve/run 으로 PSD 를 짜서 끝날 때까지 아무것도 안 보였다)"""
    if len(rest) < 2 or rest[1] not in ('serve', 'run'):
        return None
    app = rest[0]
    return (f'craft: the windowless engine is invisible to the person — if this is something they should watch being made, use '
            f'`scripts/craft open {app} --native` + run/do instead / 사람이 못 봄 — 보여 줄 일이면 open {app} --native 로 띄워 run/do')


def status_file(ddir, app):
    return os.path.join(ddir, 'craft-native', f'{app}.status.json')


def load_status(ddir, app):
    return _read_json(status_file(ddir, app)) or {'last': '', 'dirty': False}


READS = {'ui.inspect', 'ui.screenshot', 'engine.commands', 'ui.menu.list', 'engine.journal', 'ui.state', 'ui.commands', 'jobs.list', 'session.inspect'}
# 엔진 '다른 이름 저장'(NATIVE save) — 작업 폴더 밖 자리로 저장했으면 지금 문서는 거기 있다(닫을 때 또 저장할 것 없음).
# 제자리 저장(file.save)·작업 폴더 안 저장은 사람 파일 자리로 돌려놓기 전이라 그대로 둔다. 가져오기(file.import)는 편집이다
SAVE_AS_CMDS = {'file.saveAs', 'session.save', 'saveas'}
OPEN_CMDS = {'file.open', 'session.open'}
# 지금 문서가 바뀌는 명령 — 그 뒤엔 '연 파일 하나'가 지금 문서라는 보장이 없다(닫을 때 그 사람 파일 자리에 엉뚱한 문서를 썼다, 2026-10-21 리뷰)
DOC_SWITCH_CMDS = {'file.new', 'document.new', 'file.close', 'document.close'}


def doc_switch(method, cmd):
    return method == 'app.new' or cmd in DOC_SWITCH_CMDS or cmd.endswith('.activate')


def note_call(ddir, app, method, params):
    """참모가 보낸 채널 명령 하나 → 아래 줄 글·저장 상태. 읽기만 하는 건 안 건드린다"""
    params = params or {}
    cmd = params.get('command') or params.get('id') or ''
    if method in READS or cmd.endswith('.inspect') or cmd.endswith('.list'):
        return
    st = load_status(ddir, app)
    unknown = bool(st.get('docUnknown')) or doc_switch(method, cmd)
    inner = params.get('params') if isinstance(params.get('params'), dict) else {}
    # 경로 이름표는 abs_paths 와 같은 표(PATH_KEYS) — saveAs 가 out·dest 로 와도 저장으로 친다. 상대 경로는 부르는 쪽(abs_paths)이 이미 작업 폴더 기준으로 풀었다
    path = next((str(d[k]) for d in (params, inner) for k in d if k.lower() in PATH_KEYS and isinstance(d[k], str) and d[k]), '')
    # 엔진 명령으로 저장·열기도 같다 — 워드 file.saveAs 뒤에도 dirty 가 남아 닫을 때 보관함에 untitled.docx 가 한 벌 더 생겼다(QA 0.3.6)
    work = os.path.abspath((load_state(ddir, app) or {}).get('work') or '.') if cmd in SAVE_AS_CMDS else ''
    # 윈도우는 대소문자를 안 가린다(C:\Work ~ c:\work) — normcase 로 맞대야 작업 폴더 안 저장을 '밖'으로 안 본다
    saved_out = bool(work and path) and not os.path.normcase(os.path.abspath(path)).startswith(os.path.normcase(work) + os.sep)
    if method in ('app.save', 'file.save') or saved_out:
        st = {'last': f'saved / 저장 {path}'.strip(), 'dirty': False}
    elif method in ('app.open', 'file.open', 'ui.open') or cmd in OPEN_CMDS:
        st = {'last': f'opened / 열기 {path}'.strip(), 'dirty': False}
        unknown = False  # 방금 연 것이 지금 문서
    else:
        name = '.'.join(cmd.split('.')[-2:]) if cmd else method
        inner = params.get('params') if isinstance(params.get('params'), dict) else ({k: v for k, v in params.items() if k != 'command'} if not cmd else {})
        args = ' '.join(f'{k} {v}' for k, v in inner.items() if isinstance(v, (int, float, str)))[:80]
        st = {'last': f'{name} {args}'.strip(), 'dirty': True}
    st['at'] = time.strftime('%H:%M:%S')
    if unknown:
        st['docUnknown'] = True
    try:
        _write_json(status_file(ddir, app), st)
    except OSError:
        pass


# 참모 손 — PhotoCraft 한국어 화면 이름(손쉬운 사용 트리, 10/16 실측). 다른 앱은 앱마다 실측한 뒤에
PC_KIND = {'hueSaturation': '색조/채도', 'brightnessContrast': '밝기/대비', 'colorBalance': '색상 균형', 'vibrance': '활기', 'levels': '레벨',
