def _param_hand(params):
    keys = [k for k in (params or {}) if k in PC_PARAM]
    if not keys:
        return None
    return [PC_PARAM[k] for k in keys], ' · '.join(f'{PC_PARAM[k]} {params[k]}' for k in keys if isinstance(params[k], (int, float)))


PC_SHAPE = {'rect': '사각형', 'roundedRect': '둥근 사각형', 'ellipse': '타원', 'polygon': '다각형', 'star': '별', 'line': '선', 'path': '패스'}
