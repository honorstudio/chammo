#!/bin/sh
''':'
# sh 로 읽으면 맞는 파이썬을 골라 다시 실행한다 — 윈도우의 python3 는 스토어 대리 실행기(종료 49)라 py -3 → python 중 도는 것
[ "$OS" = Windows_NT ] || exec python3 "$0" "$@"
for p in "py -3" python; do $p -c '' >/dev/null 2>&1 && exec $p "$0" "$@"; done
echo "python not found — install Python 3 (winget install Python.Python.3.12)" >&2; exit 127
':'''
__doc__ = """Claude Code status line for Chammo sessions.
Chammo 세션의 상태줄 — 앱이 읽을 사용량을 데이터 폴더에 남기고, 화면엔 사용자 원래 상태줄을 그대로 보여 준다.

Writes <data>/statusline.json (5-hour / weekly usage for the top bar) and <data>/ctx/<session_id>.json
(conversation fill per session for the sidebar). Then, if the user has their own statusLine in
~/.claude/settings.json, it runs that with the same input and prints its output — so nothing changes on
screen. Otherwise it prints "branch · model · effort · 42%".
"""
import json, os, subprocess, sys, time


def data_dir(home=None, env=None, exists=os.path.isdir):
    """Data folder — same rule as the app: $CHAMMO_HOME -> ~/.chammo (-> ~/.honor-orchestrator for old installs)"""
    home = home or os.path.expanduser('~')
    env = os.environ.get('CHAMMO_HOME', '') if env is None else env
    if env.strip():
        return os.path.expanduser(env.strip())
    new, old = os.path.join(home, '.chammo'), os.path.join(home, '.honor-orchestrator')
    return old if not exists(new) and exists(old) else new


def _write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        f.write(text)
    os.replace(tmp, path)  # 쓰는 도중 앱이 읽지 않게 한 번에 바꿔 끼운다


def record(raw, data, now=None):
    """사용량 원문과 세션별 컨텍스트 요약을 남긴다. 입력이 깨졌으면 아무것도 안 쓴다"""
    try:
        d = json.loads(raw)
    except ValueError:
        return
    if not isinstance(d, dict):
        return
    if d.get('rate_limits'):  # 아직 API 를 안 부른 세션엔 없다 — 그걸로 덮으면 다른 세션이 남긴 사용량이 지워진다
        _write(os.path.join(data, 'statusline.json'), raw)
    sid = d.get('session_id')
    if sid:
        cw = d.get('context_window') or {}
        ctx = {'sessionId': sid, 'used': cw.get('used_percentage'), 'size': cw.get('context_window_size'),
               'model': (d.get('model') or {}).get('display_name'), 'modelId': (d.get('model') or {}).get('id'),
               'effort': (d.get('effort') or {}).get('level'), 'name': d.get('session_name'), 'cwd': d.get('cwd'),
               'ts': int(now if now is not None else time.time())}
        _write(os.path.join(data, 'ctx', f'{sid}.json'), json.dumps(ctx, ensure_ascii=False))


def user_command(home=None):
    """사용자 원래 상태줄 명령 — 없거나 우리 것이면 None(자기 자신을 다시 부르지 않게)"""
    home = home or os.path.expanduser('~')
    try:
        with open(os.path.join(home, '.claude/settings.json'), encoding='utf-8') as f:
            cmd = ((json.load(f) or {}).get('statusLine') or {}).get('command')
    except (OSError, ValueError, AttributeError):
        return None
    if not cmd or 'chammo' in cmd or 'scripts/statusline' in cmd:
        return None
    return cmd


E = '\x1b['
RESET, DIM, CYAN, YELLOW, RED = E + '0m', E + '2m', E + '36m', E + '33m', E + '31m'


def plain(line):
    """색 없는 글(시험용)"""
    import re
    return re.sub(r'\x1b\[[0-9;]*m', '', line)


def branch(cwd):
    """git 가지 — 고친 게 있으면 *, 올려 둔 게 있으면 +. 저장소가 아니거나 git 이 없으면 ''"""
    def git(*a):
        return subprocess.run(['git', '-C', cwd, '--no-optional-locks', *a], capture_output=True, text=True, timeout=2)
    try:
        if git('rev-parse', '--is-inside-work-tree').returncode != 0:
            return ''
        b = git('branch', '--show-current').stdout.strip() or git('rev-parse', '--short', 'HEAD').stdout.strip()
        if git('diff', '--quiet').returncode != 0:
            b += '*'
        if git('diff', '--cached', '--quiet').returncode != 0:
            b += '+'
        return b
    except (OSError, subprocess.SubprocessError):
        return ''


def fallback(d, branch_of=branch):
    """사용자 상태줄이 없을 때 — 가지 · 모델 · 노력 · 쓴 대화 %(앱 사이드바와 같은 기준: 60 노랑 · 80 빨강). 기본 16색만(터미널 테마가 맞춰 준다)"""
    parts = []
    cwd = (d.get('workspace') or {}).get('current_dir') or d.get('cwd')
    b = branch_of(cwd) if cwd else ''
    if b:
        parts.append(f'{CYAN}{b}{RESET}')
    parts.append((d.get('model') or {}).get('display_name') or '')
    effort = (d.get('effort') or {}).get('level')
    if effort:
        parts.append(f'{DIM}{effort}{RESET}')
    used = (d.get('context_window') or {}).get('used_percentage')
    if used is not None:
        u = round(used)
        parts.append(f'{RED if u >= 80 else YELLOW if u >= 60 else DIM}{u}%{RESET}')
    return f'{DIM} · {RESET}'.join(parts)


def main():
    raw = sys.stdin.read()
    try:
        record(raw, data_dir())
    except OSError:
        pass
    cmd = user_command()
    if cmd:
        r = subprocess.run(cmd, shell=True, input=raw, capture_output=True, text=True)
        sys.stdout.write(r.stdout)
        return 0
    try:
        sys.stdout.write(fallback(json.loads(raw)))
    except ValueError:
        pass
    return 0


if __name__ == '__main__':
    sys.exit(main())
