#!/bin/sh
# UserPromptSubmit hook — (1) while the app runs, the screen the user is looking at; (2) in voice mode, remind the assistant to hand over spoken words (scripts/say).
# UserPromptSubmit 훅 — ① 앱이 켜져 있으면 사용자가 지금 보는 화면 한 줄 ② 음성 모드면 "들려줄 말을 따로 넘겨라".
# Data folder — same rule as the app: $CHAMMO_HOME -> ~/.chammo (-> ~/.honor-orchestrator for old installs)
d="${CHAMMO_HOME:-}"
# Python — on Windows python3 is the Store stub (exit 49): py -3, then python (same rule as the other HQ scripts)
# 파이썬 — 윈도우의 python3 는 스토어 대리 실행기(종료 49)라 py -3 → python 중 도는 것(다른 HQ 스크립트 머리와 같은 규칙, 2026-10-09 윈도우 실기기)
PY=python3
if [ "$OS" = Windows_NT ]; then
  for p in "py -3" python; do $p -c '' >/dev/null 2>&1 && { PY=$p; break; }; done
fi
# 훅 입력(JSON) — 닫히지 않은 stdin 을 끝없이 기다리면 시험·도구가 멈춘다(2026-10-03 새벽 hq 테스트가 30분 멈춤) — 1초까지만.
# select 는 윈도우 파이프에서 안 돼서(소켓만) 읽기 스레드를 1초 기다린다
inp=$($PY -c 'import sys,threading
b=[]
t=threading.Thread(target=lambda:b.append(sys.stdin.read()),daemon=True)
t.start();t.join(1)
sys.stdout.write(b[0] if b else "")' 2>/dev/null)
if [ -z "$d" ]; then
  d="$HOME/.chammo"
  if [ ! -d "$d" ] && [ -d "$HOME/.honor-orchestrator" ]; then d="$HOME/.honor-orchestrator"; fi
fi
# Assistant roster — who the other assistants are and what each handles (scripts/orch-roster; <data>/orch-roles.json + last 7 days)
# 참모 이름표 — 다른 참모가 누구고 각자 무슨 일을 맡는지, 자기 몫이 아니면 넘기라고(2026-10-04)
printf '%s' "$inp" | "$(dirname "$0")/orch-roster" 2>/dev/null
# Skill nudge — situational guides live in HQ skills (.claude/skills/hq-*); name the one this prompt needs (scripts/skill-hint)
# 스킬 환기 — 상황별 안내는 HQ 스킬에 있다. 이 지시에 맞는 스킬 이름을 한 줄로(scripts/skill-hint, 2026-10-06)
printf '%s' "$inp" | "$(dirname "$0")/skill-hint" 2>/dev/null
# Screen now — the app writes <data>/view.txt (line 1 = app pid, line 2 = screen); added only while that app is alive
# 지금 보는 화면 — 앱이 <데이터>/view.txt 에 적는다(첫 줄 = 앱 pid, 둘째 줄 = 화면). 앱이 살아 있을 때만 붙인다
# 윈도우 Git Bash 의 kill -0 은 윈도우 pid 를 못 본다(No such process) — 그땐 tasklist 로
alive() {
  kill -0 "$1" 2>/dev/null && return 0
  [ "$OS" = Windows_NT ] && tasklist //NH //FI "PID eq $1" 2>/dev/null | grep -qw "$1"
}
if [ -f "$d/view.txt" ]; then
  pid=$(head -n 1 "$d/view.txt" | tr -d '\r')
  v=$(sed -n 2p "$d/view.txt" | tr -d '\r')
  if [ -n "$v" ] && [ -n "$pid" ] && alive "$pid"; then
    if grep -q '"language": *"en"' "$d/config.json" 2>/dev/null; then
      echo "On the user's screen in the app right now: $v — read \"here / this / this screen\" against it"
    else
      echo "사용자가 지금 앱에서 보는 화면: $v — \"여기·이거·이 화면\"은 이 화면 기준으로 알아듣는다"
    fi
  fi
fi
# Sent from the phone — the app's phone server writes <data>/mobile-sent.json {id, at} right before sending; tell the assistant when it is this session and under a minute old
# 폰에서 보낸 지시 — 이 세션 것이고 1분 안이면 알린다
sid=$(printf '%s' "$inp" | $PY -c 'import sys,json;print(json.load(sys.stdin).get("session_id",""))' 2>/dev/null)
if [ -n "$sid" ] && [ -f "$d/mobile-sent.json" ]; then
  if $PY - "$d/mobile-sent.json" "$sid" <<'PY' 2>/dev/null
import json, sys, time
m = json.load(open(sys.argv[1], encoding="utf-8"))
ok = sys.argv[2].startswith(m.get("id") or "-") and time.time() * 1000 - m.get("at", 0) < 60_000
sys.exit(0 if ok else 1)
PY
  then
    if grep -q '"language": *"en"' "$d/config.json" 2>/dev/null; then echo "The user sent this from the phone (mobile app), not at the Mac — keep replies short for a phone screen, do not ask for things that need the Mac (show in Chrome, take a screenshot), and warn before anything that drops the phone connection (app restart). The "screen in the app" line above is what the Mac shows, not necessarily what the user sees now"; else echo "사용자는 지금 폰(모바일 앱)에서 보냈다 — 맥 앞이 아니다. 답은 폰 화면에 맞게 짧게, 맥 앞에서만 되는 부탁(크롬에서 보기·화면 캡처)은 하지 말고, 앱 재시작처럼 폰 연결이 끊기는 일은 미리 말한다"; fi
  fi
fi
# Sent from Telegram — the app's messenger bridge writes <data>/messenger-sent.json {id, at, channel} right before typing; same rule as the phone
# 텔레그램에서 보낸 지시 — 앱 메신저 브리지가 치기 직전 <데이터>/messenger-sent.json 을 남긴다(폰과 같은 규칙, 2026-10-08)
if [ -n "$sid" ] && [ -f "$d/messenger-sent.json" ]; then
  if $PY - "$d/messenger-sent.json" "$sid" <<'PY' 2>/dev/null
import json, sys, time
m = json.load(open(sys.argv[1], encoding="utf-8"))
ok = sys.argv[2].startswith(m.get("id") or "-") and time.time() * 1000 - m.get("at", 0) < 60_000
sys.exit(0 if ok else 1)
PY
  then
    if grep -q '"language": *"en"' "$d/config.json" 2>/dev/null; then echo "The user sent this from Telegram (a [Telegram] line), not at the Mac — your final reply is forwarded there: keep it short and plain (no tables), do not ask for things that need the Mac, and never ask them to type passwords, keys or codes in Telegram (it stays on Telegram servers). Payment, send, delete and production approvals happen only on the app or phone card"; else echo "사용자는 지금 텔레그램에서 보냈다([텔레그램] 줄) — 맥 앞이 아니다. 턴 끝 답이 텔레그램으로 간다: 짧게, 표 없이, 맥 앞에서만 되는 부탁은 하지 말고, 비밀번호·키·인증 코드를 텔레그램에 치라고 절대 하지 않는다(텔레그램 서버에 남는다). 결제·보내기·삭제·운영 승인은 앱·폰 카드에서만"; fi
  fi
fi
grep -q '"on":true' "$d/voice.json" 2>/dev/null || exit 0
# Voice lines only for sessions started in the HQ (assistants) — not app-fix worktrees or project sessions; decided by the launch folder
# 음성 줄은 HQ 에서 띄운 세션(참모)에게만 — HQ 안 워크트리·프로젝트 세션은 사용자에게 말하지 않는다(띄운 폴더로, orch-roster --hq-session)
printf '%s' "$inp" | "$(dirname "$0")/orch-roster" --hq-session 2>/dev/null || exit 0
# Woken by another assistant's message (SendMessage) — stay quiet; only the assistant the user talked to speaks
# 다른 참모가 보낸 말로 깬 턴은 말하지 않는다 — 사람이 말 건 참모만 말한다(참모 1에게 시킨 일을 2·3이 하면 셋 다 말했다, 2026-10-16)
if printf '%s' "$inp" | "$(dirname "$0")/orch-roster" --from-orch 2>/dev/null; then
  if grep -q '"language": *"en"' "$d/config.json" 2>/dev/null; then
    echo 'Voice mode is on — but this turn is a message from another assistant: do not run scripts/say (speaking to the user is the job of the assistant who handed you the work). Send the result back to that assistant with SendMessage and it will say it.'
  else
    echo '음성 모드 켜짐 — 하지만 이 턴은 다른 참모가 보낸 말이다. scripts/say 를 부르지 마라(사용자에게 말하는 건 일을 넘긴 참모 몫). 결과는 보낸 참모에게 SendMessage 로 돌려주면 그 참모가 말한다.'
  fi
  exit 0
fi
if grep -q '"language": *"en"' "$d/config.json" 2>/dev/null; then
  echo 'Voice mode is on — the user is listening, not reading. Right before you finish, run scripts/say "<what to say>" once. Length by importance (one sentence for small things, more when it needs explaining); use words instead of tables, code names or paths; always include any question the user must answer. Write your on-screen answer as usual. Only the assistant the user is talking to is read aloud — the app holds replies from other assistants and just says "New reply from X". If the user asks to hear them, run scripts/app voice read <assistant name> (the app reads them, keep your own scripts/say short).'
else
  echo '음성 모드 켜짐 — 사용자는 화면을 안 보고 소리만 듣는다. 답을 끝내기 직전에 scripts/say "들려줄 말" 을 한 번 불러라. 길이는 중요도대로(별거 아니면 한 문장, 설명이 필요하면 충분히), 표·코드 이름·경로 대신 말로 풀고, 사용자 답이 필요한 질문은 반드시 넣는다. 화면용 답은 평소대로 쓴다. 소리로 읽는 건 사용자가 말 건 참모뿐 — 다른 참모 답은 앱이 쌓아 두고 "○○한테 새 답 있어"로만 알린다. 사용자가 그 참모 걸 읽어 달라면 scripts/app voice read <참모 이름> (앱이 읽으니 네 scripts/say 는 짧게).'
fi
