#!/bin/sh
# UserPromptSubmit hook — (1) while the app runs, the screen the user is looking at; (2) in voice mode, remind the assistant to hand over spoken words (scripts/say).
# UserPromptSubmit 훅 — ① 앱이 켜져 있으면 사용자가 지금 보는 화면 한 줄 ② 음성 모드면 "들려줄 말을 따로 넘겨라".
# Data folder — same rule as the app: $CHAMMO_HOME -> ~/.chammo (-> ~/.honor-orchestrator for old installs)
d="${CHAMMO_HOME:-}"
# 훅 입력(JSON) — 닫히지 않은 stdin 을 끝없이 기다리면 시험·도구가 멈춘다(2026-10-03 새벽 hq 테스트가 30분 멈춤) — 1초까지만
inp=$(python3 -c 'import sys,select
r,_,_=select.select([sys.stdin],[],[],1)
sys.stdout.write(sys.stdin.read() if r else "")' 2>/dev/null)
if [ -z "$d" ]; then
  d="$HOME/.chammo"
  if [ ! -d "$d" ] && [ -d "$HOME/.honor-orchestrator" ]; then d="$HOME/.honor-orchestrator"; fi
fi
# Assistant roster — who the other assistants are and what each handles (scripts/orch-roster; <data>/orch-roles.json + last 7 days)
# 참모 이름표 — 다른 참모가 누구고 각자 무슨 일을 맡는지, 자기 몫이 아니면 넘기라고(2026-10-04)
printf '%s' "$inp" | "$(dirname "$0")/orch-roster" 2>/dev/null
# Screen now — the app writes <data>/view.txt (line 1 = app pid, line 2 = screen); added only while that app is alive
# 지금 보는 화면 — 앱이 <데이터>/view.txt 에 적는다(첫 줄 = 앱 pid, 둘째 줄 = 화면). 앱이 살아 있을 때만 붙인다
if [ -f "$d/view.txt" ]; then
  pid=$(head -n 1 "$d/view.txt")
  v=$(sed -n 2p "$d/view.txt")
  if [ -n "$v" ] && [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    if grep -q '"language": *"en"' "$d/config.json" 2>/dev/null; then
      echo "On the user's screen in the app right now: $v — read \"here / this / this screen\" against it"
    else
      echo "사용자가 지금 앱에서 보는 화면: $v — \"여기·이거·이 화면\"은 이 화면 기준으로 알아듣는다"
    fi
  fi
fi
# Sent from the phone — the app's phone server writes <data>/mobile-sent.json {id, at} right before sending; tell the assistant when it is this session and under a minute old
# 폰에서 보낸 지시 — 이 세션 것이고 1분 안이면 알린다
sid=$(printf '%s' "$inp" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("session_id",""))' 2>/dev/null)
if [ -n "$sid" ] && [ -f "$d/mobile-sent.json" ]; then
  if python3 - "$d/mobile-sent.json" "$sid" <<'PY' 2>/dev/null
import json, sys, time
m = json.load(open(sys.argv[1], encoding="utf-8"))
ok = sys.argv[2].startswith(m.get("id") or "-") and time.time() * 1000 - m.get("at", 0) < 60_000
sys.exit(0 if ok else 1)
PY
  then
    if grep -q '"language": *"en"' "$d/config.json" 2>/dev/null; then echo "The user sent this from the phone (mobile app), not at the Mac — keep replies short for a phone screen, do not ask for things that need the Mac (show in Chrome, take a screenshot), and warn before anything that drops the phone connection (app restart). The "screen in the app" line above is what the Mac shows, not necessarily what the user sees now"; else echo "사용자는 지금 폰(모바일 앱)에서 보냈다 — 맥 앞이 아니다. 답은 폰 화면에 맞게 짧게, 맥 앞에서만 되는 부탁(크롬에서 보기·화면 캡처)은 하지 말고, 앱 재시작처럼 폰 연결이 끊기는 일은 미리 말한다"; fi
  fi
fi
grep -q '"on":true' "$d/voice.json" 2>/dev/null || exit 0
if grep -q '"language": *"en"' "$d/config.json" 2>/dev/null; then
  echo 'Voice mode is on — the user is listening, not reading. Right before you finish, run scripts/say "<what to say>" once. Length by importance (one sentence for small things, more when it needs explaining); use words instead of tables, code names or paths; always include any question the user must answer. Write your on-screen answer as usual.'
else
  echo '음성 모드 켜짐 — 사용자는 화면을 안 보고 소리만 듣는다. 답을 끝내기 직전에 scripts/say "들려줄 말" 을 한 번 불러라. 길이는 중요도대로(별거 아니면 한 문장, 설명이 필요하면 충분히), 표·코드 이름·경로 대신 말로 풀고, 사용자 답이 필요한 질문은 반드시 넣는다. 화면용 답은 평소대로 쓴다.'
fi
