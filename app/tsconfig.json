{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@pro/*": ["../pro/web/*", "./src/pro-stub/*"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    }
  },
  "include": ["src", "../pro/web", "vite.config.ts"]
}
