{
  "permissions": {
    "allow": [
      "mcp__playwright__*",
      "mcp__ghostserver__*"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/trigger.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "vendorpack@somemarket": true,
    "disabledpack@somemarket": false
  }
}