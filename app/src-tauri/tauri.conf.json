{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chammo",
  "mainBinaryName": "Chammo",
  "version": "0.2.3",
  "identifier": "app.chammo.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npx vite",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chammo",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      },
      {
        "label": "tama",
        "url": "widget.html",
        "title": "Chammo Tamagotchi",
        "width": 216,
        "height": 246,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
